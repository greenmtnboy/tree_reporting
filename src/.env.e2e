# Loaded by `pnpm build:e2e` (vite build --mode e2e), which Playwright's
# webServer runs before serving the preview. Never used by a normal build.

# Turns on the fixture seam in src/lib/e2eFixtures.ts.
VITE_E2E=1

# Placeholders so firebaseAvailable is true and the auth-gated UI renders.
# No request ever reaches these — the seam answers first.
VITE_FIREBASE_API_KEY=test-api-key
VITE_FIREBASE_AUTH_DOMAIN=test.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=test-project
VITE_FIREBASE_STORAGE_BUCKET=test.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=0
VITE_FIREBASE_APP_ID=test-app-id
