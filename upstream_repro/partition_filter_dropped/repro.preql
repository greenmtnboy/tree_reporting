# Minimal repro: a partitioned datasource's `complete where` filter is dropped
# from the persist projection once the model derives an aggregate over the
# stacked partitions.
#
# Ingredients:
#   1. A key partitioned across several `root partial datasource`s, each
#      claiming `complete where city = 'X' and src = 'Y'`.
#   2. One of those raw sources emitting rows for OTHER partitions too -- the
#      shape of a shared feed that every city reads and filters (here: a
#      community-submission script that returns every city's rows).
#   3. An aggregate over a derived grouping key, spanning the stacked
#      partitions, surfaced as a column on the managed datasource.
#
# With (3) present the generated persist SQL contains NO WHERE clause at all,
# so the foreign row from (2) is written into CITY_A's output. Drop the
# `is_duplicate` column from `out_a` and the filter comes back as
# `WHERE "..."."city" = 'CITY_A'`.

key city enum<string>['CITY_A', 'CITY_B'];
key entity_id string;
key src enum<string>['MAIN_A', 'SHARED'];

property entity_id.x float;
property <*>.updated_through datetime;

root datasource update_time (
    updated_at: updated_through
)
query '''SELECT TIMESTAMP '2026-08-01 00:00:00' AS updated_at''';

root partial datasource main_a (
    entity_id: entity_id,
    city: city,
    source: src,
    x: ?x,
)
grain (entity_id)
complete where city = 'CITY_A' and src = 'MAIN_A'
query '''SELECT * FROM (VALUES ('a1', 'CITY_A', 'MAIN_A', 1.0)) t(entity_id, city, source, x)''';

# Claims only CITY_A, but -- like a shared feed read by every city -- actually
# returns another partition's row as well.  The `complete where` is what is
# supposed to keep that row out of CITY_A's output.
root partial datasource shared_feed (
    entity_id: entity_id,
    city: city,
    source: src,
    x: ?x,
)
grain (entity_id)
complete where city = 'CITY_A' and src = 'SHARED'
query '''SELECT * FROM (VALUES ('s1', 'CITY_B', 'SHARED', 1.0)) t(entity_id, city, source, x)''';

# The aggregate that triggers it: a count over a derived grouping key,
# evaluated across the stacked partitions.
auto cell <- cast(floor(x) as string);
auto anchor_count <- count(entity_id ? src != 'SHARED') by cell;
auto is_dupe <- src = 'SHARED' and anchor_count > 0;

partial datasource out_a (
    entity_id,
    city,
    src,
    ?x,
    is_duplicate: is_dupe,
    updated_through,
)
grain (entity_id)
complete where city = 'CITY_A'
address out_a
freshness by updated_through;
