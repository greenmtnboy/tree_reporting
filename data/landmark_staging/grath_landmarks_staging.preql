# Ad-hoc staging publish for Athens's landmarks, run by the
# `landmarks-grath` [[cloud.job]] in ../trilogy.toml — NOT by the landmarks
# refresh, and on no cron. Everything shared with the other curated-CSV
# cities, including why this is `copy into` under `run` rather than a refresh
# target, lives in staging_common.preql.
#
# Why Athens has a curated CSV at all: Greece's national monuments registry
# has no machine-readable export, so raw/grath/athens_landmarks_geocode.py
# geocodes a hand-written list through Nominatim and commits the result.

import staging_common;

root datasource grath_landmarks_csv (
    landmark_id: landmark_id,
    name: name,
    city: city,
    latitude: ?latitude,
    longitude: ?longitude,
    geometry_raw: ?geometry_raw,
)
grain (landmark_id)
file `../raw/grath/athens_landmarks.csv`;

copy into parquet `gcs://trilogy_public_models/duckdb/staging/grath_landmarks_staging.parquet` from
select
    landmark_id,
    name,
    city,
    latitude,
    longitude,
    geometry_raw,
;
