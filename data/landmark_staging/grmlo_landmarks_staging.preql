# Ad-hoc staging publish for Milos's landmarks, run by the `landmarks-grmlo`
# [[cloud.job]] in ../trilogy.toml — NOT by the main refresh, and on no cron.
# Same shape and rationale as grath_landmarks_staging.preql: the committed CSV
# (raw/grmlo/milos_landmarks.csv) rides the workspace sync, a firing
# republishes it as the staging parquet with the job's HMAC credentials, and
# the run timestamp makes every firing stale by definition.

key landmark_id string;
property landmark_id.name string;
property landmark_id.city string;
property landmark_id.geometry_raw string;
property landmark_id.latitude float;
property landmark_id.longitude float;

property <*>.landmarks_staged_through datetime; # when this staging copy was published

root datasource run_timestamp (
    data_updated_through: landmarks_staged_through
)
file `./run_timestamp.py`;

root datasource grmlo_landmarks_csv (
    landmark_id: landmark_id,
    name: name,
    city: city,
    latitude: ?latitude,
    longitude: ?longitude,
    geometry_raw: ?geometry_raw,
)
grain (landmark_id)
file `../raw/grmlo/milos_landmarks.csv`;

datasource grmlo_landmarks_staging (
    landmark_id,
    name,
    city,
    ?latitude,
    ?longitude,
    ?geometry_raw,
    landmarks_staged_through,
)
grain (landmark_id)
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/grmlo_landmarks_staging.parquet`:`gcs://trilogy_public_models/duckdb/staging/grmlo_landmarks_staging.parquet`
freshness by landmarks_staged_through;
