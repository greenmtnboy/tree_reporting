import common;

root datasource usbos_surface_temperature (
    observation_id: heat_observation_id,
    cell_id: heat_cell_id,
    city: heat_city,
    acquired_on: heat_acquired_on,
    easting_m: heat_easting_m,
    northing_m: heat_northing_m,
    longitude: heat_longitude,
    latitude: heat_latitude,
    surface_temperature_c: surface_temperature_c,
    valid_scene_count: heat_valid_scene_count,
    source: heat_source,
)
grain (heat_observation_id)
file `https://storage.googleapis.com/trilogy_public_models/duckdb/context/usbos_surface_temperature_v1.parquet`;

root datasource usbos_water (
    feature_id: water_feature_id,
    city: water_city,
    source: water_source,
    source_feature_id: water_source_feature_id,
    name: ?water_name,
    water_class: water_class,
    geometry_wkt: water_geometry_wkt,
)
grain (water_feature_id)
file `https://storage.googleapis.com/trilogy_public_models/duckdb/context/usbos_water_v1.parquet`;
