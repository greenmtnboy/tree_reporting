# Scheduled OSM extraction for Burlington, ON, run by the `osm-cabur` [[cloud.job]] in
# ../trilogy.toml. Everything shared with the other cities -- the canonical tree
# concepts, the Overpass freshness probe, and why extraction is a separate job
# at all -- lives in staging_common.preql; this file is just Burlington, ON's rows and
# the staging object they land in.

import staging_common;

root datasource cabur_osm_rows extends osm_rows (
)
file `./osm_rows.py`
where city = 'CABUR';

datasource cabur_osm_staging extends osm_staging (
)
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/cabur_osm_staging.parquet`:`gcs://trilogy_public_models/duckdb/staging/cabur_osm_staging.parquet`;
