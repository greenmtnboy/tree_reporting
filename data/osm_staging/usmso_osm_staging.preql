# Scheduled OSM extraction for Missoula, run by the `osm-usmso` [[cloud.job]] in
# ../trilogy.toml. Everything shared with the other cities -- the canonical tree
# concepts, the Overpass freshness probe, and why extraction is a separate job
# at all -- lives in staging_common.preql; this file is just Missoula's rows and
# the staging object they land in.

import staging_common;

root datasource usmso_osm_rows extends osm_rows (
)
file `./osm_rows.py`
where city = 'USMSO';

datasource usmso_osm_staging extends osm_staging (
)
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/usmso_osm_staging.parquet`:`gcs://trilogy_public_models/duckdb/staging/usmso_osm_staging.parquet`;
