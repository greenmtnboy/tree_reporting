# Scheduled OSM extraction for Santorini, run by the `osm-grsan` [[cloud.job]] in
# ../trilogy.toml. Everything shared with the other sixteen cities -- the
# canonical tree concepts, the Overpass freshness probe, and why extraction is
# a separate job at all -- lives in staging_common.preql; this file is just
# Santorini's rows and the staging object they land in.

import staging_common;

root datasource grsan_osm_rows extends osm_rows (
)
file `./osm_rows.py`
where city = 'GRSAN';

datasource grsan_osm_staging extends osm_staging (
)
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/grsan_osm_staging.parquet`:`gcs://trilogy_public_models/duckdb/staging/grsan_osm_staging.parquet`;
