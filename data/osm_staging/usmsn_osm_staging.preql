# Scheduled OSM extraction for Madison, run by the `osm-usmsn` [[cloud.job]] in
# ../trilogy.toml. Everything shared with the other cities -- the canonical tree
# concepts, the Overpass freshness probe, and why extraction is a separate job
# at all -- lives in staging_common.preql; this file is just Madison's rows and
# the staging object they land in.

import staging_common;

root datasource usmsn_osm_rows extends osm_rows (
)
file `./osm_rows.py`
where city = 'USMSN';

datasource usmsn_osm_staging extends osm_staging (
)
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/usmsn_osm_staging.parquet`:`gcs://trilogy_public_models/duckdb/staging/usmsn_osm_staging.parquet`;
