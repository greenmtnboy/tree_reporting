# Scheduled OSM extraction for Welland, run by the `osm-cawld` [[cloud.job]] in
# ../trilogy.toml. Everything shared with the other cities -- the canonical tree
# concepts, the Overpass freshness probe, and why extraction is a separate job
# at all -- lives in staging_common.preql; this file is just Welland's rows and
# the staging object they land in.

import staging_common;

root datasource cawld_osm_rows extends osm_rows (
)
file `./osm_rows.py`
where city = 'CAWLD';

datasource cawld_osm_staging extends osm_staging (
)
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/cawld_osm_staging.parquet`:`gcs://trilogy_public_models/duckdb/staging/cawld_osm_staging.parquet`;
