# Scheduled OSM extraction for Tokyo, run by the `osm-jptyo` [[cloud.job]] in
# ../trilogy.toml. Everything shared with the other cities -- the canonical tree
# concepts, the Overpass freshness probe, and why extraction is a separate job
# at all -- lives in staging_common.preql; this file is just Tokyo's rows and
# the staging object they land in.

import staging_common;

# Tokyo's municipal and community sources declare `borough` -- the ward,
# `行政区` -- so this partition must declare it too; without it the partition
# drops out of the union and the remaining two stop covering the source enum.
# A city-unique column stays in the city's own file, which is why
# staging_common.preql does not declare it.
property tree_id.borough string;

root datasource jptyo_osm_rows extends osm_rows (
    borough: ?borough,
)
file `./osm_rows.py`
where city = 'JPTYO';

datasource jptyo_osm_staging extends osm_staging (
    ?borough,
)
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/jptyo_osm_staging.parquet`:`gcs://trilogy_public_models/duckdb/staging/jptyo_osm_staging.parquet`;
