# Scheduled OSM extraction for Milan, run by the `osm-itmil` [[cloud.job]] in
# ../trilogy.toml. Everything shared with the other cities -- the canonical tree
# concepts, the Overpass freshness probe, and why extraction is a separate job
# at all -- lives in staging_common.preql; this file is just Milan's rows and
# the staging object they land in.

import staging_common;

root datasource itmil_osm_rows extends osm_rows (
)
file `./osm_rows.py`
where city = 'ITMIL';

datasource itmil_osm_staging extends osm_staging (
)
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/itmil_osm_staging.parquet`:`gcs://trilogy_public_models/duckdb/staging/itmil_osm_staging.parquet`;
