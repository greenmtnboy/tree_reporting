# Scheduled OSM extraction for London, run by the `osm-gblon` [[cloud.job]] in
# ../trilogy.toml. Everything shared with the other sixteen cities -- the
# canonical tree concepts, the Overpass freshness probe, and why extraction is
# a separate job at all -- lives in staging_common.preql; this file is just
# London's rows and the staging object they land in.

import staging_common;

# London's municipal and community sources declare `borough`; without it here
# this partition drops out of the union and the remaining two stop covering
# the source enum.
property tree_id.borough string;

root datasource gblon_osm_rows extends osm_rows (
    borough: ?borough,
)
file `./osm_rows.py`
where city = 'GBLON';

datasource gblon_osm_staging extends osm_staging (
    ?borough,
)
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/gblon_osm_staging.parquet`:`gcs://trilogy_public_models/duckdb/staging/gblon_osm_staging.parquet`;
