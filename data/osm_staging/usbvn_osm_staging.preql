# Scheduled OSM extraction for Beaverton, run by the `osm-usbvn` [[cloud.job]] in
# ../trilogy.toml. Everything shared with the other cities -- the canonical tree
# concepts, the Overpass freshness probe, and why extraction is a separate job
# at all -- lives in staging_common.preql; this file is just Beaverton's rows and
# the staging object they land in.

import staging_common;

root datasource usbvn_osm_rows extends osm_rows (
)
file `./osm_rows.py`
where city = 'USBVN';

datasource usbvn_osm_staging extends osm_staging (
)
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/usbvn_osm_staging.parquet`:`gcs://trilogy_public_models/duckdb/staging/usbvn_osm_staging.parquet`;
