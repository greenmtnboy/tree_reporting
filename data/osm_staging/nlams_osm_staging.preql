# Scheduled OSM extraction for Amsterdam, run by the `osm-nlams` [[cloud.job]] in
# ../trilogy.toml. Everything shared with the other sixteen cities -- the
# canonical tree concepts, the Overpass freshness probe, and why extraction is
# a separate job at all -- lives in staging_common.preql; this file is just
# Amsterdam's rows and the staging object they land in.

import staging_common;

root datasource nlams_osm_rows extends osm_rows (
)
file `./osm_rows.py`
where city = 'NLAMS';

datasource nlams_osm_staging extends osm_staging (
)
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/nlams_osm_staging.parquet`:`gcs://trilogy_public_models/duckdb/staging/nlams_osm_staging.parquet`;
