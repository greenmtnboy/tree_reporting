import ..tree_common;
import ..community_tree_info;

auto nlams_published_data_updated_through <- greatest(nlams_data_updated_through, nlams_community_data_updated_through, nlams_osm_data_updated_through);

key nlams_source enum<string>['AMSTERDAM_OPENDATA', 'COMMUNITY_NLAMS', 'OSM_NLAMS']; # originating dataset for the row

root datasource amsterdam_update_time (
    data_updated_through: nlams_data_updated_through
)
file `./amsterdam_update_time.py`;

# Only this city's column, so an approval elsewhere does not mark NLAMS's
# Parquet stale. Trilogy probes this as MAX over the one column.
root datasource nlams_community_update_time (
    nlams_community_data_updated_through: nlams_community_data_updated_through
)
file `../community_update_time.py`;




# GCS publication time of the staged OSM parquet (see amsterdam_osm_extract.py);
# it only moves when an extraction is re-run and uploaded.
root datasource nlams_osm_update_time (
    data_updated_through: nlams_osm_data_updated_through
)
file `./amsterdam_osm_probe.py`;

# OpenStreetMap trees, read from the staged parquet in GCS rather than
# Overpass -- extraction is decoupled from refresh (see _osm_shared.py and
# EXTENDING.md).  Overlapping rows are kept and flagged via
# nlams_is_duplicate below, never dropped: the Parquet must contain the union
# of its declared sources, and the flag keeps the dedup tunable and auditable.
root partial datasource nlams_osm_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: nlams_source,
    species: ?species,
    tree_name: ?tree_name,
    plant_date: ?plant_date,
    latitude: ?latitude,
    longitude: ?longitude,
    diameter_at_breast_height: ?diameter_at_breast_height,
    submission_photo_url: ?submission_photo_url,
)
grain (tree_id)
complete where city = 'NLAMS' and nlams_source = 'OSM_NLAMS'
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/nlams_osm_staging.parquet`;

root partial datasource amsterdam_raw_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: nlams_source,
    species: species,
    tree_name: ?tree_name,
    plant_date: ?plant_date,
    latitude: ?latitude,
    longitude: ?longitude,
    diameter_at_breast_height: ?diameter_at_breast_height,
    submission_photo_url: ?submission_photo_url,
)
grain (tree_id)
complete where city = 'NLAMS' and nlams_source = 'AMSTERDAM_OPENDATA'
file `./amsterdam_tree_info.py`;


# Approved community submissions for this city. The shared ingest script
# emits every city's rows; the `complete where` clause narrows it to NLAMS
# and makes it a disjoint partition alongside amsterdam_raw_tree_info.
root partial datasource nlams_community_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: nlams_source,
    species: species,
    tree_name: ?tree_name,
    plant_date: ?plant_date,
    diameter_at_breast_height: ?diameter_at_breast_height,
    latitude: ?latitude,
    longitude: ?longitude,
    submission_photo_url: ?submission_photo_url,
)
grain (tree_id)
complete where city = 'NLAMS' and nlams_source = 'COMMUNITY_NLAMS'
file `../community_tree_info.py`
where city = 'NLAMS';



# --- Cross-source dedup: stack + aggregate over four staggered grids -------
#
# Same construction as ustem/tempe_tree_info.preql (full rationale there and in
# EXTENDING.md): an OSM row is a duplicate when a non-OSM tree shares its
# ~10m grid cell in ANY of four half-cell-staggered grid copies -- a guaranteed
# match within 5m, possible out to a ~14m diagonal.
#
# CALIBRATED at 10m. This city's 5-10m band is 29.9% mutual-NN over
# n=2508 -- neighbour-dominated: a false flag hides a real tree
# while a missed duplicate only double-renders one, so a band that is not
# clearly duplicate-dominated should not be flagged. Re-check with:
#     cd data/raw && uv run ./osm_dedup_validation.py --city NLAMS
#
# Cell sizes: 10m of latitude is 10/111320 deg; longitude shrinks by
# cos(52.35 deg) here.
const nlams_cell_lat_deg <- 0.00008983;
const nlams_cell_lon_deg <- 0.00014706;

auto nlams_cell_a <- concat(cast(floor(longitude / nlams_cell_lon_deg) as string), ':', cast(floor(latitude / nlams_cell_lat_deg) as string));
auto nlams_cell_b <- concat(cast(floor(longitude / nlams_cell_lon_deg + 0.5) as string), ':', cast(floor(latitude / nlams_cell_lat_deg) as string));
auto nlams_cell_c <- concat(cast(floor(longitude / nlams_cell_lon_deg) as string), ':', cast(floor(latitude / nlams_cell_lat_deg + 0.5) as string));
auto nlams_cell_d <- concat(cast(floor(longitude / nlams_cell_lon_deg + 0.5) as string), ':', cast(floor(latitude / nlams_cell_lat_deg + 0.5) as string));

auto nlams_anchor_count_a <- count(tree_id ? nlams_source != 'OSM_NLAMS') by nlams_cell_a;
auto nlams_anchor_count_b <- count(tree_id ? nlams_source != 'OSM_NLAMS') by nlams_cell_b;
auto nlams_anchor_count_c <- count(tree_id ? nlams_source != 'OSM_NLAMS') by nlams_cell_c;
auto nlams_anchor_count_d <- count(tree_id ? nlams_source != 'OSM_NLAMS') by nlams_cell_d;

auto nlams_is_duplicate <- nlams_source = 'OSM_NLAMS' and (
    nlams_anchor_count_a > 0
    or nlams_anchor_count_b > 0
    or nlams_anchor_count_c > 0
    or nlams_anchor_count_d > 0
);

partial datasource amsterdam_tree_info (
    tree_id,
    city,
    data_source: nlams_source,
    species,
    ?tree_name,
    ?plant_date,
    ?diameter_at_breast_height,
    ?latitude,
    ?longitude,
    ?submission_photo_url,
    is_duplicate: nlams_is_duplicate,
    nlams_published_data_updated_through,
)
grain (tree_id)
complete where city = 'NLAMS'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/nlams_tree_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/nlams_tree_info_v{data_version}.parquet`
freshness by nlams_published_data_updated_through;
