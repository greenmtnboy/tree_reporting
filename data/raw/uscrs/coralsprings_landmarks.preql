import ..landmark_common;

root datasource coralsprings_landmarks_update_time (
    data_updated_through: uscrs_landmark_data_updated_through
)
file `./coralsprings_landmarks_probe.py`;

# Coral Springs's National Register listings (the National Park Service's
# nrhp_locations MapServer cut to the city), read live -- no Nominatim
# geocoding, no committed CSV and no staging object.  The register has no
# listing in the city today and the City publishes no register of its own,
# so the table is empty until one appears.  `lm_type` names the register and
# `register_number` the NRIS reference number.
root partial datasource raw_coralsprings_landmark_info extends landmark_partition (
    address: ?address,
    lm_type: ?lm_type,
    register_number: ?register_number,
    year_designated: ?year_designated,
)
complete where city = 'USCRS'
file `./coralsprings_landmarks.py`;

partial datasource coralsprings_landmark_info extends published_landmark_info (
    ?address,
    ?lm_type,
    ?register_number,
    ?year_designated,
    uscrs_landmark_data_updated_through,
)
complete where city = 'USCRS'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/uscrs_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/uscrs_landmark_info_v{data_version}.parquet`
freshness by uscrs_landmark_data_updated_through;
