import ..tree_common;
import ..community_tree_info;
import ..satellite_tree_info;
import ..tree_dedup;
import ..tree_height;

# Cambridge was a partition of Boston's metro model until the map stopped needing
# one parquet per metro (docs/SEAMLESS_WORLD.md); it is its own city now, with
# its territory drawn by the town's real boundary (boundaries/uscam.json).
# Its `data_source` label, its tree ids and its ingest are what they were.

property <*>.cambridge_city_data_updated_through datetime; # when the City of Cambridge's tree feed is through
property <*>.mit_data_updated_through datetime; # when MIT's campus tree layer is through
property <*>.uscam_canopy_data_updated_through datetime; # GCS publication time of the staged LIDAR canopy-height lookup
auto uscam_published_data_updated_through <- greatest(uscam_data_updated_through, uscam_community_data_updated_through, uscam_osm_data_updated_through, uscam_satellite_data_updated_through, uscam_predicted_data_updated_through, uscam_canopy_data_updated_through);
auto uscam_data_updated_through <- greatest(cambridge_city_data_updated_through, mit_data_updated_through);

key uscam_source enum<string>['CAMBRIDGE', 'MIT', 'COMMUNITY_USCAM', 'OSM_USCAM', 'SATELLITE_USCAM', 'PREDICTED_USCAM']; # originating dataset for the row

# Feed the shared cross-source merge (../tree_dedup.preql): it classifies rows
# by the label's prefix and records provenance from it.
auto uscam_source_label <- concat(uscam_source, '');
merge uscam_source_label into source_label;

root datasource cambridge_update_time (
    data_updated_through: cambridge_city_data_updated_through
)
file `./cambridge_update_time.py`;

root datasource mit_update_time (
    data_updated_through: mit_data_updated_through
)
file `./mit_update_time.py`;

# Only this city's column, so an approval elsewhere does not mark USCAM's
# Parquet stale. Trilogy probes this as MAX over the one column.
root datasource uscam_community_update_time (
    uscam_community_data_updated_through: uscam_community_data_updated_through
)
file `../community_update_time.py`;

# Likewise for reviewed aerial-imagery detections: one column, this city's.
root datasource uscam_satellite_update_time (
    uscam_satellite_data_updated_through: uscam_satellite_data_updated_through
)
file `../satellite_update_time.py`;

# Bulk imagery predictions: the publication time of the staged file this town
# reads, which is the Boston metro run's (PREDICTED_STAGED_WITH).
root datasource uscam_predicted_update_time (
    uscam_predicted_data_updated_through: uscam_predicted_data_updated_through
)
file `../predicted_update_time.py`;

# GCS publication time of the staged OSM parquet; it only moves when an
# extraction is re-run and uploaded. Not a local mtime -- git does not preserve
# it, so a committed staging file makes every fresh clone look like new data.
root datasource uscam_osm_update_time (
    data_updated_through: uscam_osm_data_updated_through
)
file `./cambridge_osm_probe.py`;

# GCS publication time of the staged LIDAR canopy-height lookup (see
# ../../canopy_staging/); it moves when the `canopy-usbos` job publishes a
# rebuilt table, and that is what re-heights every tree.
root datasource uscam_canopy_update_time (
    data_updated_through: uscam_canopy_data_updated_through
)
file `./cambridge_canopy_probe.py`;

# --- Tree height ---------------------------------------------------------------
#
# Cambridge's 2024 crown polygons, rasterised onto the position grid by
# shared/canopy.py together with Boston's 2024 centroids: one table for both
# surveys (CANOPY_STAGED_WITH), because a crown on the town line shades trees
# on both sides of it.  ../tree_height.preql keys every raw row into the grid
# and carries the crown's height through the cluster merge; the partitions
# need no column.
root datasource uscam_canopy_height (
    canopy_cell: canopy_cell,
    canopy_crown_id: canopy_crown_id,
    canopy_height_m: canopy_height_m,
    canopy_crown_radius_m: canopy_crown_radius_m,
    canopy_source: canopy_source,
)
grain (canopy_cell)
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/usbos_canopy_height.parquet`;

# Every partition extends ../tree_dedup.preql's `tree_partition`, which maps
# the shared raw_* columns; a source that names a column differently re-binds
# it here (`dbh: ?raw_dbh`).
root partial datasource cambridge_raw_tree_info extends tree_partition (
    data_source: uscam_source,
    species: ?raw_species,
)
complete where city = 'USCAM' and uscam_source = 'CAMBRIDGE'
file `./cambridge_tree_info.py`;

# MIT's campus inventory, from MIT's own layer (the 2024 Bartlett resurvey,
# kept current by the grounds team).  The city's feed carries an older copy of
# it, which ./cambridge_tree_info.py drops; see ./mit_tree_info.py.
root partial datasource mit_raw_tree_info extends tree_partition (
    data_source: uscam_source,
    species: ?raw_species,
)
complete where city = 'USCAM' and uscam_source = 'MIT'
file `./mit_tree_info.py`;


# Approved community submissions for this city. The shared ingest script emits
# every city's rows; the `complete where` clause narrows it to USCAM and makes
# it a disjoint partition, and the `where` clause is what actually filters --
# `complete where` asserts, it does not promise a predicate.  A submission
# recorded under Boston that stands in Cambridge arrives here as USCAM
# (`territory_city` in shared/ingest.py).
root partial datasource uscam_community_tree_info extends tree_partition (
    data_source: uscam_source,
    species: ?raw_species,
)
complete where city = 'USCAM' and uscam_source = 'COMMUNITY_USCAM'
file `../community_tree_info.py`
where city = 'USCAM';


# Reviewed aerial-imagery detections (reviewer/satellite.ts), read from the
# public export the reviewer publishes -- see ../satellite_tree_info.py.  The
# tiles were reviewed as Boston's; a detection that stands in Cambridge is
# re-homed the same way.
root partial datasource uscam_satellite_tree_info extends tree_partition (
    data_source: uscam_source,
    species: ?raw_species,
)
complete where city = 'USCAM' and uscam_source = 'SATELLITE_USCAM'
file `../satellite_tree_info.py`
where city = 'USCAM';


# Bulk aerial-imagery predictions, published without per-tree review (see
# ../predicted_tree_info.py): the rows of the Boston metro run that fall
# inside Cambridge.  The weakest class in the shared merge: any tree another
# source has absorbs the prediction and takes none of its values.  No
# `source_kept` guard: a new run at a stricter threshold may rightly shed a
# quarter of them.
root partial datasource uscam_predicted_tree_info extends tree_partition (
    data_source: uscam_source,
    species: ?raw_species,
)
complete where city = 'USCAM' and uscam_source = 'PREDICTED_USCAM'
file `../predicted_tree_info.py`
where city = 'USCAM';


# OpenStreetMap trees, read from the staged parquet in GCS rather than Overpass
# -- extraction is decoupled from refresh. OSM overlaps the municipal inventory
# by construction; the overlap is resolved by ../tree_dedup.preql. The `where`
# is the city's territory (tools/sync_osm_territory.py keeps it so): a
# staged extract keeps the territory it was cut with until its next firing.
root partial datasource uscam_osm_tree_info extends tree_partition (
    data_source: uscam_source,
    species: ?raw_species,
)
complete where city = 'USCAM' and uscam_source = 'OSM_USCAM'
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/uscam_osm_staging.parquet`
where (raw_latitude >= 42.3524 and raw_latitude < 42.4043 and raw_longitude >= -71.1604 and raw_longitude < -71.0639);


# --- Cross-source dedup and attribute merge --------------------------------
#
# Shared: ../tree_dedup.preql groups the partitions into one cluster per
# tree and picks each canonical attribute across the cluster; this city's grid
# cell size and its calibration live in DEDUP_CELL_METRES in shared/ingest.py.
# A missing dbh is imputed from the city-and-species average, as it was while
# these rows were Boston's (see ../usbos/boston_tree_info.preql for why the
# imputation runs on each raw row before the merge and not after it).
auto imputed_dbh <- coalesce(cleaned_dbh, avg(cleaned_dbh) by city, raw_species);
auto processed_dbh <- @corrected_dbh(imputed_dbh);
merge processed_dbh into diameter_at_breast_height;
merge merged_latitude into latitude;
merge merged_longitude into longitude;


# --- Street trees both the city and MIT inventory ---------------------------
#
# The shared merge makes every municipal row its own cluster, so a tree the
# city and MIT both record would publish twice.  They meet along the campus
# edge (Massachusetts Avenue, Vassar Street, Ames Street, Memorial Drive):
# measured 2026-11-25, MIT's nearest city tree is under 1 m for 83 of its
# trees, 1-2 m for 145, 2-3 m for 25 and 3-4 m for 28, the genus agreeing 83%,
# 77%, 72% and 61% of the time, and 30% at 4-5 m.  The same block as
# Melbourne's councils (aumel/melbourne_tree_info.preql, docs/BORDER_DEDUP.md)
# with its 3 m cell: a guaranteed match within 1.5 m, a possible one to the
# 4.2 m diagonal.  MIT's own tenth-percentile spacing is 2.9 m, which costs
# nothing: one inventory never marks its own rows.
#
# A row is a border duplicate when a row of an EARLIER-wired inventory (the
# enum's order: the city first, so the ids people have linked to stay) names
# the same genus and shares a cell with it in any of four half-cell-staggered
# grids.
auto uscam_border_rank <- case
    when uscam_source = 'CAMBRIDGE' then 1
    when uscam_source = 'MIT' then 2
    else null
end;
auto uscam_raw_genus <- case
    when strpos(raw_species, ' ') > 0 then substring(raw_species, 1, strpos(raw_species, ' ') - 1)
    else raw_species
end;

# 3 m at 42.37N: 3 / 111320 degrees of latitude, and that over cos(42.37) for
# longitude.  The indices stay under 3e6 in magnitude, inside the 1e7
# multiplier.  The genus is part of the cell key (a per-genus cross product
# between the four aggregates otherwise); a row with no genus keys on its own
# tree_id and never matches.
def uscam_border_cell(dx, dy) -> concat(
    cast(
        cast(floor(raw_longitude / 0.00003646 + dx) as bigint) * 10000000
        + cast(floor(raw_latitude / 0.00002695 + dy) as bigint)
    as string),
    '|',
    coalesce(uscam_raw_genus, concat('#', tree_id))
);
def uscam_first_rank(cell) -> min(uscam_border_rank) by cell;

auto uscam_border_cell_a <- @uscam_border_cell(0, 0);
auto uscam_border_cell_b <- @uscam_border_cell(0.5, 0);
auto uscam_border_cell_c <- @uscam_border_cell(0, 0.5);
auto uscam_border_cell_d <- @uscam_border_cell(0.5, 0.5);

# The row's own rank as a self-aggregate on `row_key`: comparing a cell
# aggregate with a row-level case directly is the keyless-join planner bug.
auto uscam_own_border_rank <- min(uscam_border_rank) by row_key;
# least() skips nulls: a row with no partner in a grid compares against the
# others.
auto uscam_border_duplicate <- coalesce(
    uscam_own_border_rank > least(
        @uscam_first_rank(uscam_border_cell_a),
        @uscam_first_rank(uscam_border_cell_b),
        @uscam_first_rank(uscam_border_cell_c),
        @uscam_first_rank(uscam_border_cell_d)
    ),
    false
);


# The published target extends ../tree_dedup.preql's `published_tree_info`:
# the canonical columns, the prune, and the guard that refuses a build which
# lost a quarter of the city.  The `@source_kept` lines are the same guard
# per bulk source (`test_every_city_refuses_a_collapsed_build`).  The `where`
# drops the border duplicates above; `uscam_border_duplicate` is stored
# (always false) because a datasource's `where` may only read the
# datasource's own columns.
partial datasource cambridge_tree_info extends published_tree_info (
    data_source: uscam_source,
    ?species,
    ?height_m,
    ?height_crown_radius_m,
    uscam_border_duplicate,
    uscam_published_data_updated_through,
)
complete where city = 'USCAM'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/uscam_tree_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/uscam_tree_info_v{data_version}.parquet`
where uscam_border_duplicate = false
freshness by uscam_published_data_updated_through
assert @source_kept(tree_id, uscam_source, 'CAMBRIDGE', 0.75)
assert @source_kept(tree_id, uscam_source, 'MIT', 0.75)
assert @source_kept(tree_id, uscam_source, 'OSM_USCAM', 0.75);
