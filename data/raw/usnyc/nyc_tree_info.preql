import ..tree_common;
import ..community_tree_info;
import ..tree_dedup;

auto usnyc_published_data_updated_through <- greatest(usnyc_data_updated_through, usnyc_community_data_updated_through, usnyc_osm_data_updated_through);

key usnyc_source enum<string>['NYC_OPENDATA', 'COMMUNITY_USNYC', 'OSM_USNYC']; # originating dataset for the row

# Feed the shared cross-source merge (../tree_dedup.preql): it classifies rows
# by the label's prefix and records provenance from it.
auto usnyc_source_label <- concat(usnyc_source, '');
merge usnyc_source_label into source_label;

root datasource nyc_update_time (
    data_updated_through: usnyc_data_updated_through
)
file `./nyc_update_time.py`;

# Only this city's column, so an approval elsewhere does not mark USNYC's
# Parquet stale. Trilogy probes this as MAX over the one column.
root datasource usnyc_community_update_time (
    usnyc_community_data_updated_through: usnyc_community_data_updated_through
)
file `../community_update_time.py`;




# GCS publication time of the staged OSM parquet (see nyc_osm_extract.py);
# it only moves when an extraction is re-run and uploaded.
root datasource usnyc_osm_update_time (
    data_updated_through: usnyc_osm_data_updated_through
)
file `./nyc_osm_probe.py`;

# OpenStreetMap trees, read from the staged parquet in GCS rather than
# Overpass -- extraction is decoupled from refresh (see _osm_shared.py and
# EXTENDING.md).  Overlapping rows are resolved by the
# shared cluster merge (../tree_dedup.preql).
root partial datasource usnyc_osm_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: usnyc_source,
    species: ?raw_species,
    tree_name: ?raw_tree_name,
    plant_date: ?raw_plant_date,
    latitude: ?raw_latitude,
    longitude: ?raw_longitude,
    diameter_at_breast_height: ?raw_dbh,
    submission_photo_url: ?raw_photo_url,
)
grain (tree_id)
complete where city = 'USNYC' and usnyc_source = 'OSM_USNYC'
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/usnyc_osm_staging.parquet`;

root partial datasource nyc_raw_tree_info (
    objectid: tree_id,
    city: city,
    data_source: usnyc_source,
    genusspecies: raw_species,
    tree_name: ?raw_tree_name,
    dbh: ?raw_dbh,
    planteddate: ?raw_plant_date,
    latitude: ?raw_latitude,
    longitude: ?raw_longitude,
    # tpcondition: ?condition,
    # tpstructure: ?structure,
    # stumpdiameter: ?stump_diameter,
    # riskrating: ?risk_rating,
    # riskratingdate: ?risk_rating_date,
    # globalid: ?global_id,
    submission_photo_url: ?raw_photo_url,
)
grain (tree_id)
complete where city = 'USNYC' and usnyc_source = 'NYC_OPENDATA'
file `./nyc_tree_info.py`;


# Approved community submissions for this city. The shared ingest script
# emits every city's rows; the `complete where` clause narrows it to USNYC
# and makes it a disjoint partition alongside nyc_raw_tree_info.
root partial datasource usnyc_community_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: usnyc_source,
    species: raw_species,
    tree_name: ?raw_tree_name,
    plant_date: ?raw_plant_date,
    diameter_at_breast_height: ?raw_dbh,
    latitude: ?raw_latitude,
    longitude: ?raw_longitude,
    submission_photo_url: ?raw_photo_url,
)
grain (tree_id)
complete where city = 'USNYC' and usnyc_source = 'COMMUNITY_USNYC'
file `../community_tree_info.py`
where city = 'USNYC';



# --- Cross-source dedup and attribute merge --------------------------------
#
# Shared: ../tree_dedup.preql groups the three partitions into one cluster per
# tree and picks each canonical attribute across the cluster; this city's grid
# cell size and its calibration live in DEDUP_CELL_METRES in _ingest_shared.py.
# The only per-city line is the dbh merge, because Boston imputes it.
merge merged_dbh into diameter_at_breast_height;


# INTENDED END STATE: `where tree_id = cluster_id` on this target, so the
# parquet holds exactly one row per tree and needs no client-side filter; see
# "Intended end state" in ../tree_dedup.preql for what blocks it upstream.
partial datasource nyc_tree_info (
    tree_id,
    city,
    data_source: usnyc_source,
    species,
    ?tree_name,
    ?diameter_at_breast_height,
    ?plant_date,
    ?latitude,
    ?longitude,
    ?submission_photo_url,
    merged_sources,
    ?merged_tree_ids,
    is_duplicate,
    usnyc_published_data_updated_through,
    # ?condition,
    # ?structure,
    # ?stump_diameter,
    # ?risk_rating,
    # ?risk_rating_date,
    # ?global_id,
)
grain (tree_id)
complete where city = 'USNYC'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/usnyc_tree_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/usnyc_tree_info_v{data_version}.parquet`
where tree_id = cluster_id
freshness by usnyc_published_data_updated_through;

#trilogy refresh C:\Users\ethan\coding_projects\sf_tree_reporting\data\raw\nyc\nyc_tree_info.preql --force=nyc_tree_info
# trilogy refresh C:\Users\ethan\coding_projects\sf_tree_reporting\data\raw\tree_info.preql --force=nyc_tree_info
