import ..tree_common;
import ..community_tree_info;

auto usnyc_published_data_updated_through <- greatest(usnyc_data_updated_through, usnyc_community_data_updated_through, usnyc_osm_data_updated_through);

key usnyc_source enum<string>['NYC_OPENDATA', 'COMMUNITY_USNYC', 'OSM_USNYC']; # originating dataset for the row

root datasource nyc_update_time (
    data_updated_through: usnyc_data_updated_through
)
file `./nyc_update_time.py`;

# Only this city's column, so an approval elsewhere does not mark USNYC's
# Parquet stale. Trilogy probes this as MAX over the one column.
root datasource usnyc_community_update_time (
    usnyc_community_data_updated_through: usnyc_community_data_updated_through
)
file `../community_update_time.py`;




# GCS publication time of the staged OSM parquet (see nyc_osm_extract.py);
# it only moves when an extraction is re-run and uploaded.
root datasource usnyc_osm_update_time (
    data_updated_through: usnyc_osm_data_updated_through
)
file `./nyc_osm_probe.py`;

# OpenStreetMap trees, read from the staged parquet in GCS rather than
# Overpass -- extraction is decoupled from refresh (see _osm_shared.py and
# EXTENDING.md).  Overlapping rows are kept and flagged via
# usnyc_is_duplicate below, never dropped: the Parquet must contain the union
# of its declared sources, and the flag keeps the dedup tunable and auditable.
root partial datasource usnyc_osm_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: usnyc_source,
    species: ?species,
    tree_name: ?tree_name,
    plant_date: ?plant_date,
    latitude: ?latitude,
    longitude: ?longitude,
    diameter_at_breast_height: ?diameter_at_breast_height,
    submission_photo_url: ?submission_photo_url,
)
grain (tree_id)
complete where city = 'USNYC' and usnyc_source = 'OSM_USNYC'
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/usnyc_osm_staging.parquet`;

root partial datasource nyc_raw_tree_info (
    objectid: tree_id,
    city: city,
    data_source: usnyc_source,
    genusspecies: species,
    tree_name: ?tree_name,
    dbh: ?diameter_at_breast_height,
    planteddate: ?plant_date,
    latitude: ?latitude,
    longitude: ?longitude,
    # tpcondition: ?condition,
    # tpstructure: ?structure,
    # stumpdiameter: ?stump_diameter,
    # riskrating: ?risk_rating,
    # riskratingdate: ?risk_rating_date,
    # globalid: ?global_id,
    submission_photo_url: ?submission_photo_url,
)
grain (tree_id)
complete where city = 'USNYC' and usnyc_source = 'NYC_OPENDATA'
file `./nyc_tree_info.py`;


# Approved community submissions for this city. The shared ingest script
# emits every city's rows; the `complete where` clause narrows it to USNYC
# and makes it a disjoint partition alongside nyc_raw_tree_info.
root partial datasource usnyc_community_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: usnyc_source,
    species: species,
    tree_name: ?tree_name,
    plant_date: ?plant_date,
    diameter_at_breast_height: ?diameter_at_breast_height,
    latitude: ?latitude,
    longitude: ?longitude,
    submission_photo_url: ?submission_photo_url,
)
grain (tree_id)
complete where city = 'USNYC' and usnyc_source = 'COMMUNITY_USNYC'
file `../community_tree_info.py`
where city = 'USNYC';



# --- Cross-source dedup: stack + aggregate over four staggered grids -------
#
# Same construction as ustem/tempe_tree_info.preql (full rationale there and in
# EXTENDING.md): an OSM row is a duplicate when a non-OSM tree shares its
# ~10m grid cell in ANY of four half-cell-staggered grid copies -- a guaranteed
# match within 5m, possible out to a ~14m diagonal.
#
# The 10m cell is PROVISIONAL until this city is calibrated:
#     cd data/raw && uv run osm_dedup_validation.py --city USNYC
# The break between re-mapped duplicates and interstitial neighbours sits
# wherever this city's OSM positional error ends and its planting spacing
# begins, so it has to be measured rather than copied from Tempe.
#
# Cell sizes: 10m of latitude is 10/111320 deg; longitude shrinks by
# cos(40.70 deg) here.
const usnyc_cell_lat_deg <- 0.00008983;
const usnyc_cell_lon_deg <- 0.00011849;

auto usnyc_cell_a <- concat(cast(floor(longitude / usnyc_cell_lon_deg) as string), ':', cast(floor(latitude / usnyc_cell_lat_deg) as string));
auto usnyc_cell_b <- concat(cast(floor(longitude / usnyc_cell_lon_deg + 0.5) as string), ':', cast(floor(latitude / usnyc_cell_lat_deg) as string));
auto usnyc_cell_c <- concat(cast(floor(longitude / usnyc_cell_lon_deg) as string), ':', cast(floor(latitude / usnyc_cell_lat_deg + 0.5) as string));
auto usnyc_cell_d <- concat(cast(floor(longitude / usnyc_cell_lon_deg + 0.5) as string), ':', cast(floor(latitude / usnyc_cell_lat_deg + 0.5) as string));

auto usnyc_anchor_count_a <- count(tree_id ? usnyc_source != 'OSM_USNYC') by usnyc_cell_a;
auto usnyc_anchor_count_b <- count(tree_id ? usnyc_source != 'OSM_USNYC') by usnyc_cell_b;
auto usnyc_anchor_count_c <- count(tree_id ? usnyc_source != 'OSM_USNYC') by usnyc_cell_c;
auto usnyc_anchor_count_d <- count(tree_id ? usnyc_source != 'OSM_USNYC') by usnyc_cell_d;

auto usnyc_is_duplicate <- usnyc_source = 'OSM_USNYC' and (
    usnyc_anchor_count_a > 0
    or usnyc_anchor_count_b > 0
    or usnyc_anchor_count_c > 0
    or usnyc_anchor_count_d > 0
);

partial datasource nyc_tree_info (
    tree_id,
    city,
    data_source: usnyc_source,
    species,
    ?tree_name,
    ?diameter_at_breast_height,
    ?plant_date,
    ?latitude,
    ?longitude,
    ?submission_photo_url,
    is_duplicate: usnyc_is_duplicate,
    usnyc_published_data_updated_through,
    # ?condition,
    # ?structure,
    # ?stump_diameter,
    # ?risk_rating,
    # ?risk_rating_date,
    # ?global_id,
)
grain (tree_id)
complete where city = 'USNYC'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/usnyc_tree_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/usnyc_tree_info_v{data_version}.parquet`
freshness by usnyc_published_data_updated_through;

