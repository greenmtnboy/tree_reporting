import ..tree_common;
import ..community_tree_info;
import ..satellite_tree_info;
import ..tree_dedup;

# Dedham's trees were published by Boston's metro model, whose bulk imagery
# run covers it, until Boston was clipped to its own line (#277).  It is its
# own city now, its territory drawn by the town's real boundary
# (boundaries/usded.json), with the town's own inventory beside the community,
# satellite, predicted and OSM rows the metro published there.

auto usded_published_data_updated_through <- greatest(usded_data_updated_through, usded_community_data_updated_through, usded_osm_data_updated_through, usded_satellite_data_updated_through, usded_predicted_data_updated_through);

key usded_source enum<string>['DEDHAM', 'COMMUNITY_USDED', 'OSM_USDED', 'SATELLITE_USDED', 'PREDICTED_USDED']; # originating dataset for the row

# Feed the shared cross-source merge (../tree_dedup.preql): it classifies rows
# by the label's prefix and records provenance from it.
auto usded_source_label <- concat(usded_source, '');
merge usded_source_label into source_label;

root datasource dedham_update_time (
    data_updated_through: usded_data_updated_through
)
file `./dedham_update_time.py`;

# Only this city's column, so an approval elsewhere does not mark USDED's
# Parquet stale. Trilogy probes this as MAX over the one column.
root datasource usded_community_update_time (
    usded_community_data_updated_through: usded_community_data_updated_through
)
file `../community_update_time.py`;

# Likewise for reviewed aerial-imagery detections: one column, this city's.
root datasource usded_satellite_update_time (
    usded_satellite_data_updated_through: usded_satellite_data_updated_through
)
file `../satellite_update_time.py`;

# Bulk imagery predictions: the publication time of the staged file this town
# reads, which is the Boston metro run's (PREDICTED_STAGED_WITH).
root datasource usded_predicted_update_time (
    usded_predicted_data_updated_through: usded_predicted_data_updated_through
)
file `../predicted_update_time.py`;

# GCS publication time of the staged OSM parquet; it only moves when an
# extraction is re-run and uploaded. Not a local mtime -- git does not preserve
# it, so a committed staging file makes every fresh clone look like new data.
root datasource usded_osm_update_time (
    data_updated_through: usded_osm_data_updated_through
)
file `./dedham_osm_probe.py`;

# Every partition extends ../tree_dedup.preql's `tree_partition`, which maps
# the shared raw_* columns; a source that names a column differently re-binds
# it here (`dbh: ?raw_dbh`).
root partial datasource dedham_raw_tree_info extends tree_partition (
    data_source: usded_source,
    species: ?raw_species,
)
complete where city = 'USDED' and usded_source = 'DEDHAM'
file `./dedham_tree_info.py`;


# Approved community submissions for this city. The shared ingest script emits
# every city's rows; the `complete where` clause narrows it to USDED and makes
# it a disjoint partition, and the `where` clause is what actually filters --
# `complete where` asserts, it does not promise a predicate.  A submission
# recorded under Boston that stands in Dedham arrives here as USDED
# (`territory_city` in shared/ingest.py).
root partial datasource usded_community_tree_info extends tree_partition (
    data_source: usded_source,
    species: ?raw_species,
)
complete where city = 'USDED' and usded_source = 'COMMUNITY_USDED'
file `../community_tree_info.py`
where city = 'USDED';


# Reviewed aerial-imagery detections (reviewer/satellite.ts), read from the
# public export the reviewer publishes -- see ../satellite_tree_info.py.  The
# tiles were reviewed as Boston's; a detection that stands in Dedham is
# re-homed the same way.
root partial datasource usded_satellite_tree_info extends tree_partition (
    data_source: usded_source,
    species: ?raw_species,
)
complete where city = 'USDED' and usded_source = 'SATELLITE_USDED'
file `../satellite_tree_info.py`
where city = 'USDED';


# Bulk aerial-imagery predictions, published without per-tree review (see
# ../predicted_tree_info.py): the rows of the Boston metro run that fall
# inside Dedham.  The weakest class in the shared merge: any tree another
# source has absorbs the prediction and takes none of its values.  No
# `source_kept` guard: a new run at a stricter threshold may rightly shed a
# quarter of them.
root partial datasource usded_predicted_tree_info extends tree_partition (
    data_source: usded_source,
    species: ?raw_species,
)
complete where city = 'USDED' and usded_source = 'PREDICTED_USDED'
file `../predicted_tree_info.py`
where city = 'USDED';


# OpenStreetMap trees, read from the staged parquet in GCS rather than Overpass
# -- extraction is decoupled from refresh. OSM overlaps the municipal inventory
# by construction; the overlap is resolved by ../tree_dedup.preql. The `where`
# is the city's territory (tools/sync_osm_territory.py keeps it so): a
# staged extract keeps the territory it was cut with until its next firing.
root partial datasource usded_osm_tree_info extends tree_partition (
    data_source: usded_source,
    species: ?raw_species,
)
complete where city = 'USDED' and usded_source = 'OSM_USDED'
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/usded_osm_staging.parquet`
where (raw_latitude >= 42.2092 and raw_latitude < 42.2805 and raw_longitude >= -71.2318 and raw_longitude < -71.1307);


# --- Cross-source dedup and attribute merge --------------------------------
#
# Shared: ../tree_dedup.preql groups the partitions into one cluster per
# tree and picks each canonical attribute across the cluster; this city's grid
# cell size and its calibration live in DEDUP_CELL_METRES in shared/ingest.py.
merge merged_dbh into diameter_at_breast_height;
merge merged_latitude into latitude;
merge merged_longitude into longitude;


# The published target extends ../tree_dedup.preql's `published_tree_info`:
# the canonical columns, the prune, and the guard that refuses a build which
# lost a quarter of the city.  The two `@source_kept` lines are the same guard
# per bulk source (`test_every_city_refuses_a_collapsed_build`).
partial datasource dedham_tree_info extends published_tree_info (
    data_source: usded_source,
    ?species,
    usded_published_data_updated_through,
)
complete where city = 'USDED'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/usded_tree_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/usded_tree_info_v{data_version}.parquet`
freshness by usded_published_data_updated_through
assert @source_kept(tree_id, usded_source, 'DEDHAM', 0.75)
assert @source_kept(tree_id, usded_source, 'OSM_USDED', 0.75);
