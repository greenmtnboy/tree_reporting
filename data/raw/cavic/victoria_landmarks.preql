import ..landmark_common;

root datasource victoria_landmarks_update_time (
    data_updated_through: cavic_landmark_data_updated_through
)
file `./victoria_landmarks_probe.py`;

# Victoria's OCP-designated prominent heritage sites, read live off the same
# ArcGIS portal as the trees.  Twenty-three rows: the city's 933-row Heritage
# Properties layer is larger and carries no name column at all, so it names no
# ground -- see victoria_landmarks.py.
root partial datasource raw_victoria_landmark_info extends landmark_partition (
    address: ?address,
    property_type: ?property_type,
)
complete where city = 'CAVIC'
file `./victoria_landmarks.py`;

partial datasource victoria_landmark_info extends published_landmark_info (
    ?address,
    ?property_type,
    cavic_landmark_data_updated_through,
)
complete where city = 'CAVIC'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/cavic_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/cavic_landmark_info_v{data_version}.parquet`
freshness by cavic_landmark_data_updated_through;
