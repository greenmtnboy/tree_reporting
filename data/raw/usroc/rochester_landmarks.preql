import ..landmark_common;

root datasource rochester_landmarks_update_time (
    data_updated_through: usroc_landmark_data_updated_through
)
file `./rochester_landmarks_probe.py`;

# The National Park Service's National Register listings inside the City of
# Rochester's boundary, read live -- no Nominatim geocoding, no committed CSV
# and no staging object.  The City publishes no layer of its individually
# designated landmarks, only its Preservation Districts (areas, not
# published).  `lm_type` names the register and `register_number` the NRIS
# reference number.
root partial datasource raw_rochester_landmark_info extends landmark_partition (
    address: ?address,
    lm_type: ?lm_type,
    register_number: ?register_number,
    year_designated: ?year_designated,
)
complete where city = 'USROC'
file `./rochester_landmarks.py`;

partial datasource rochester_landmark_info extends published_landmark_info (
    ?address,
    ?lm_type,
    ?register_number,
    ?year_designated,
    usroc_landmark_data_updated_through,
)
complete where city = 'USROC'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/usroc_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/usroc_landmark_info_v{data_version}.parquet`
freshness by usroc_landmark_data_updated_through;
