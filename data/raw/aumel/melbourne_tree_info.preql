import ..tree_common;
import ..community_tree_info;
import ..tree_dedup;

auto aumel_published_data_updated_through <- greatest(aumel_data_updated_through, aumel_community_data_updated_through, aumel_osm_data_updated_through);

key aumel_source enum<string>['MELBOURNE_OPENDATA', 'COMMUNITY_AUMEL', 'OSM_AUMEL']; # originating dataset for the row

# Feed the shared cross-source merge (../tree_dedup.preql): it classifies rows
# by the label's prefix and records provenance from it.
auto aumel_source_label <- concat(aumel_source, '');
merge aumel_source_label into source_label;

root datasource melbourne_update_time (
    data_updated_through: aumel_data_updated_through
)
file `./melbourne_update_time.py`;

# Only this city's column, so an approval elsewhere does not mark AUMEL's
# Parquet stale. Trilogy probes this as MAX over the one column.
root datasource aumel_community_update_time (
    aumel_community_data_updated_through: aumel_community_data_updated_through
)
file `../community_update_time.py`;




# GCS publication time of the staged OSM parquet (see melbourne_osm_extract.py);
# it only moves when an extraction is re-run and uploaded.
root datasource aumel_osm_update_time (
    data_updated_through: aumel_osm_data_updated_through
)
file `./melbourne_osm_probe.py`;

# OpenStreetMap trees, read from the staged parquet in GCS rather than
# Overpass -- extraction is decoupled from refresh (see _osm_shared.py and
# EXTENDING.md).  Overlapping rows are resolved by the
# shared cluster merge (../tree_dedup.preql).
root partial datasource aumel_osm_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: aumel_source,
    species: ?raw_species,
    tree_name: ?raw_tree_name,
    plant_date: ?raw_plant_date,
    latitude: ?raw_latitude,
    longitude: ?raw_longitude,
    diameter_at_breast_height: ?raw_dbh,
    submission_photo_url: ?raw_photo_url,
)
grain (tree_id)
complete where city = 'AUMEL' and aumel_source = 'OSM_AUMEL'
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/aumel_osm_staging.parquet`;

root partial datasource melbourne_raw_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: aumel_source,
    species: raw_species,
    tree_name: ?raw_tree_name,
    plant_date: ?raw_plant_date,
    latitude: ?raw_latitude,
    longitude: ?raw_longitude,
    diameter_at_breast_height: ?raw_dbh,
    submission_photo_url: ?raw_photo_url,
)
grain (tree_id)
complete where city = 'AUMEL' and aumel_source = 'MELBOURNE_OPENDATA'
file `./melbourne_tree_info.py`;


# Approved community submissions for this city. The shared ingest script
# emits every city's rows; the `complete where` clause narrows it to AUMEL
# and makes it a disjoint partition alongside melbourne_raw_tree_info.
root partial datasource aumel_community_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: aumel_source,
    species: raw_species,
    tree_name: ?raw_tree_name,
    plant_date: ?raw_plant_date,
    diameter_at_breast_height: ?raw_dbh,
    latitude: ?raw_latitude,
    longitude: ?raw_longitude,
    submission_photo_url: ?raw_photo_url,
)
grain (tree_id)
complete where city = 'AUMEL' and aumel_source = 'COMMUNITY_AUMEL'
file `../community_tree_info.py`
where city = 'AUMEL';



# --- Cross-source dedup and attribute merge --------------------------------
#
# Shared: ../tree_dedup.preql groups the three partitions into one cluster per
# tree and picks each canonical attribute across the cluster; this city's grid
# cell size and its calibration live in DEDUP_CELL_METRES in _ingest_shared.py.
# The only per-city line is the dbh merge, because Boston imputes it.
merge merged_dbh into diameter_at_breast_height;


# INTENDED END STATE: `where tree_id = cluster_id` on this target, so the
# parquet holds exactly one row per tree and needs no client-side filter; see
# "Intended end state" in ../tree_dedup.preql for what blocks it upstream.
partial datasource melbourne_tree_info (
    tree_id,
    city,
    data_source: aumel_source,
    species,
    ?tree_name,
    ?plant_date,
    ?diameter_at_breast_height,
    ?latitude,
    ?longitude,
    ?submission_photo_url,
    merged_sources,
    ?merged_tree_ids,
    is_duplicate,
    aumel_published_data_updated_through,
)
grain (tree_id)
complete where city = 'AUMEL'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/aumel_tree_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/aumel_tree_info_v{data_version}.parquet`
freshness by aumel_published_data_updated_through;
