import ..tree_common;
import ..community_tree_info;
import ..tree_dedup;

property <*>.melbourne_city_data_updated_through datetime; # when the City of Melbourne's Urban Forest dataset is through
property <*>.port_phillip_data_updated_through datetime; # when the City of Port Phillip's trees resource on data.gov.au is through
property <*>.yarra_data_updated_through datetime; # when the City of Yarra's street and park trees resource on data.gov.au is through
property <*>.glen_eira_data_updated_through datetime; # when Glen Eira's park and street trees resource on data.gov.au is through
property <*>.hobsons_bay_data_updated_through datetime; # when Hobsons Bay's street and park trees resource on data.gov.au is through
property <*>.brimbank_data_updated_through datetime; # when Brimbank's street and open-space trees resources on data.gov.au are through
property <*>.manningham_data_updated_through datetime; # when Manningham's street trees resource on data.gov.au is through

auto aumel_published_data_updated_through <- greatest(aumel_data_updated_through, aumel_community_data_updated_through, aumel_osm_data_updated_through);
auto aumel_data_updated_through <- greatest(melbourne_city_data_updated_through, port_phillip_data_updated_through, yarra_data_updated_through, glen_eira_data_updated_through, hobsons_bay_data_updated_through, brimbank_data_updated_through, manningham_data_updated_through);

# The City of Melbourne plus six metropolitan councils inside AUMEL's
# territory, each its own municipal partition (the Boston metro pattern).
key aumel_source enum<string>['MELBOURNE_OPENDATA', 'PORT_PHILLIP', 'YARRA', 'GLEN_EIRA', 'HOBSONS_BAY', 'BRIMBANK', 'MANNINGHAM', 'COMMUNITY_AUMEL', 'OSM_AUMEL']; # originating dataset for the row

# Feed the shared cross-source merge (../tree_dedup.preql): it classifies rows
# by the label's prefix and records provenance from it.
auto aumel_source_label <- concat(aumel_source, '');
merge aumel_source_label into source_label;

root datasource melbourne_update_time (
    data_updated_through: melbourne_city_data_updated_through
)
file `./melbourne_update_time.py`;

# The six councils publish on data.gov.au's CKAN; each probe is the
# resource's data watermark (shared/platforms/ckan.py `data_last_modified`).
root datasource port_phillip_update_time (
    data_updated_through: port_phillip_data_updated_through
)
file `./port_phillip_update_time.py`;

root datasource yarra_update_time (
    data_updated_through: yarra_data_updated_through
)
file `./yarra_update_time.py`;

root datasource glen_eira_update_time (
    data_updated_through: glen_eira_data_updated_through
)
file `./glen_eira_update_time.py`;

root datasource hobsons_bay_update_time (
    data_updated_through: hobsons_bay_data_updated_through
)
file `./hobsons_bay_update_time.py`;

# Brimbank's probe is the later of its two shapefile resources (street and
# open-space trees), both read by one ingest.
root datasource brimbank_update_time (
    data_updated_through: brimbank_data_updated_through
)
file `./brimbank_update_time.py`;

root datasource manningham_update_time (
    data_updated_through: manningham_data_updated_through
)
file `./manningham_update_time.py`;

# Only this city's column, so an approval elsewhere does not mark AUMEL's
# Parquet stale. Trilogy probes this as MAX over the one column.
root datasource aumel_community_update_time (
    aumel_community_data_updated_through: aumel_community_data_updated_through
)
file `../community_update_time.py`;




# GCS publication time of the staged OSM parquet (see melbourne_osm_extract.py);
# it only moves when an extraction is re-run and uploaded.
root datasource aumel_osm_update_time (
    data_updated_through: aumel_osm_data_updated_through
)
file `./melbourne_osm_probe.py`;

# OpenStreetMap trees, read from the staged parquet in GCS rather than
# Overpass -- extraction is decoupled from refresh (see shared/osm.py and
# EXTENDING.md).  Overlapping rows are resolved by the
# shared cluster merge (../tree_dedup.preql).
root partial datasource aumel_osm_tree_info extends tree_partition (
    data_source: aumel_source,
    species: ?raw_species,
)
complete where city = 'AUMEL' and aumel_source = 'OSM_AUMEL'
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/aumel_osm_staging.parquet`
where (raw_latitude >= -38.1 and raw_latitude < -37.57 and raw_longitude >= 144.55 and raw_longitude < 145.4);

root partial datasource melbourne_raw_tree_info extends tree_partition (
    data_source: aumel_source,
)
complete where city = 'AUMEL' and aumel_source = 'MELBOURNE_OPENDATA'
file `./melbourne_tree_info.py`;

# The neighbouring councils.  Port Phillip and Yarra share boundary
# streets with the City of Melbourne, so a tree on one of those can appear in
# two inventories; the cross-source merge never joins two municipal rows, so
# such a pair stays two rows.  Yarra and Hobsons Bay publish no crown spread
# (the template binds it; the column is emitted null).
root partial datasource port_phillip_raw_tree_info extends tree_partition (
    data_source: aumel_source,
)
complete where city = 'AUMEL' and aumel_source = 'PORT_PHILLIP'
file `./port_phillip_tree_info.py`;

root partial datasource yarra_raw_tree_info extends tree_partition (
    data_source: aumel_source,
)
complete where city = 'AUMEL' and aumel_source = 'YARRA'
file `./yarra_tree_info.py`;

root partial datasource glen_eira_raw_tree_info extends tree_partition (
    data_source: aumel_source,
)
complete where city = 'AUMEL' and aumel_source = 'GLEN_EIRA'
file `./glen_eira_tree_info.py`;

root partial datasource hobsons_bay_raw_tree_info extends tree_partition (
    data_source: aumel_source,
)
complete where city = 'AUMEL' and aumel_source = 'HOBSONS_BAY'
file `./hobsons_bay_tree_info.py`;

# Brimbank (west) and Manningham (east) publish no asset number, so their
# ids are the tree's coordinate (shared/ingest.py `coordinate_tree_id`).
# Neither shares a boundary with another wired council.  Manningham publishes
# no crown spread (the column is emitted null).
root partial datasource brimbank_raw_tree_info extends tree_partition (
    data_source: aumel_source,
)
complete where city = 'AUMEL' and aumel_source = 'BRIMBANK'
file `./brimbank_tree_info.py`;

root partial datasource manningham_raw_tree_info extends tree_partition (
    data_source: aumel_source,
)
complete where city = 'AUMEL' and aumel_source = 'MANNINGHAM'
file `./manningham_tree_info.py`;


# Approved community submissions for this city. The shared ingest script
# emits every city's rows; the `complete where` clause narrows it to AUMEL
# and makes it a disjoint partition alongside melbourne_raw_tree_info.
root partial datasource aumel_community_tree_info extends tree_partition (
    data_source: aumel_source,
)
complete where city = 'AUMEL' and aumel_source = 'COMMUNITY_AUMEL'
file `../community_tree_info.py`
where city = 'AUMEL';



# --- Cross-source dedup and attribute merge --------------------------------
#
# Shared: ../tree_dedup.preql groups the three partitions into one cluster per
# tree and picks each canonical attribute across the cluster; this city's grid
# cell size and its calibration live in DEDUP_CELL_METRES in shared/ingest.py.
# The only per-city line is the dbh merge, because Boston imputes it.
merge merged_dbh into diameter_at_breast_height;
# Position: the survivor's own point.  A city with an Overture lookup imports
# ../tree_position.preql instead, which merges the corrected point.
merge merged_latitude into latitude;
merge merged_longitude into longitude;


# --- Border trees between the councils' inventories --------------------------
#
# The shared merge makes every municipal row its own cluster, so a tree two
# councils both inventory would publish twice.  Boston's metro has the same
# block (usbos/boston_tree_info.preql; the design is docs/BORDER_DEDUP.md).
# Here it is the City of Melbourne and Yarra along their shared streets
# (Hoddle Street, Victoria Parade, Alexandra Parade): measured 2026-11-16 on
# the published rows, Yarra's nearest Melbourne tree is under 1 m for 27, 1-2 m
# for 45, 2-3 m for 26 and 3-4 m for 6, and the genus agrees for every one of
# them (Melbourne publishes most of these at genus rank).  No other pair has a
# tree within 2 m.  The offset runs wider than Boston's, so the cell is 3 m:
# a guaranteed match within 1.5 m, a possible one to the 4.2 m diagonal,
# still under Yarra's own 3.4 m tenth-percentile spacing.  Simulated on the
# published rows, it drops 94 Yarra rows and no Melbourne tree is claimed by
# two of them.
#
# A row is a border duplicate when a row of an EARLIER-wired inventory (the
# enum's order) names the same genus and shares a cell with it in any of four
# half-cell-staggered grids.  Earlier wins because its ids were published
# first.  Two rows of one inventory never mark each other.
auto aumel_border_rank <- case
    when aumel_source = 'MELBOURNE_OPENDATA' then 1
    when aumel_source = 'PORT_PHILLIP' then 2
    when aumel_source = 'YARRA' then 3
    when aumel_source = 'GLEN_EIRA' then 4
    when aumel_source = 'HOBSONS_BAY' then 5
    when aumel_source = 'BRIMBANK' then 6
    when aumel_source = 'MANNINGHAM' then 7
    else null
end;
auto aumel_raw_genus <- case
    when strpos(raw_species, ' ') > 0 then substring(raw_species, 1, strpos(raw_species, ' ') - 1)
    else raw_species
end;

# 3 m at 37.81S: 3 / 111320 degrees of latitude, and that over cos(37.81) for
# longitude.  The indices stay under 5e6 in magnitude, inside the 1e7
# multiplier.  The genus is part of the cell key for the reason Boston's is
# (a per-genus cross product between the four aggregates otherwise); a row
# with no genus keys on its own tree_id and never matches.
def aumel_border_cell(dx, dy) -> concat(
    cast(
        cast(floor(raw_longitude / 0.00003411 + dx) as bigint) * 10000000
        + cast(floor(raw_latitude / 0.00002695 + dy) as bigint)
    as string),
    '|',
    coalesce(aumel_raw_genus, concat('#', tree_id))
);
def aumel_first_rank(cell) -> min(aumel_border_rank) by cell;

auto aumel_border_cell_a <- @aumel_border_cell(0, 0);
auto aumel_border_cell_b <- @aumel_border_cell(0.5, 0);
auto aumel_border_cell_c <- @aumel_border_cell(0, 0.5);
auto aumel_border_cell_d <- @aumel_border_cell(0.5, 0.5);

# The row's own rank as a self-aggregate on `row_key`: comparing a cell
# aggregate with a row-level case directly is the keyless-join planner bug.
auto aumel_own_border_rank <- min(aumel_border_rank) by row_key;
# least() skips nulls: a row with no partner in a grid compares against the
# others.
auto aumel_border_duplicate <- coalesce(
    aumel_own_border_rank > least(
        @aumel_first_rank(aumel_border_cell_a),
        @aumel_first_rank(aumel_border_cell_b),
        @aumel_first_rank(aumel_border_cell_c),
        @aumel_first_rank(aumel_border_cell_d)
    ),
    false
);


# The `where` below is the prune: this target publishes only the row that owns
# its cluster, so the parquet holds exactly one tree per row, and drops the
# border duplicates above.  It needs pytrilogy 0.3.378+ -- see "The prune" in
# ../tree_dedup.preql.  `aumel_border_duplicate` is stored (always false)
# because a datasource's `where` may only read the datasource's own columns.
partial datasource melbourne_tree_info extends published_tree_info (
    data_source: aumel_source,
    aumel_border_duplicate,
    aumel_published_data_updated_through,
)
complete where city = 'AUMEL'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/aumel_tree_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/aumel_tree_info_v{data_version}.parquet`
where aumel_border_duplicate = false
freshness by aumel_published_data_updated_through
assert @source_kept(tree_id, aumel_source, 'MELBOURNE_OPENDATA', 0.75)
assert @source_kept(tree_id, aumel_source, 'PORT_PHILLIP', 0.75)
assert @source_kept(tree_id, aumel_source, 'YARRA', 0.75)
assert @source_kept(tree_id, aumel_source, 'GLEN_EIRA', 0.75)
assert @source_kept(tree_id, aumel_source, 'HOBSONS_BAY', 0.75)
assert @source_kept(tree_id, aumel_source, 'BRIMBANK', 0.75)
assert @source_kept(tree_id, aumel_source, 'MANNINGHAM', 0.75)
assert @source_kept(tree_id, aumel_source, 'OSM_AUMEL', 0.75);
