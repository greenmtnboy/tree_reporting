import ..landmark_common;

root datasource melbourne_landmarks_update_time (
    data_updated_through: aumel_landmark_data_updated_through
)
file `./melbourne_landmarks_probe.py`;

root partial datasource raw_melbourne_landmark_info (
    landmark_id: landmark_id,
    city: city,
    name: name,
    geometry_raw: ?geometry_raw,
)
grain (landmark_id)
complete where city = 'AUMEL'
file `./melbourne_landmarks.py`;

partial datasource melbourne_landmark_info (
    landmark_id,
    city,
    name,
    ?geometry,
    ?latitude,
    ?longitude,
    aumel_landmark_data_updated_through,
)
grain (landmark_id)
complete where city = 'AUMEL'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/aumel_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/aumel_landmark_info_v{data_version}.parquet`
freshness by aumel_landmark_data_updated_through;
