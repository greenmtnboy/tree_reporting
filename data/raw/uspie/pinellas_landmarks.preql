import ..landmark_common;

root datasource pinellas_landmarks_update_time (
    data_updated_through: uspie_landmark_data_updated_through
)
file `./pinellas_landmarks_probe.py`;

# Pinellas County's Historic Landmarks (unincorporated Pinellas, designated by
# the Board of County Commissioners under Chapter 146 of the Land Development
# Code) and the National Park Service's National Register listings in the
# County -- registers read live, so no Nominatim geocoding, no committed CSV
# and no staging object.  `lm_type` names the register and `register_number`
# the NRIS reference number (the County register publishes none).
root partial datasource raw_pinellas_landmark_info extends landmark_partition (
    address: ?address,
    lm_type: ?lm_type,
    register_number: ?register_number,
    year_designated: ?year_designated,
)
complete where city = 'USPIE'
file `./pinellas_landmarks.py`;

partial datasource pinellas_landmark_info extends published_landmark_info (
    ?address,
    ?lm_type,
    ?register_number,
    ?year_designated,
    uspie_landmark_data_updated_through,
)
complete where city = 'USPIE'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/uspie_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/uspie_landmark_info_v{data_version}.parquet`
freshness by uspie_landmark_data_updated_through;
