import ..landmark_common;

root datasource montpellier_landmarks_update_time (
    data_updated_through: frmpl_landmark_data_updated_through
)
file `./montpellier_landmarks_probe.py`;

# Montpellier's protected monuments -- buildings classés or inscrits under the
# Monuments Historiques -- read from the Ministry of Culture's national Mérimée
# export (Licence Ouverte v2.0) and filtered to the commune of Montpellier
# (INSEE 34172); see montpellier_landmarks.py.  The register's own attributes
# ride along in existing landmark_common properties: the address, the
# protection (date and type, as Paris carries it) and the building type.
root partial datasource raw_montpellier_landmark_info extends landmark_partition (
    address: ?address,
    protection_type: ?protection_type,
    denomination: ?denomination,
)
complete where city = 'FRMPL'
file `./montpellier_landmarks.py`;

partial datasource montpellier_landmark_info extends published_landmark_info (
    ?address,
    ?protection_type,
    ?denomination,
    frmpl_landmark_data_updated_through,
)
complete where city = 'FRMPL'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/frmpl_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/frmpl_landmark_info_v{data_version}.parquet`
freshness by frmpl_landmark_data_updated_through;
