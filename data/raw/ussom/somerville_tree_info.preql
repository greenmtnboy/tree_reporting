import ..tree_common;
import ..community_tree_info;
import ..satellite_tree_info;
import ..tree_dedup;
import ..boundaries;

# Somerville was a partition of Boston's metro model until the map stopped needing
# one parquet per metro (docs/SEAMLESS_WORLD.md); it is its own city now, with
# its territory drawn by the town's real boundary (boundaries/ussom.geojson).
# Its `data_source` label, its tree ids and its ingest are what they were.

auto ussom_published_data_updated_through <- greatest(ussom_data_updated_through, ussom_community_data_updated_through, ussom_osm_data_updated_through, ussom_satellite_data_updated_through, ussom_predicted_data_updated_through);

key ussom_source enum<string>['SOMERVILLE', 'COMMUNITY_USSOM', 'OSM_USSOM', 'SATELLITE_USSOM', 'PREDICTED_USSOM']; # originating dataset for the row

# Feed the shared cross-source merge (../tree_dedup.preql): it classifies rows
# by the label's prefix and records provenance from it.
auto ussom_source_label <- concat(ussom_source, '');
merge ussom_source_label into source_label;

root datasource somerville_update_time (
    data_updated_through: ussom_data_updated_through
)
file `./somerville_update_time.py`;

# Only this city's column, so an approval elsewhere does not mark USSOM's
# Parquet stale. Trilogy probes this as MAX over the one column.
root datasource ussom_community_update_time (
    ussom_community_data_updated_through: ussom_community_data_updated_through
)
file `../community_update_time.py`;

# Likewise for reviewed aerial-imagery detections: one column, this city's.
root datasource ussom_satellite_update_time (
    ussom_satellite_data_updated_through: ussom_satellite_data_updated_through
)
file `../satellite_update_time.py`;

# Bulk imagery predictions: the publication time of the staged file this town
# reads, which is the Boston metro run's (PREDICTED_STAGED_WITH).
root datasource ussom_predicted_update_time (
    ussom_predicted_data_updated_through: ussom_predicted_data_updated_through
)
file `../predicted_update_time.py`;

# GCS publication time of the staged OSM parquet; it only moves when an
# extraction is re-run and uploaded. Not a local mtime -- git does not preserve
# it, so a committed staging file makes every fresh clone look like new data.
root datasource ussom_osm_update_time (
    data_updated_through: ussom_osm_data_updated_through
)
file `./somerville_osm_probe.py`;

# Every partition extends ../tree_dedup.preql's `tree_partition`, which maps
# the shared raw_* columns; a source that names a column differently re-binds
# it here (`dbh: ?raw_dbh`).
root partial datasource somerville_raw_tree_info extends tree_partition (
    data_source: ussom_source,
    species: ?raw_species,
)
complete where city = 'USSOM' and ussom_source = 'SOMERVILLE'
file `./somerville_tree_info.py`;


# Approved community submissions for this city. The shared ingest script emits
# every city's rows; the `complete where` clause narrows it to USSOM and makes
# it a disjoint partition, and the `where` clause is what actually filters --
# `complete where` asserts, it does not promise a predicate.  A submission
# recorded under Boston that stands in Somerville arrives here as USSOM
# (`territory_city` in shared/ingest.py).
root partial datasource ussom_community_tree_info extends tree_partition (
    data_source: ussom_source,
    species: ?raw_species,
)
complete where city = 'USSOM' and ussom_source = 'COMMUNITY_USSOM'
file `../community_tree_info.py`
where city = 'USSOM';


# Reviewed aerial-imagery detections (reviewer/satellite.ts), read from the
# public export the reviewer publishes -- see ../satellite_tree_info.py.  The
# tiles were reviewed as Boston's; a detection that stands in Somerville is
# re-homed the same way.
root partial datasource ussom_satellite_tree_info extends tree_partition (
    data_source: ussom_source,
    species: ?raw_species,
)
complete where city = 'USSOM' and ussom_source = 'SATELLITE_USSOM'
file `../satellite_tree_info.py`
where city = 'USSOM';


# Bulk aerial-imagery predictions, published without per-tree review (see
# ../predicted_tree_info.py): the rows of the Boston metro run that fall
# inside Somerville.  The weakest class in the shared merge: any tree another
# source has absorbs the prediction and takes none of its values.  No
# `source_kept` guard: a new run at a stricter threshold may rightly shed a
# quarter of them.
root partial datasource ussom_predicted_tree_info extends tree_partition (
    data_source: ussom_source,
    species: ?raw_species,
)
complete where city = 'USSOM' and ussom_source = 'PREDICTED_USSOM'
file `../predicted_tree_info.py`
where city = 'USSOM';


# OpenStreetMap trees, read from the staged parquet in GCS rather than Overpass
# -- extraction is decoupled from refresh. OSM overlaps the municipal inventory
# by construction; the overlap is resolved by ../tree_dedup.preql. The `where`
# is the city's territory (tools/sync_osm_territory.py keeps it so): a
# staged extract keeps the territory it was cut with until its next firing.
root partial datasource ussom_osm_tree_info extends tree_partition (
    data_source: ussom_source,
    species: ?raw_species,
)
complete where city = 'USSOM' and ussom_source = 'OSM_USSOM'
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/ussom_osm_staging.parquet`
where (raw_latitude >= 42.3725 and raw_latitude < 42.4182 and raw_longitude >= -71.1347 and raw_longitude < -71.0726)
    and geo_contains(ussom_boundary, geo_point(raw_longitude, raw_latitude));


# --- Cross-source dedup and attribute merge --------------------------------
#
# Shared: ../tree_dedup.preql groups the partitions into one cluster per
# tree and picks each canonical attribute across the cluster; this city's grid
# cell size and its calibration live in DEDUP_CELL_METRES in shared/ingest.py.
# A missing dbh is imputed from the city-and-species average, as it was while
# these rows were Boston's (see ../usbos/boston_tree_info.preql for why the
# imputation runs on each raw row before the merge and not after it).
auto imputed_dbh <- coalesce(cleaned_dbh, avg(cleaned_dbh) by city, raw_species);
auto processed_dbh <- @corrected_dbh(imputed_dbh);
merge processed_dbh into diameter_at_breast_height;
merge merged_latitude into latitude;
merge merged_longitude into longitude;


# The published target extends ../tree_dedup.preql's `published_tree_info`:
# the canonical columns, the prune, and the guard that refuses a build which
# lost a quarter of the city.  The two `@source_kept` lines are the same guard
# per bulk source (`test_every_city_refuses_a_collapsed_build`).
partial datasource somerville_tree_info extends published_tree_info (
    data_source: ussom_source,
    ?species,
    ussom_published_data_updated_through,
)
complete where city = 'USSOM'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/ussom_tree_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/ussom_tree_info_v{data_version}.parquet`
freshness by ussom_published_data_updated_through
assert @source_kept(tree_id, ussom_source, 'SOMERVILLE', 0.75)
assert @source_kept(tree_id, ussom_source, 'OSM_USSOM', 0.75);
