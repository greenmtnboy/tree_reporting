import ..landmark_common;

root partial datasource boston_landmarks_update_time (
    city: ~city,
    data_updated_through: bos_landmark_data_updated_through
)
grain (city)
complete where city = 'USBOS'
file `./boston_landmarks_probe.py`
freshness by bos_landmark_data_updated_through;


root partial datasource raw_boston_landmark_info (
    Unique_ID: landmark_id,
    city: city,
    Common_Name: name,
    Neighborhood: ?neighborhood,
    Date_Designated_1: ?designation_date,
    shape_wkt: ?geometry_raw,
)
grain (landmark_id)
complete where city = 'USBOS'
file `./boston_landmarks.py`;


partial datasource boston_landmark_info (
    landmark_id,
    city,
    name,
    ?neighborhood,
    ?designation_date,
    ?geometry_raw,
    bos_landmark_data_updated_through,
)
grain (landmark_id)
complete where city = 'USBOS'
file `https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/boston_landmark_info.parquet`:`gcs://trilogy_public_models/duckdb/landmarks/boston_landmark_info.parquet`
freshness by bos_landmark_data_updated_through;
