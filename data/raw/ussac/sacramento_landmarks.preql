import ..landmark_common;

root datasource sacramento_landmarks_update_time (
    data_updated_through: ussac_landmark_data_updated_through
)
file `./sacramento_landmarks_probe.py`;

# The Sacramento Register of Historic and Cultural Resources (the city's own
# designation register, on the same ArcGIS Online organisation as the trees)
# and the National Park Service's National Register listings in Sacramento --
# registers read live, so no Nominatim geocoding, no committed CSV and no
# staging object.  `lm_type` names the register and `register_number` the
# designating ordinance (`82-046`) or the NRIS reference number.
root partial datasource raw_sacramento_landmark_info extends landmark_partition (
    address: ?address,
    lm_type: ?lm_type,
    register_number: ?register_number,
    year_designated: ?year_designated,
)
complete where city = 'USSAC'
file `./sacramento_landmarks.py`;

partial datasource sacramento_landmark_info extends published_landmark_info (
    ?address,
    ?lm_type,
    ?register_number,
    ?year_designated,
    ussac_landmark_data_updated_through,
)
complete where city = 'USSAC'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/ussac_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/ussac_landmark_info_v{data_version}.parquet`
freshness by ussac_landmark_data_updated_through;
