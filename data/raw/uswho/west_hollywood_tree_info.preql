import ..tree_common;
import ..community_tree_info;
import ..satellite_tree_info;
import ..tree_dedup;

auto uswho_published_data_updated_through <- greatest(uswho_data_updated_through, uswho_community_data_updated_through, uswho_osm_data_updated_through, uswho_satellite_data_updated_through, uswho_predicted_data_updated_through);

key uswho_source enum<string>['WEST_HOLLYWOOD', 'COMMUNITY_USWHO', 'OSM_USWHO', 'SATELLITE_USWHO', 'PREDICTED_USWHO']; # originating dataset for the row

# Feed the shared cross-source merge (../tree_dedup.preql): it classifies rows
# by the label's prefix and records provenance from it.
auto uswho_source_label <- concat(uswho_source, '');
merge uswho_source_label into source_label;

root datasource west_hollywood_update_time (
    data_updated_through: uswho_data_updated_through
)
file `./west_hollywood_update_time.py`;

# Only this city's column, so an approval elsewhere does not mark USWHO's
# Parquet stale. Trilogy probes this as MAX over the one column.
root datasource uswho_community_update_time (
    uswho_community_data_updated_through: uswho_community_data_updated_through
)
file `../community_update_time.py`;

# Likewise for reviewed aerial-imagery detections: one column, this city's.
root datasource uswho_satellite_update_time (
    uswho_satellite_data_updated_through: uswho_satellite_data_updated_through
)
file `../satellite_update_time.py`;

# Bulk imagery predictions: the publication time of the staged file this city
# reads, which is the Los Angeles run's (PREDICTED_STAGED_WITH).
root datasource uswho_predicted_update_time (
    uswho_predicted_data_updated_through: uswho_predicted_data_updated_through
)
file `../predicted_update_time.py`;

# GCS publication time of the staged OSM parquet; it only moves when an
# extraction is re-run and uploaded. Not a local mtime -- git does not preserve
# it, so a committed staging file makes every fresh clone look like new data.
root datasource uswho_osm_update_time (
    data_updated_through: uswho_osm_data_updated_through
)
file `./west_hollywood_osm_probe.py`;

# Every partition extends ../tree_dedup.preql's `tree_partition`, which maps
# the shared raw_* columns; a source that names a column differently re-binds
# it here (`dbh: ?raw_dbh`).
root partial datasource west_hollywood_raw_tree_info extends tree_partition (
    data_source: uswho_source,
)
complete where city = 'USWHO' and uswho_source = 'WEST_HOLLYWOOD'
file `./west_hollywood_tree_info.py`;


# Approved community submissions for this city. The shared ingest script emits
# every city's rows; the `complete where` clause narrows it to USWHO and makes
# it a disjoint partition, and the `where` clause is what actually filters --
# `complete where` asserts, it does not promise a predicate.
root partial datasource uswho_community_tree_info extends tree_partition (
    data_source: uswho_source,
)
complete where city = 'USWHO' and uswho_source = 'COMMUNITY_USWHO'
file `../community_tree_info.py`
where city = 'USWHO';


# Reviewed aerial-imagery detections (reviewer/satellite.ts), read from the
# public export the reviewer publishes -- see ../satellite_tree_info.py.  A
# detection recorded under Los Angeles that stands in West Hollywood is
# re-homed here (`territory_city`).
root partial datasource uswho_satellite_tree_info extends tree_partition (
    data_source: uswho_source,
    species: ?raw_species,
)
complete where city = 'USWHO' and uswho_source = 'SATELLITE_USWHO'
file `../satellite_tree_info.py`
where city = 'USWHO';


# Bulk aerial-imagery predictions, published without per-tree review (see
# ../predicted_tree_info.py): the rows of the Los Angeles run that fall inside
# West Hollywood.  The weakest class in the shared merge.  No `source_kept`
# guard: a new run at a stricter threshold may rightly shed a quarter of them.
root partial datasource uswho_predicted_tree_info extends tree_partition (
    data_source: uswho_source,
    species: ?raw_species,
)
complete where city = 'USWHO' and uswho_source = 'PREDICTED_USWHO'
file `../predicted_tree_info.py`
where city = 'USWHO';


# OpenStreetMap trees, read from the staged parquet in GCS rather than Overpass
# -- extraction is decoupled from refresh. OSM overlaps the municipal inventory
# by construction; the overlap is resolved by ../tree_dedup.preql. The `where`
# is the city's CITY_TERRITORY (tools/sync_osm_territory.py keeps it so): a
# staged extract keeps the territory it was cut with until its next firing.
root partial datasource uswho_osm_tree_info extends tree_partition (
    data_source: uswho_source,
)
complete where city = 'USWHO' and uswho_source = 'OSM_USWHO'
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/uswho_osm_staging.parquet`
where (raw_latitude >= 34.0763 and raw_latitude < 34.098 and raw_longitude >= -118.3959 and raw_longitude < -118.3433);


# --- Cross-source dedup and attribute merge --------------------------------
#
# Shared: ../tree_dedup.preql groups the partitions into one cluster per
# tree and picks each canonical attribute across the cluster; this city's grid
# cell size and its calibration live in DEDUP_CELL_METRES in shared/ingest.py.
# The per-city lines are the dbh merge, because Boston imputes it, and the
# position policy: a city with an Overture lookup imports ../tree_position.preql
# instead of the two position merges (see that file).
merge merged_dbh into diameter_at_breast_height;
merge merged_latitude into latitude;
merge merged_longitude into longitude;


# The published target extends ../tree_dedup.preql's `published_tree_info`:
# the canonical columns, the prune, and the guard that refuses a build which
# lost a quarter of the city.  The two `@source_kept` lines are the same guard
# per bulk source; add one for every municipal or OSM label in the enum
# (`test_every_city_refuses_a_collapsed_build`).
partial datasource west_hollywood_tree_info extends published_tree_info (
    data_source: uswho_source,
    uswho_published_data_updated_through,
)
complete where city = 'USWHO'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/uswho_tree_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/uswho_tree_info_v{data_version}.parquet`
freshness by uswho_published_data_updated_through
assert @source_kept(tree_id, uswho_source, 'WEST_HOLLYWOOD', 0.75)
assert @source_kept(tree_id, uswho_source, 'OSM_USWHO', 0.75);
