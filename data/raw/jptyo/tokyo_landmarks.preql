import ..landmark_common;

root datasource tokyo_landmarks_update_time (
    data_updated_through: jptyo_landmark_data_updated_through
)
file `./tokyo_landmarks_probe.py`;

# STUB. Every city needs a landmarks model even if it yields zero rows -- a
# missing file fails the landmark lane for every city, and the agent has no
# geographic context for this one.
#
# Point the raw datasource at whichever source this city has, in preference
# order: an official designation registry, the same portal as the trees, an
# Overpass extract (STAGE it -- do not fetch at refresh time), or a curated CSV
# geocoded via Nominatim (then add a `landmarks-jptyo` job with NO cron).
root partial datasource raw_tokyo_landmark_info extends landmark_partition (
)
complete where city = 'JPTYO'
file `./tokyo_landmarks.py`;

partial datasource tokyo_landmark_info extends published_landmark_info (
    jptyo_landmark_data_updated_through,
)
complete where city = 'JPTYO'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/jptyo_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/jptyo_landmark_info_v{data_version}.parquet`
freshness by jptyo_landmark_data_updated_through;
