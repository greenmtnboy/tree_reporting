import ..landmark_common;

root datasource aurora_il_landmarks_update_time (
    data_updated_through: usaur_landmark_data_updated_through
)
file `./aurora_il_landmarks_probe.py`;

# Aurora, IL's National Register listings (the National Park Service's
# nrhp_locations MapServer cut to the city), read live -- no Nominatim
# geocoding, no committed CSV and no staging object.  A register of the
# city's own is a follow-up.  `lm_type` names the register and
# `register_number` the NRIS reference number.
root partial datasource raw_aurora_il_landmark_info extends landmark_partition (
    address: ?address,
    lm_type: ?lm_type,
    register_number: ?register_number,
    year_designated: ?year_designated,
)
complete where city = 'USAUR'
file `./aurora_il_landmarks.py`;

partial datasource aurora_il_landmark_info extends published_landmark_info (
    ?address,
    ?lm_type,
    ?register_number,
    ?year_designated,
    usaur_landmark_data_updated_through,
)
complete where city = 'USAUR'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/usaur_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/usaur_landmark_info_v{data_version}.parquet`
freshness by usaur_landmark_data_updated_through;
