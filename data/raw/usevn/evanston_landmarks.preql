import ..landmark_common;

root datasource evanston_landmarks_update_time (
    data_updated_through: usevn_landmark_data_updated_through
)
file `./evanston_landmarks_probe.py`;

# Evanston's National Register listings (the National Park Service's
# nrhp_locations MapServer cut to the city), read live -- no Nominatim
# geocoding, no committed CSV and no staging object.  The City's own landmark
# register is not openly published.  `lm_type` names the register and
# `register_number` the NRIS reference number.
root partial datasource raw_evanston_landmark_info extends landmark_partition (
    address: ?address,
    lm_type: ?lm_type,
    register_number: ?register_number,
    year_designated: ?year_designated,
)
complete where city = 'USEVN'
file `./evanston_landmarks.py`;

partial datasource evanston_landmark_info extends published_landmark_info (
    ?address,
    ?lm_type,
    ?register_number,
    ?year_designated,
    usevn_landmark_data_updated_through,
)
complete where city = 'USEVN'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/usevn_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/usevn_landmark_info_v{data_version}.parquet`
freshness by usevn_landmark_data_updated_through;
