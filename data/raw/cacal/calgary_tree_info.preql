import ..tree_common;
import ..community_tree_info;
import ..tree_dedup;

auto cacal_published_data_updated_through <- greatest(cacal_data_updated_through, cacal_community_data_updated_through, cacal_osm_data_updated_through);

key cacal_source enum<string>['CALGARY_OPENDATA', 'COMMUNITY_CACAL', 'OSM_CACAL']; # originating dataset for the row

# Feed the shared cross-source merge (../tree_dedup.preql): it classifies rows
# by the label's prefix and records provenance from it.
auto cacal_source_label <- concat(cacal_source, '');
merge cacal_source_label into source_label;

root datasource calgary_update_time (
    data_updated_through: cacal_data_updated_through
)
file `./calgary_update_time.py`;

# Only this city's column, so an approval elsewhere does not mark CACAL's
# Parquet stale. Trilogy probes this as MAX over the one column.
root datasource cacal_community_update_time (
    cacal_community_data_updated_through: cacal_community_data_updated_through
)
file `../community_update_time.py`;

# GCS publication time of the staged OSM parquet; it only moves when an
# extraction is re-run and uploaded. Not a local mtime -- git does not preserve
# it, so a committed staging file makes every fresh clone look like new data.
root datasource cacal_osm_update_time (
    data_updated_through: cacal_osm_data_updated_through
)
file `./calgary_osm_probe.py`;

root partial datasource calgary_raw_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: cacal_source,
    species: raw_species,
    tree_name: ?raw_tree_name,
    plant_date: ?raw_plant_date,
    latitude: ?raw_latitude,
    longitude: ?raw_longitude,
    diameter_at_breast_height: ?raw_dbh,
    submission_photo_url: ?raw_photo_url,
    cultivar: ?raw_cultivar,
)
grain (tree_id)
complete where city = 'CACAL' and cacal_source = 'CALGARY_OPENDATA'
file `./calgary_tree_info.py`;


# Approved community submissions for this city. The shared ingest script emits
# every city's rows; the `complete where` clause narrows it to CACAL and makes
# it a disjoint partition, and the `where` clause is what actually filters --
# `complete where` asserts, it does not promise a predicate.
root partial datasource cacal_community_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: cacal_source,
    species: raw_species,
    tree_name: ?raw_tree_name,
    plant_date: ?raw_plant_date,
    diameter_at_breast_height: ?raw_dbh,
    latitude: ?raw_latitude,
    longitude: ?raw_longitude,
    submission_photo_url: ?raw_photo_url,
    cultivar: ?raw_cultivar,
)
grain (tree_id)
complete where city = 'CACAL' and cacal_source = 'COMMUNITY_CACAL'
file `../community_tree_info.py`
where city = 'CACAL';


# OpenStreetMap trees, read from the staged parquet in GCS rather than Overpass
# -- extraction is decoupled from refresh. OSM overlaps the municipal inventory
# by construction; the overlap is resolved by ../tree_dedup.preql.
root partial datasource cacal_osm_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: cacal_source,
    species: raw_species,
    tree_name: ?raw_tree_name,
    plant_date: ?raw_plant_date,
    latitude: ?raw_latitude,
    longitude: ?raw_longitude,
    diameter_at_breast_height: ?raw_dbh,
    submission_photo_url: ?raw_photo_url,
    cultivar: ?raw_cultivar,
)
grain (tree_id)
complete where city = 'CACAL' and cacal_source = 'OSM_CACAL'
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/cacal_osm_staging.parquet`;


# --- Cross-source dedup and attribute merge --------------------------------
#
# Shared: ../tree_dedup.preql groups the three partitions into one cluster per
# tree and picks each canonical attribute across the cluster; this city's grid
# cell size and its calibration live in DEDUP_CELL_METRES in _ingest_shared.py.
# The only per-city line is the dbh merge, because Boston imputes it.
merge merged_dbh into diameter_at_breast_height;


partial datasource calgary_tree_info (
    tree_id,
    city,
    data_source: cacal_source,
    species,
    ?tree_name,
    ?plant_date,
    ?diameter_at_breast_height,
    ?latitude,
    ?longitude,
    ?submission_photo_url,
    ?cultivar,
    cluster_id,
    merged_sources,
    ?merged_tree_ids,
    cacal_published_data_updated_through,
)
grain (tree_id)
complete where city = 'CACAL'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/cacal_tree_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/cacal_tree_info_v{data_version}.parquet`
where tree_id = cluster_id
freshness by cacal_published_data_updated_through;
