import ..landmark_common;

root datasource boise_landmarks_update_time (
    data_updated_through: usboi_landmark_data_updated_through
)
file `./boise_landmarks_probe.py`;

# The City of Boise's Historic Landmarks layer (its local landmarks and the
# National Register sites in its Area of Impact, one register on the City's
# ArcGIS Online organisation), topped up with the National Park Service's
# National Register listings in Boise the city layer does not carry --
# registers read live, so no Nominatim geocoding, no committed CSV and no
# staging object.  `lm_type` names the register(s) and `register_number` the
# NRIS reference number.
root partial datasource raw_boise_landmark_info extends landmark_partition (
    address: ?address,
    lm_type: ?lm_type,
    register_number: ?register_number,
    year_designated: ?year_designated,
)
complete where city = 'USBOI'
file `./boise_landmarks.py`;

partial datasource boise_landmark_info extends published_landmark_info (
    ?address,
    ?lm_type,
    ?register_number,
    ?year_designated,
    usboi_landmark_data_updated_through,
)
complete where city = 'USBOI'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/usboi_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/usboi_landmark_info_v{data_version}.parquet`
freshness by usboi_landmark_data_updated_through;
