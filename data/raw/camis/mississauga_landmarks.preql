import ..landmark_common;

root datasource mississauga_landmarks_update_time (
    data_updated_through: camis_landmark_data_updated_through
)
file `./mississauga_landmarks_probe.py`;

# Mississauga's city landmark register (`CITY_POI`), filtered to the types
# that name a place -- see the ingest for why the heritage parcel layer, which
# carries no name, is not used.
root partial datasource raw_mississauga_landmark_info (
    landmark_id: landmark_id,
    city: city,
    name: name,
    geometry_raw: ?geometry_raw,
    address: ?address,
    property_type: ?property_type,
)
grain (landmark_id)
complete where city = 'CAMIS'
file `./mississauga_landmarks.py`;

partial datasource mississauga_landmark_info (
    landmark_id,
    city,
    name,
    ?geometry,
    ?latitude,
    ?longitude,
    ?address,
    ?property_type,
    camis_landmark_data_updated_through,
)
grain (landmark_id)
complete where city = 'CAMIS'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/camis_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/camis_landmark_info_v{data_version}.parquet`
freshness by camis_landmark_data_updated_through;
