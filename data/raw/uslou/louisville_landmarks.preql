import ..landmark_common;

root datasource louisville_landmarks_update_time (
    data_updated_through: uslou_landmark_data_updated_through
)
file `./louisville_landmarks_probe.py`;

# Louisville Metro's Individual Landmarks (the Metro Landmarks Commission's
# designations, from LOJIC's preservation layer on Louisville Metro Open Data)
# and the National Park Service's National Register listings in Jefferson
# County (the consolidated city-county) -- registers read live, so no
# Nominatim geocoding, no committed CSV and no staging object. `lm_type` names
# the register (or both) and `register_number` the Kentucky Heritage Council
# survey id and/or the NRIS reference number.
root partial datasource raw_louisville_landmark_info extends landmark_partition (
    address: ?address,
    lm_type: ?lm_type,
    register_number: ?register_number,
    year_designated: ?year_designated,
)
complete where city = 'USLOU'
file `./louisville_landmarks.py`;

partial datasource louisville_landmark_info extends published_landmark_info (
    ?address,
    ?lm_type,
    ?register_number,
    ?year_designated,
    uslou_landmark_data_updated_through,
)
complete where city = 'USLOU'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/uslou_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/uslou_landmark_info_v{data_version}.parquet`
freshness by uslou_landmark_data_updated_through;
