import ..landmark_common;

root datasource basingstoke_landmarks_update_time (
    data_updated_through: gbbsk_landmark_data_updated_through
)
file `./basingstoke_landmarks_probe.py`;

# Historic England's National Heritage List for England -- listed buildings,
# scheduled monuments and registered parks and gardens -- cut to the ONS
# district boundary of Basingstoke and Deane (E07000084), read live, so no
# Nominatim geocoding, no committed CSV and no staging object. `lm_type` names
# the designation and its grade, `register_number` the NHLE list-entry number,
# `year_designated` the year first listed, scheduled or registered.
root partial datasource raw_basingstoke_landmark_info extends landmark_partition (
    lm_type: ?lm_type,
    register_number: ?register_number,
    year_designated: ?year_designated,
)
complete where city = 'GBBSK'
file `./basingstoke_landmarks.py`;

partial datasource basingstoke_landmark_info extends published_landmark_info (
    ?lm_type,
    ?register_number,
    ?year_designated,
    gbbsk_landmark_data_updated_through,
)
complete where city = 'GBBSK'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/gbbsk_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/gbbsk_landmark_info_v{data_version}.parquet`
freshness by gbbsk_landmark_data_updated_through;
