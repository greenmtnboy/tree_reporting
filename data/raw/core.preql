import ecoregion_common;

key city enum<string>['USSFO', 'USNYC', 'USBOS', 'FRPAR', 'USBTV', 'CAVAN', 'DEBER', 'NLAMS', 'GBLON', 'AUMEL', 'ARBUE', 'USLAX', 'USWAS', 'USTEM', 'GRATH', 'GRMLO', 'GRSAN']; # UN/LOCODE-style code for the source city

# The dataset each tree row came from is modelled as a *per-city* enum key
# (`ussfo_source`, `usbos_source`, …) declared in each city's tree model, not as
# one global key here. Trilogy proves a city's Parquet is complete by checking
# that its raw sources cover every value of the partitioning enum, so a global
# 30-value enum is never covered by any single city's two sources and the whole
# model fails to resolve — verified, as does a plain `key data_source string`.
# Each city aliases its key to the physical column `data_source`, so every tree
# Parquet still exposes one uniformly named column. The full value list lives in
# DATA_SOURCES in data/raw/_ingest_shared.py; data/raw/tests/test_data_sources.py
# asserts the two stay in sync.
property city.ecoregion_id <- case
    when city = 'USSFO' then 423
    when city = 'USNYC' then 339
    when city = 'USBOS' then 339
    when city = 'FRPAR' then 664
    when city = 'USBTV' then 334
    when city = 'CAVAN' then 319
    when city = 'DEBER' then 651
    when city = 'NLAMS' then 664
    when city = 'GBLON' then 663
    when city = 'AUMEL' then 808
    when city = 'ARBUE' then 576
    when city = 'USLAX' then 422
    when city = 'USWAS' then 399
    when city = 'USTEM' then 435
    when city = 'GRATH' then 785
    when city = 'GRMLO' then 785
    when city = 'GRSAN' then 785
end; # mapped from RESOLVE ecoregion at each city centroid

# The data_source / submission_photo_url additions did not need a bump: the
# deployed app selects a strict subset of the new columns, so an old app reading
# a rebuilt parquet is fine, and rolling the app back stays fine. Boston drops
# `usbos_source` in favour of `data_source`, but nothing outside the preql models
# ever read that column. A bump would also have forced the LLM-backed enrichment
# parquet and every landmark parquet to re-materialize for no reason, since they
# all share this one param.
#
# The ordering that does matter: refresh the parquets before deploying the app.
# The new worker selects data_source / submission_photo_url by name, so it fails
# to load against a not-yet-rebuilt parquet.
param data_version string default '2';
