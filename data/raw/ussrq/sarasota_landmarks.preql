import ..landmark_common;

root datasource sarasota_landmarks_update_time (
    data_updated_through: ussrq_landmark_data_updated_through
)
file `./sarasota_landmarks_probe.py`;

# The National Park Service's National Register listings in Sarasota County
# (cut by the register's own County field), read live, so no Nominatim
# geocoding, no committed CSV and no staging object.  No local register is
# published openly.  `lm_type` names the register and `register_number` the
# NRIS reference number.
root partial datasource raw_sarasota_landmark_info extends landmark_partition (
    address: ?address,
    lm_type: ?lm_type,
    register_number: ?register_number,
    year_designated: ?year_designated,
)
complete where city = 'USSRQ'
file `./sarasota_landmarks.py`;

partial datasource sarasota_landmark_info extends published_landmark_info (
    ?address,
    ?lm_type,
    ?register_number,
    ?year_designated,
    ussrq_landmark_data_updated_through,
)
complete where city = 'USSRQ'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/ussrq_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/ussrq_landmark_info_v{data_version}.parquet`
freshness by ussrq_landmark_data_updated_through;
