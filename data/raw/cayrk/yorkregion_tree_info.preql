import ..tree_common;
import ..community_tree_info;
import ..tree_dedup;

auto cayrk_published_data_updated_through <- greatest(cayrk_data_updated_through, cayrk_community_data_updated_through, cayrk_osm_data_updated_through);

key cayrk_source enum<string>['YORK_REGION_OPENDATA', 'COMMUNITY_CAYRK', 'OSM_CAYRK']; # originating dataset for the row

# Feed the shared cross-source merge (../tree_dedup.preql): it classifies rows
# by the label's prefix and records provenance from it.
auto cayrk_source_label <- concat(cayrk_source, '');
merge cayrk_source_label into source_label;

root datasource yorkregion_update_time (
    data_updated_through: cayrk_data_updated_through
)
file `./yorkregion_update_time.py`;

# Only this city's column, so an approval elsewhere does not mark CAYRK's
# Parquet stale. Trilogy probes this as MAX over the one column.
root datasource cayrk_community_update_time (
    cayrk_community_data_updated_through: cayrk_community_data_updated_through
)
file `../community_update_time.py`;

# GCS publication time of the staged OSM parquet; it only moves when an
# extraction is re-run and uploaded. Not a local mtime -- git does not preserve
# it, so a committed staging file makes every fresh clone look like new data.
root datasource cayrk_osm_update_time (
    data_updated_through: cayrk_osm_data_updated_through
)
file `./yorkregion_osm_probe.py`;

# Every partition extends ../tree_dedup.preql's `tree_partition`, which maps
# the shared raw_* columns; a source that names a column differently re-binds
# it here (`dbh: ?raw_dbh`).
root partial datasource yorkregion_raw_tree_info extends tree_partition (
    data_source: cayrk_source,
)
complete where city = 'CAYRK' and cayrk_source = 'YORK_REGION_OPENDATA'
file `./yorkregion_tree_info.py`;


# Approved community submissions for this city. The shared ingest script emits
# every city's rows; the `complete where` clause narrows it to CAYRK and makes
# it a disjoint partition, and the `where` clause is what actually filters --
# `complete where` asserts, it does not promise a predicate.
root partial datasource cayrk_community_tree_info extends tree_partition (
    data_source: cayrk_source,
)
complete where city = 'CAYRK' and cayrk_source = 'COMMUNITY_CAYRK'
file `../community_tree_info.py`
where city = 'CAYRK';


# OpenStreetMap trees, read from the staged parquet in GCS rather than Overpass
# -- extraction is decoupled from refresh. OSM overlaps the municipal inventory
# by construction; the overlap is resolved by ../tree_dedup.preql. The `where`
# is the city's CITY_TERRITORY (tools/sync_osm_territory.py keeps it so): a
# staged extract keeps the territory it was cut with until its next firing.
root partial datasource cayrk_osm_tree_info extends tree_partition (
    data_source: cayrk_source,
)
complete where city = 'CAYRK' and cayrk_source = 'OSM_CAYRK'
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/cayrk_osm_staging.parquet`
where (raw_latitude >= 43.873 and raw_latitude < 44.005 and raw_longitude >= -79.73 and raw_longitude < -79.71)
    or (raw_latitude >= 43.839 and raw_latitude < 44.009 and raw_longitude >= -79.71 and raw_longitude < -79.69)
    or (raw_latitude >= 43.804 and raw_latitude < 44.013 and raw_longitude >= -79.69 and raw_longitude < -79.67)
    or (raw_latitude >= 43.78 and raw_latitude < 44.021 and raw_longitude >= -79.67 and raw_longitude < -79.65)
    or (raw_latitude >= 43.78 and raw_latitude < 44.026 and raw_longitude >= -79.65 and raw_longitude < -79.64)
    or (raw_latitude >= 43.75 and raw_latitude < 44.026 and raw_longitude >= -79.64 and raw_longitude < -79.63)
    or (raw_latitude >= 43.752 and raw_latitude < 44.049 and raw_longitude >= -79.63 and raw_longitude < -79.61)
    or (raw_latitude >= 43.756 and raw_latitude < 44.054 and raw_longitude >= -79.61 and raw_longitude < -79.59)
    or (raw_latitude >= 43.761 and raw_latitude < 44.068 and raw_longitude >= -79.59 and raw_longitude < -79.57)
    or (raw_latitude >= 43.765 and raw_latitude < 44.099 and raw_longitude >= -79.57 and raw_longitude < -79.55)
    or (raw_latitude >= 43.77 and raw_latitude < 44.152 and raw_longitude >= -79.55 and raw_longitude < -79.53)
    or (raw_latitude >= 43.774 and raw_latitude < 44.277 and raw_longitude >= -79.53 and raw_longitude < -79.51)
    or (raw_latitude >= 43.778 and raw_latitude < 44.34 and raw_longitude >= -79.51 and raw_longitude < -79.49)
    or (raw_latitude >= 43.783 and raw_latitude < 44.34 and raw_longitude >= -79.49 and raw_longitude < -79.47)
    or (raw_latitude >= 43.787 and raw_latitude < 44.34 and raw_longitude >= -79.47 and raw_longitude < -79.45)
    or (raw_latitude >= 43.792 and raw_latitude < 44.34 and raw_longitude >= -79.45 and raw_longitude < -79.43)
    or (raw_latitude >= 43.796 and raw_latitude < 44.34 and raw_longitude >= -79.43 and raw_longitude < -79.41)
    or (raw_latitude >= 43.8 and raw_latitude < 44.34 and raw_longitude >= -79.41 and raw_longitude < -79.39)
    or (raw_latitude >= 43.805 and raw_latitude < 44.34 and raw_longitude >= -79.39 and raw_longitude < -79.37)
    or (raw_latitude >= 43.809 and raw_latitude < 44.34 and raw_longitude >= -79.37 and raw_longitude < -79.35)
    or (raw_latitude >= 43.814 and raw_latitude < 44.34 and raw_longitude >= -79.35 and raw_longitude < -79.33)
    or (raw_latitude >= 43.818 and raw_latitude < 44.34 and raw_longitude >= -79.33 and raw_longitude < -79.31)
    or (raw_latitude >= 43.823 and raw_latitude < 44.34 and raw_longitude >= -79.31 and raw_longitude < -79.29)
    or (raw_latitude >= 43.828 and raw_latitude < 44.34 and raw_longitude >= -79.29 and raw_longitude < -79.27)
    or (raw_latitude >= 43.832 and raw_latitude < 44.34 and raw_longitude >= -79.27 and raw_longitude < -79.25)
    or (raw_latitude >= 43.837 and raw_latitude < 44.34 and raw_longitude >= -79.25 and raw_longitude < -79.23)
    or (raw_latitude >= 43.842 and raw_latitude < 44.34 and raw_longitude >= -79.23 and raw_longitude < -79.21)
    or (raw_latitude >= 43.846 and raw_latitude < 44.34 and raw_longitude >= -79.21 and raw_longitude < -79.19)
    or (raw_latitude >= 43.851 and raw_latitude < 44.34 and raw_longitude >= -79.19 and raw_longitude < -79.17)
    or (raw_latitude >= 44.26 and raw_latitude < 44.295 and raw_longitude >= -79.17 and raw_longitude < -79.15);


# --- Cross-source dedup and attribute merge --------------------------------
#
# Shared: ../tree_dedup.preql groups the three partitions into one cluster per
# tree and picks each canonical attribute across the cluster; this city's grid
# cell size and its calibration live in DEDUP_CELL_METRES in shared/ingest.py.
# The per-city lines are the dbh merge, because Boston imputes it, and the
# position policy: a city with an Overture lookup imports ../tree_position.preql
# instead of the two position merges (see that file).
merge merged_dbh into diameter_at_breast_height;
merge merged_latitude into latitude;
merge merged_longitude into longitude;


# The published target extends ../tree_dedup.preql's `published_tree_info`:
# the canonical columns, the prune, and the guard that refuses a build which
# lost a quarter of the city.  The two `@source_kept` lines are the same guard
# per bulk source; add one for every municipal or OSM label in the enum
# (`test_every_city_refuses_a_collapsed_build`).
partial datasource yorkregion_tree_info extends published_tree_info (
    data_source: cayrk_source,
    cayrk_published_data_updated_through,
)
complete where city = 'CAYRK'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/cayrk_tree_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/cayrk_tree_info_v{data_version}.parquet`
freshness by cayrk_published_data_updated_through
assert @source_kept(tree_id, cayrk_source, 'YORK_REGION_OPENDATA', 0.75)
assert @source_kept(tree_id, cayrk_source, 'OSM_CAYRK', 0.75);
