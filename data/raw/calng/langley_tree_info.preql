import ..tree_common;
import ..community_tree_info;
import ..tree_dedup;

auto calng_published_data_updated_through <- greatest(calng_data_updated_through, calng_community_data_updated_through, calng_osm_data_updated_through);

key calng_source enum<string>['LANGLEY_OPENDATA', 'COMMUNITY_CALNG', 'OSM_CALNG']; # originating dataset for the row

# Feed the shared cross-source merge (../tree_dedup.preql): it classifies rows
# by the label's prefix and records provenance from it.
auto calng_source_label <- concat(calng_source, '');
merge calng_source_label into source_label;

root datasource langley_update_time (
    data_updated_through: calng_data_updated_through
)
file `./langley_update_time.py`;

# Only this city's column, so an approval elsewhere does not mark CALNG's
# Parquet stale. Trilogy probes this as MAX over the one column.
root datasource calng_community_update_time (
    calng_community_data_updated_through: calng_community_data_updated_through
)
file `../community_update_time.py`;

# GCS publication time of the staged OSM parquet; it only moves when an
# extraction is re-run and uploaded. Not a local mtime -- git does not preserve
# it, so a committed staging file makes every fresh clone look like new data.
root datasource calng_osm_update_time (
    data_updated_through: calng_osm_data_updated_through
)
file `./langley_osm_probe.py`;

# Every partition extends ../tree_dedup.preql's `tree_partition`, which maps
# the shared raw_* columns; a source that names a column differently re-binds
# it here (`dbh: ?raw_dbh`).
root partial datasource langley_raw_tree_info extends tree_partition (
    data_source: calng_source,
)
complete where city = 'CALNG' and calng_source = 'LANGLEY_OPENDATA'
file `./langley_tree_info.py`;


# Approved community submissions for this city. The shared ingest script emits
# every city's rows; the `complete where` clause narrows it to CALNG and makes
# it a disjoint partition, and the `where` clause is what actually filters --
# `complete where` asserts, it does not promise a predicate.
root partial datasource calng_community_tree_info extends tree_partition (
    data_source: calng_source,
)
complete where city = 'CALNG' and calng_source = 'COMMUNITY_CALNG'
file `../community_tree_info.py`
where city = 'CALNG';


# OpenStreetMap trees, read from the staged parquet in GCS rather than Overpass
# -- extraction is decoupled from refresh. OSM overlaps the municipal inventory
# by construction; the overlap is resolved by ../tree_dedup.preql. The `where`
# is the city's CITY_TERRITORY (tools/sync_osm_territory.py keeps it so): a
# staged extract keeps the territory it was cut with until its next firing.
root partial datasource calng_osm_tree_info extends tree_partition (
    data_source: calng_source,
)
complete where city = 'CALNG' and calng_source = 'OSM_CALNG'
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/calng_osm_staging.parquet`
where (raw_latitude >= 49.0 and raw_latitude < 49.01 and raw_longitude >= -122.6801 and raw_longitude < -122.64)
    or (raw_latitude >= 49.01 and raw_latitude < 49.1 and raw_longitude >= -122.681 and raw_longitude < -122.64)
    or (raw_latitude >= 49.1 and raw_latitude < 49.128 and raw_longitude >= -122.68 and raw_longitude < -122.64)
    or (raw_latitude >= 49.128 and raw_latitude < 49.13 and raw_longitude >= -122.6797 and raw_longitude < -122.64)
    or (raw_latitude >= 49.13 and raw_latitude < 49.14 and raw_longitude >= -122.67955 and raw_longitude < -122.64)
    or (raw_latitude >= 49.14 and raw_latitude < 49.17 and raw_longitude >= -122.6793 and raw_longitude < -122.64)
    or (raw_latitude >= 49.17 and raw_latitude < 49.195 and raw_longitude >= -122.68 and raw_longitude < -122.64)
    or (raw_latitude >= 49.0 and raw_latitude < 49.208 and raw_longitude >= -122.64 and raw_longitude < -122.62)
    or (raw_latitude >= 49.0 and raw_latitude < 49.179 and raw_longitude >= -122.62 and raw_longitude < -122.53)
    or (raw_latitude >= 49.0 and raw_latitude < 49.17 and raw_longitude >= -122.53 and raw_longitude < -122.4);


# --- Cross-source dedup and attribute merge --------------------------------
#
# Shared: ../tree_dedup.preql groups the three partitions into one cluster per
# tree and picks each canonical attribute across the cluster; this city's grid
# cell size and its calibration live in DEDUP_CELL_METRES in shared/ingest.py.
# The per-city lines are the dbh merge, because Boston imputes it, and the
# position policy: a city with an Overture lookup imports ../tree_position.preql
# instead of the two position merges (see that file).
merge merged_dbh into diameter_at_breast_height;
merge merged_latitude into latitude;
merge merged_longitude into longitude;


# The published target extends ../tree_dedup.preql's `published_tree_info`:
# the canonical columns, the prune, and the guard that refuses a build which
# lost a quarter of the city.  The two `@source_kept` lines are the same guard
# per bulk source; add one for every municipal or OSM label in the enum
# (`test_every_city_refuses_a_collapsed_build`).
partial datasource langley_tree_info extends published_tree_info (
    data_source: calng_source,
    calng_published_data_updated_through,
)
complete where city = 'CALNG'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/calng_tree_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/calng_tree_info_v{data_version}.parquet`
freshness by calng_published_data_updated_through
assert @source_kept(tree_id, calng_source, 'LANGLEY_OPENDATA', 0.75)
assert @source_kept(tree_id, calng_source, 'OSM_CALNG', 0.75);
