import ..tree_common;
import ..community_tree_info;
import ..tree_dedup;

# Santorini has no municipal tree inventory — the same search that came up
# empty for Milos (opendata.thessaloniki.gr, data.gov.gr, geodata.gov.gr, and
# the Athens portal, whose only tree dataset is the National Garden) comes up
# empty for the Cyclades generally.  The city exists so trees recorded on the
# island can be published: its partitions are approved community submissions
# plus the staged OSM extract (~155 natural=tree nodes across the caldera
# group when wired, counted via the ohsome API), and the published watermark
# combines those two columns, with no municipal term.
#
# It ships with both partitions from the start, so the single-partition
# wrinkle GRMLO hit — a lone partial source is never a union candidate, and
# the published target has to pin the one enum value in its `complete where`
# — does not apply here.  See the historical note in
# grmlo/milos_tree_info.preql and EXTENDING.md if the OSM partition is ever
# removed.
auto grsan_published_data_updated_through <- greatest(grsan_community_data_updated_through, grsan_osm_data_updated_through);

key grsan_source enum<string>['COMMUNITY_GRSAN', 'OSM_GRSAN']; # originating dataset for the row

# Feed the shared cross-source merge (../tree_dedup.preql): it classifies rows
# by the label's prefix and records provenance from it.
auto grsan_source_label <- concat(grsan_source, '');
merge grsan_source_label into source_label;

# Only this city's column, so an approval elsewhere does not mark GRSAN's
# Parquet stale. Trilogy probes this as MAX over the one column.
root datasource grsan_community_update_time (
    grsan_community_data_updated_through: grsan_community_data_updated_through
)
file `../community_update_time.py`;

# GCS publication time of the staged OSM parquet (see santorini_osm_extract.py
# and the scheduled `osm-grsan` cloud job); it only moves when an extraction is
# re-run and published.
root datasource grsan_osm_update_time (
    data_updated_through: grsan_osm_data_updated_through
)
file `./santorini_osm_probe.py`;

# OpenStreetMap trees, read from the staged parquet in GCS rather than
# Overpass -- extraction is decoupled from refresh (see _osm_shared.py and
# EXTENDING.md).  Overlapping rows are resolved by the
# shared cluster merge (../tree_dedup.preql).
root partial datasource grsan_osm_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: grsan_source,
    species: ?raw_species,
    tree_name: ?raw_tree_name,
    plant_date: ?raw_plant_date,
    latitude: ?raw_latitude,
    longitude: ?raw_longitude,
    diameter_at_breast_height: ?raw_dbh,
    submission_photo_url: ?raw_photo_url,
)
grain (tree_id)
complete where city = 'GRSAN' and grsan_source = 'OSM_GRSAN'
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/grsan_osm_staging.parquet`;

# Approved community submissions for this city. The shared ingest script
# emits every city's rows; the `where` clause narrows it to GRSAN and the
# `complete where` makes it a disjoint partition alongside the OSM staging.
root partial datasource grsan_community_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: grsan_source,
    species: raw_species,
    tree_name: ?raw_tree_name,
    plant_date: ?raw_plant_date,
    diameter_at_breast_height: ?raw_dbh,
    latitude: ?raw_latitude,
    longitude: ?raw_longitude,
    submission_photo_url: ?raw_photo_url,
)
grain (tree_id)
complete where city = 'GRSAN' and grsan_source = 'COMMUNITY_GRSAN'
file `../community_tree_info.py`
where city = 'GRSAN';


# --- Cross-source dedup and attribute merge --------------------------------
#
# Shared: ../tree_dedup.preql groups the three partitions into one cluster per
# tree and picks each canonical attribute across the cluster; this city's grid
# cell size and its calibration live in DEDUP_CELL_METRES in _ingest_shared.py.
# The only per-city line is the dbh merge, because Boston imputes it.
merge merged_dbh into diameter_at_breast_height;


# INTENDED END STATE: `where tree_id = cluster_id` on this target, so the
# parquet holds exactly one row per tree and needs no client-side filter; see
# "Intended end state" in ../tree_dedup.preql for what blocks it upstream.
partial datasource santorini_tree_info (
    tree_id,
    city,
    data_source: grsan_source,
    species,
    ?tree_name,
    ?plant_date,
    ?diameter_at_breast_height,
    ?latitude,
    ?longitude,
    ?submission_photo_url,
    merged_sources,
    ?merged_tree_ids,
    grsan_published_data_updated_through,
)
grain (tree_id)
complete where city = 'GRSAN'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/grsan_tree_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/grsan_tree_info_v{data_version}.parquet`
where tree_id = cluster_id
freshness by grsan_published_data_updated_through;
