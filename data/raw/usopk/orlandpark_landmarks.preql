import ..landmark_common;

root datasource orlandpark_landmarks_update_time (
    data_updated_through: usopk_landmark_data_updated_through
)
file `./orlandpark_landmarks_probe.py`;

# Orland Park's historic buildings (the Village's Old Orland Historic District
# contributing-structure layer, on the same ArcGIS organisation as the trees)
# and the National Park Service's National Register listings in Orland Park --
# registers read live, so no Nominatim geocoding, no committed CSV and no
# staging object.  `lm_type` names the register and `register_number` the
# NRIS reference number (the Village's layer publishes none).
root partial datasource raw_orlandpark_landmark_info extends landmark_partition (
    address: ?address,
    lm_type: ?lm_type,
    register_number: ?register_number,
    year_designated: ?year_designated,
)
complete where city = 'USOPK'
file `./orlandpark_landmarks.py`;

partial datasource orlandpark_landmark_info extends published_landmark_info (
    ?address,
    ?lm_type,
    ?register_number,
    ?year_designated,
    usopk_landmark_data_updated_through,
)
complete where city = 'USOPK'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/usopk_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/usopk_landmark_info_v{data_version}.parquet`
freshness by usopk_landmark_data_updated_through;
