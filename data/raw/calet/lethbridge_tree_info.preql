import ..tree_common;
import ..community_tree_info;
import ..tree_dedup;

auto calet_published_data_updated_through <- greatest(calet_data_updated_through, calet_community_data_updated_through, calet_osm_data_updated_through);

key calet_source enum<string>['LETHBRIDGE_OPENDATA', 'COMMUNITY_CALET', 'OSM_CALET']; # originating dataset for the row

# Feed the shared cross-source merge (../tree_dedup.preql): it classifies rows
# by the label's prefix and records provenance from it.
auto calet_source_label <- concat(calet_source, '');
merge calet_source_label into source_label;

root datasource lethbridge_update_time (
    data_updated_through: calet_data_updated_through
)
file `./lethbridge_update_time.py`;

# Only this city's column, so an approval elsewhere does not mark CALET's
# Parquet stale. Trilogy probes this as MAX over the one column.
root datasource calet_community_update_time (
    calet_community_data_updated_through: calet_community_data_updated_through
)
file `../community_update_time.py`;

# GCS publication time of the staged OSM parquet; it only moves when an
# extraction is re-run and uploaded. Not a local mtime -- git does not preserve
# it, so a committed staging file makes every fresh clone look like new data.
root datasource calet_osm_update_time (
    data_updated_through: calet_osm_data_updated_through
)
file `./lethbridge_osm_probe.py`;

root partial datasource lethbridge_raw_tree_info extends tree_partition (
    data_source: calet_source,
)
complete where city = 'CALET' and calet_source = 'LETHBRIDGE_OPENDATA'
file `./lethbridge_tree_info.py`;


# Approved community submissions for this city. The shared ingest script emits
# every city's rows; the `complete where` clause narrows it to CALET and makes
# it a disjoint partition, and the `where` clause is what actually filters --
# `complete where` asserts, it does not promise a predicate.
root partial datasource calet_community_tree_info extends tree_partition (
    data_source: calet_source,
)
complete where city = 'CALET' and calet_source = 'COMMUNITY_CALET'
file `../community_tree_info.py`
where city = 'CALET';


# OpenStreetMap trees, read from the staged parquet in GCS rather than Overpass
# -- extraction is decoupled from refresh. OSM overlaps the municipal inventory
# by construction; the overlap is resolved by ../tree_dedup.preql.
root partial datasource calet_osm_tree_info extends tree_partition (
    data_source: calet_source,
)
complete where city = 'CALET' and calet_source = 'OSM_CALET'
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/calet_osm_staging.parquet`;


# --- Cross-source dedup and attribute merge --------------------------------
#
# Shared: ../tree_dedup.preql groups the three partitions into one cluster per
# tree and picks each canonical attribute across the cluster; this city's grid
# cell size and its calibration live in DEDUP_CELL_METRES in shared/ingest.py.
# The only per-city line is the dbh merge, because Boston imputes it.
merge merged_dbh into diameter_at_breast_height;
# Position: the survivor's own point.  A city with an Overture lookup imports
# ../tree_position.preql instead, which merges the corrected point.
merge merged_latitude into latitude;
merge merged_longitude into longitude;


partial datasource lethbridge_tree_info extends published_tree_info (
    data_source: calet_source,
    calet_published_data_updated_through,
)
complete where city = 'CALET'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/calet_tree_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/calet_tree_info_v{data_version}.parquet`
freshness by calet_published_data_updated_through
assert @source_kept(tree_id, calet_source, 'LETHBRIDGE_OPENDATA', 0.75)
assert @source_kept(tree_id, calet_source, 'OSM_CALET', 0.75);
