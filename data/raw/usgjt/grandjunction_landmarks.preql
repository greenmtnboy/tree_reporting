import ..landmark_common;

root datasource grandjunction_landmarks_update_time (
    data_updated_through: usgjt_landmark_data_updated_through
)
file `./grandjunction_landmarks_probe.py`;

# Grand Junction's historic sites (the City's Historic Sites layer, on the
# same ArcGIS Server as the trees) and the National Park Service's National
# Register listings in Grand Junction -- registers read live, so no Nominatim
# geocoding, no committed CSV and no staging object.  `lm_type` names the
# register and `register_number` the NRIS reference number (the City's layer
# publishes none).
root partial datasource raw_grandjunction_landmark_info extends landmark_partition (
    address: ?address,
    lm_type: ?lm_type,
    register_number: ?register_number,
    year_designated: ?year_designated,
)
complete where city = 'USGJT'
file `./grandjunction_landmarks.py`;

partial datasource grandjunction_landmark_info extends published_landmark_info (
    ?address,
    ?lm_type,
    ?register_number,
    ?year_designated,
    usgjt_landmark_data_updated_through,
)
complete where city = 'USGJT'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/usgjt_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/usgjt_landmark_info_v{data_version}.parquet`
freshness by usgjt_landmark_data_updated_through;
