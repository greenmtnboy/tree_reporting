import ..landmark_common;

root datasource macedon_landmarks_update_time (
    data_updated_through: aumrs_landmark_data_updated_through
)
file `./macedon_landmarks_probe.py`;

# Macedon Ranges Shire's places on the Victorian Heritage Register, read live from
# Vicmap's open-data WFS and cut to the Macedon Ranges Shire with the LGA's
# own boundary (see macedon_landmarks.py) -- an official register, so no
# Nominatim geocoding, no committed CSV and no staging object.  `lm_type`
# names the register and `register_number` carries the VHR number (H1234).
root partial datasource raw_macedon_landmark_info extends landmark_partition (
    lm_type: ?lm_type,
    register_number: ?register_number,
)
complete where city = 'AUMRS'
file `./macedon_landmarks.py`;

partial datasource macedon_landmark_info extends published_landmark_info (
    ?lm_type,
    ?register_number,
    aumrs_landmark_data_updated_through,
)
complete where city = 'AUMRS'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/aumrs_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/aumrs_landmark_info_v{data_version}.parquet`
freshness by aumrs_landmark_data_updated_through;
