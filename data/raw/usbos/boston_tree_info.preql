import ..tree_common;
import ..community_tree_info;
import ..tree_dedup;

property <*>.arboretum_data_updated_through datetime; # when Arnold Arboretum data is through
property <*>.boston_city_data_updated_through datetime; # when Boston city open-data is through
property <*>.cambridge_data_updated_through datetime; # when Cambridge open-data is through
property <*>.brookline_data_updated_through datetime; # when Brookline open-data is through
auto usbos_published_data_updated_through <- greatest(usbos_data_updated_through, usbos_community_data_updated_through, usbos_osm_data_updated_through);
auto usbos_data_updated_through <- greatest(boston_city_data_updated_through, arboretum_data_updated_through, cambridge_data_updated_through, brookline_data_updated_through);
key usbos_source enum<string>['CITY_OF_BOSTON', 'ARNOLD_ARBORETUM', 'CAMBRIDGE', 'BROOKLINE', 'COMMUNITY_USBOS', 'OSM_USBOS']; # originating dataset within the Boston metro; materialized as the uniform `data_source` column

# Feed the shared cross-source merge (../tree_dedup.preql): it classifies rows
# by the label's prefix and records provenance from it.
auto usbos_source_label <- concat(usbos_source, '');
merge usbos_source_label into source_label;




# --- Freshness probes ---


root datasource boston_update_time (
    data_updated_through: boston_city_data_updated_through
)
file `./boston_update_time.py`;

# Only this city's column, so an approval elsewhere does not mark USBOS's
# Parquet stale. Trilogy probes this as MAX over the one column.
root datasource usbos_community_update_time (
    usbos_community_data_updated_through: usbos_community_data_updated_through
)
file `../community_update_time.py`;

root datasource arboretum_update_time (
    data_updated_through: arboretum_data_updated_through
)
file `./arboretum_update_time.py`;

root datasource cambridge_update_time (
    data_updated_through: cambridge_data_updated_through
)
file `./cambridge_update_time.py`;

root datasource brookline_update_time (
    data_updated_through: brookline_data_updated_through
)
file `./brookline_update_time.py`;

# GCS publication time of the staged OSM parquet (see boston_osm_extract.py); it
# only moves when an extraction is re-run and uploaded.  Not a local
# mtime: the staging parquets used to be committed, and git does not
# preserve mtime, so every fresh clone looked like new data.
root datasource usbos_osm_update_time (
    data_updated_through: usbos_osm_data_updated_through
)
file `./boston_osm_probe.py`;

# --- Raw sources ---

root partial datasource city_raw_tree_info (
    id: tree_id,
    city: city,
    data_source: usbos_source,
    spp_bot: ?raw_species,
    tree_name: ?raw_tree_name,
    
    date_plant: ?raw_plant_date,
    latitude: ?raw_latitude,
    longitude: ?raw_longitude,
    dbh: ?raw_dbh,
    submission_photo_url: ?raw_photo_url,
)
grain (tree_id)
complete where city = 'USBOS' and usbos_source = 'CITY_OF_BOSTON'
file `./boston_tree_info.py`;

root partial datasource arboretum_raw_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: usbos_source,
    species: ?raw_species,
    tree_name: ?raw_tree_name,
    plant_date: ?raw_plant_date,
    latitude: ?raw_latitude,
    longitude: ?raw_longitude,
    diameter_at_breast_height: ?raw_dbh,
    submission_photo_url: ?raw_photo_url,
)
grain (tree_id)
complete where city = 'USBOS' and usbos_source = 'ARNOLD_ARBORETUM'
file `./arboretum_tree_info.py`;

root partial datasource cambridge_raw_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: usbos_source,
    species: ?raw_species,
    tree_name: ?raw_tree_name,
    plant_date: ?raw_plant_date,
    latitude: ?raw_latitude,
    longitude: ?raw_longitude,
    diameter_at_breast_height: ?raw_dbh,
    submission_photo_url: ?raw_photo_url,
)
grain (tree_id)
complete where city = 'USBOS' and usbos_source = 'CAMBRIDGE'
file `./cambridge_tree_info.py`;

root partial datasource brookline_raw_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: usbos_source,
    species: ?raw_species,
    tree_name: ?raw_tree_name,
    plant_date: ?raw_plant_date,
    latitude: ?raw_latitude,
    longitude: ?raw_longitude,
    diameter_at_breast_height: ?raw_dbh,
    submission_photo_url: ?raw_photo_url,
)
grain (tree_id)
complete where city = 'USBOS' and usbos_source = 'BROOKLINE'
file `./brookline_tree_info.py`;

# Approved community submissions for this city. The shared ingest script emits
# every city's rows; the `complete where` clause narrows it to USBOS and makes
# it a disjoint partition alongside the four municipal sources. `diameter_at_breast_height`
# maps to `raw_dbh` (not the canonical concept) so community rows go through the
# same species-average imputation. Mapping it directly would leave
# `diameter_at_breast_height` resolvable only from partial sources and make the
# whole Boston model unresolvable.
root partial datasource usbos_community_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: usbos_source,
    species: ?raw_species,
    tree_name: ?raw_tree_name,
    plant_date: ?raw_plant_date,
    diameter_at_breast_height: ?raw_dbh,
    latitude: ?raw_latitude,
    longitude: ?raw_longitude,
    submission_photo_url: ?raw_photo_url,
)
grain (tree_id)
complete where city = 'USBOS' and usbos_source = 'COMMUNITY_USBOS'
file `../community_tree_info.py`
where city = 'USBOS';

# OpenStreetMap trees, read from the staged parquet in GCS rather than
# Overpass — extraction is decoupled from refresh (see boston_osm_extract.py
# and EXTENDING.md).  Overlapping rows are resolved by the
# shared cluster merge (../tree_dedup.preql).  `diameter_at_breast_height` maps
# to `raw_dbh` like every other Boston source so OSM rows go through the same
# species-average imputation.
root partial datasource usbos_osm_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: usbos_source,
    species: ?raw_species,
    tree_name: ?raw_tree_name,
    plant_date: ?raw_plant_date,
    latitude: ?raw_latitude,
    longitude: ?raw_longitude,
    diameter_at_breast_height: ?raw_dbh,
    submission_photo_url: ?raw_photo_url,
)
grain (tree_id)
complete where city = 'USBOS' and usbos_source = 'OSM_USBOS'
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/usbos_osm_staging.parquet`;

# --- Cross-source dedup and attribute merge --------------------------------
#
# Shared: ../tree_dedup.preql groups the three partitions into one cluster per
# tree and picks each canonical attribute across the cluster; this city's grid
# cell size and its calibration live in DEDUP_CELL_METRES in _ingest_shared.py.
# The only per-city line is the dbh merge, because Boston imputes it.
# Boston imputes a missing dbh from the city-and-species average, as it always
# has; the imputation runs on each raw row BEFORE the cross-source merge, and
# the merge then picks across the cluster as for any other attribute.  Merging
# first and imputing the merged value was tried and does not plan: coalescing
# a by-cluster aggregate with a by-(city, species) aggregate in one expression
# is the keyless-join planner bug again (upstream_repro/keyless_join_cell_aggregate).
auto imputed_dbh <- coalesce(cleaned_dbh, avg(cleaned_dbh) by city, raw_species);
auto processed_dbh <- @by_source(imputed_dbh);
merge processed_dbh into diameter_at_breast_height;


# --- Merged materialized parquet (all Boston sources) ---

# INTENDED END STATE: `where tree_id = cluster_id` on this target, so the
# parquet holds exactly one row per tree and needs no client-side filter; see
# "Intended end state" in ../tree_dedup.preql for what blocks it upstream.
partial datasource boston_tree_info (
    tree_id,
    city,
    data_source: usbos_source,
    ?species,
    ?tree_name,
    ?diameter_at_breast_height,
    ?plant_date,
    ?latitude,
    ?longitude,
    ?submission_photo_url,
    merged_sources,
    ?merged_tree_ids,
    usbos_published_data_updated_through
)
grain (tree_id)
complete where city = 'USBOS'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/usbos_tree_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/usbos_tree_info_v{data_version}.parquet`
where tree_id = cluster_id
freshness by usbos_published_data_updated_through;

