import ..landmark_common;

root datasource columbus_landmarks_update_time (
    data_updated_through: uscol_landmark_data_updated_through
)
file `./columbus_landmarks_probe.py`;

# The Columbus Register of Historic Properties (the city's own designation
# register, on the same ArcGIS Server as the trees) and the National Park
# Service's National Register listings in Columbus -- registers read live, so
# no Nominatim geocoding, no committed CSV and no staging object.  `lm_type`
# names the register and `register_number` the roster number (`CR-40`) or the
# NRIS reference number.
root partial datasource raw_columbus_landmark_info extends landmark_partition (
    address: ?address,
    lm_type: ?lm_type,
    register_number: ?register_number,
    year_designated: ?year_designated,
)
complete where city = 'USCOL'
file `./columbus_landmarks.py`;

partial datasource columbus_landmark_info extends published_landmark_info (
    ?address,
    ?lm_type,
    ?register_number,
    ?year_designated,
    uscol_landmark_data_updated_through,
)
complete where city = 'USCOL'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/uscol_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/uscol_landmark_info_v{data_version}.parquet`
freshness by uscol_landmark_data_updated_through;
