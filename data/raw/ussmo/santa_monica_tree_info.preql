import ..tree_common;
import ..community_tree_info;
import ..tree_dedup;

auto ussmo_published_data_updated_through <- greatest(ussmo_data_updated_through, ussmo_community_data_updated_through, ussmo_osm_data_updated_through);

key ussmo_source enum<string>['SANTA_MONICA_OPENDATA', 'COMMUNITY_USSMO', 'OSM_USSMO']; # originating dataset for the row

# Feed the shared cross-source merge (../tree_dedup.preql): it classifies rows
# by the label's prefix and records provenance from it.
auto ussmo_source_label <- concat(ussmo_source, '');
merge ussmo_source_label into source_label;

root datasource santa_monica_update_time (
    data_updated_through: ussmo_data_updated_through
)
file `./santa_monica_update_time.py`;

# Only this city's column, so an approval elsewhere does not mark USSMO's
# Parquet stale. Trilogy probes this as MAX over the one column.
root datasource ussmo_community_update_time (
    ussmo_community_data_updated_through: ussmo_community_data_updated_through
)
file `../community_update_time.py`;

# GCS publication time of the staged OSM parquet; it only moves when an
# extraction is re-run and uploaded. Not a local mtime -- git does not preserve
# it, so a committed staging file makes every fresh clone look like new data.
root datasource ussmo_osm_update_time (
    data_updated_through: ussmo_osm_data_updated_through
)
file `./santa_monica_osm_probe.py`;

# Every partition extends ../tree_dedup.preql's `tree_partition`, which maps
# the shared raw_* columns; a source that names a column differently re-binds
# it here (`dbh: ?raw_dbh`).
root partial datasource santa_monica_raw_tree_info extends tree_partition (
    data_source: ussmo_source,
)
complete where city = 'USSMO' and ussmo_source = 'SANTA_MONICA_OPENDATA'
file `./santa_monica_tree_info.py`;


# Approved community submissions for this city. The shared ingest script emits
# every city's rows; the `complete where` clause narrows it to USSMO and makes
# it a disjoint partition, and the `where` clause is what actually filters --
# `complete where` asserts, it does not promise a predicate.
root partial datasource ussmo_community_tree_info extends tree_partition (
    data_source: ussmo_source,
)
complete where city = 'USSMO' and ussmo_source = 'COMMUNITY_USSMO'
file `../community_tree_info.py`
where city = 'USSMO';


# OpenStreetMap trees, read from the staged parquet in GCS rather than Overpass
# -- extraction is decoupled from refresh. OSM overlaps the municipal inventory
# by construction; the overlap is resolved by ../tree_dedup.preql. The `where`
# is the city's CITY_TERRITORY (tools/sync_osm_territory.py keeps it so): a
# staged extract keeps the territory it was cut with until its next firing.
root partial datasource ussmo_osm_tree_info extends tree_partition (
    data_source: ussmo_source,
)
complete where city = 'USSMO' and ussmo_source = 'OSM_USSMO'
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/ussmo_osm_staging.parquet`
where (raw_latitude >= 33.99 and raw_latitude < 34.0 and raw_longitude >= -118.49 and raw_longitude < -118.47)
    or (raw_latitude >= 34.0 and raw_latitude < 34.01 and raw_longitude >= -118.5 and raw_longitude < -118.45)
    or (raw_latitude >= 34.01 and raw_latitude < 34.02 and raw_longitude >= -118.51 and raw_longitude < -118.44)
    or (raw_latitude >= 34.02 and raw_latitude < 34.03 and raw_longitude >= -118.52 and raw_longitude < -118.44)
    or (raw_latitude >= 34.03 and raw_latitude < 34.04 and raw_longitude >= -118.52 and raw_longitude < -118.45)
    or (raw_latitude >= 34.04 and raw_latitude < 34.05 and raw_longitude >= -118.51 and raw_longitude < -118.465);


# --- Cross-source dedup and attribute merge --------------------------------
#
# Shared: ../tree_dedup.preql groups the three partitions into one cluster per
# tree and picks each canonical attribute across the cluster; this city's grid
# cell size and its calibration live in DEDUP_CELL_METRES in shared/ingest.py.
# The per-city lines are the dbh merge, because Boston imputes it, and the
# position policy: a city with an Overture lookup imports ../tree_position.preql
# instead of the two position merges (see that file).
merge merged_dbh into diameter_at_breast_height;
merge merged_latitude into latitude;
merge merged_longitude into longitude;


# The published target extends ../tree_dedup.preql's `published_tree_info`:
# the canonical columns, the prune, and the guard that refuses a build which
# lost a quarter of the city.  The two `@source_kept` lines are the same guard
# per bulk source; add one for every municipal or OSM label in the enum
# (`test_every_city_refuses_a_collapsed_build`).
partial datasource santa_monica_tree_info extends published_tree_info (
    data_source: ussmo_source,
    ussmo_published_data_updated_through,
)
complete where city = 'USSMO'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/ussmo_tree_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/ussmo_tree_info_v{data_version}.parquet`
freshness by ussmo_published_data_updated_through
assert @source_kept(tree_id, ussmo_source, 'SANTA_MONICA_OPENDATA', 0.75)
assert @source_kept(tree_id, ussmo_source, 'OSM_USSMO', 0.75);
