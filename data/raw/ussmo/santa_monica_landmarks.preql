import ..landmark_common;

root datasource santa_monica_landmarks_update_time (
    data_updated_through: ussmo_landmark_data_updated_through
)
file `./santa_monica_landmarks_probe.py`;

# Santa Monica's designated Landmarks and Structures of Merit (the city's own
# register under the 1976 Landmarks and Historic District Ordinance, published
# on the city's ArcGIS Server under ODC-By 1.0) and the National Park
# Service's National Register listings in Santa Monica -- registers read live,
# so no Nominatim geocoding, no committed CSV and no staging object.
# `lm_type` names the register and designation, `register_number` the NRIS
# reference number (the city's register numbers nothing).
root partial datasource raw_santa_monica_landmark_info extends landmark_partition (
    address: ?address,
    lm_type: ?lm_type,
    register_number: ?register_number,
    year_designated: ?year_designated,
)
complete where city = 'USSMO'
file `./santa_monica_landmarks.py`;

partial datasource santa_monica_landmark_info extends published_landmark_info (
    ?address,
    ?lm_type,
    ?register_number,
    ?year_designated,
    ussmo_landmark_data_updated_through,
)
complete where city = 'USSMO'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/ussmo_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/ussmo_landmark_info_v{data_version}.parquet`
freshness by ussmo_landmark_data_updated_through;
