import ..tree_common;

root partial datasource paris_update_time (
    data_updated_through: paris_data_updated_through
)
grain (city)
complete where city = 'FRPAR'
file `./paris_update_time.py`
freshness by paris_data_updated_through;

root partial datasource paris_raw_tree_info (
    tree_id: tree_id,
    city: city,
    species: species,
    plant_date: ?plant_date,
    latitude: ?latitude,
    longitude: ?longitude,
    diameter_at_breast_height: ?diameter_at_breast_height,
)
grain (tree_id)
complete where city = 'FRPAR'
file `./paris_tree_info.py`;


partial datasource paris_tree_info (
    tree_id,
    city,
    species,
    ?plant_date,
    ?diameter_at_breast_height,
    ?latitude,
    ?longitude,
    paris_data_updated_through,
)
grain (tree_id)
complete where city = 'FRPAR'
file `https://storage.googleapis.com/trilogy_public_models/duckdb/trees/frpar_tree_info.parquet`:`gcs://trilogy_public_models/duckdb/trees/frpar_tree_info.parquet`
freshness by paris_data_updated_through;
