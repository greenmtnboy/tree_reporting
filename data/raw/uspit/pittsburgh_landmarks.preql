import ..landmark_common;

root datasource pittsburgh_landmarks_update_time (
    data_updated_through: uspit_landmark_data_updated_through
)
file `./pittsburgh_landmarks_probe.py`;

# The City of Pittsburgh's Designated Individual Historic Sites (the city's
# own designation register, on the same ArcGIS Online organisation that
# publishes the city's data to the WPRDC) and the National Park Service's
# National Register listings in Pittsburgh -- registers read live, so no
# Nominatim geocoding, no committed CSV and no staging object.  `lm_type`
# names the register and `register_number` the NRIS reference number (the
# city register publishes none, nor a designation date).
root partial datasource raw_pittsburgh_landmark_info extends landmark_partition (
    address: ?address,
    lm_type: ?lm_type,
    register_number: ?register_number,
    year_designated: ?year_designated,
)
complete where city = 'USPIT'
file `./pittsburgh_landmarks.py`;

partial datasource pittsburgh_landmark_info extends published_landmark_info (
    ?address,
    ?lm_type,
    ?register_number,
    ?year_designated,
    uspit_landmark_data_updated_through,
)
complete where city = 'USPIT'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/uspit_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/uspit_landmark_info_v{data_version}.parquet`
freshness by uspit_landmark_data_updated_through;
