import ..landmark_common;

root datasource chelsea_landmarks_update_time (
    data_updated_through: usche_landmark_data_updated_through
)
file `./chelsea_landmarks_probe.py`;

# Chelsea's National Register listings (the National Park Service's
# nrhp_locations MapServer cut to the city), read live -- no Nominatim
# geocoding, no committed CSV and no staging object.  A register of the
# town's own is a follow-up.  `lm_type` names the register and
# `register_number` the NRIS reference number.
root partial datasource raw_chelsea_landmark_info extends landmark_partition (
    address: ?address,
    lm_type: ?lm_type,
    register_number: ?register_number,
    year_designated: ?year_designated,
)
complete where city = 'USCHE'
file `./chelsea_landmarks.py`;

partial datasource chelsea_landmark_info extends published_landmark_info (
    ?address,
    ?lm_type,
    ?register_number,
    ?year_designated,
    usche_landmark_data_updated_through,
)
complete where city = 'USCHE'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/usche_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/usche_landmark_info_v{data_version}.parquet`
freshness by usche_landmark_data_updated_through;
