import ..landmark_common;

root datasource redlands_landmarks_update_time (
    data_updated_through: usrdl_landmark_data_updated_through
)
file `./redlands_landmarks_probe.py`;

# Redlands's designated historic landmarks and resources (the City's Historic
# Buildings & Structures layer, on the same ArcGIS server as the trees) and
# the National Park Service's National Register listings in Redlands --
# registers read live, so no Nominatim geocoding, no committed CSV and no
# staging object.  `lm_type` names the register and `register_number` the
# City's designation code (`HL57`, `HR67`) or the NRIS reference number.
root partial datasource raw_redlands_landmark_info extends landmark_partition (
    address: ?address,
    lm_type: ?lm_type,
    register_number: ?register_number,
    year_designated: ?year_designated,
)
complete where city = 'USRDL'
file `./redlands_landmarks.py`;

partial datasource redlands_landmark_info extends published_landmark_info (
    ?address,
    ?lm_type,
    ?register_number,
    ?year_designated,
    usrdl_landmark_data_updated_through,
)
complete where city = 'USRDL'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/usrdl_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/usrdl_landmark_info_v{data_version}.parquet`
freshness by usrdl_landmark_data_updated_through;
