import ..tree_common;
import ..community_tree_info;
import ..tree_dedup;

# Plainfield's trees were OSM rows of Naperville's model (USNPV) under the
# rectangle Naperville had until #285 drew it to its Census line (issue #287).
# It is its own city now, its territory the village's real boundary
# (boundaries/usplf.json).  Its inventory is the Plainfield Park District's
# park trees (no licence stated, displayed with attribution only); the village
# publishes no street inventory, so street trees come from OSM and community
# submissions.  The district's parks outside the village line are dropped by
# the ingest.

auto usplf_published_data_updated_through <- greatest(usplf_data_updated_through, usplf_community_data_updated_through, usplf_osm_data_updated_through);

key usplf_source enum<string>['PLAINFIELD_PARK_DISTRICT', 'COMMUNITY_USPLF', 'OSM_USPLF']; # originating dataset for the row

# Feed the shared cross-source merge (../tree_dedup.preql): it classifies rows
# by the label's prefix and records provenance from it.
auto usplf_source_label <- concat(usplf_source, '');
merge usplf_source_label into source_label;

root datasource plainfield_update_time (
    data_updated_through: usplf_data_updated_through
)
file `./plainfield_update_time.py`;

# Only this city's column, so an approval elsewhere does not mark USPLF's
# Parquet stale. Trilogy probes this as MAX over the one column.
root datasource usplf_community_update_time (
    usplf_community_data_updated_through: usplf_community_data_updated_through
)
file `../community_update_time.py`;

# GCS publication time of the staged OSM parquet; it only moves when an
# extraction is re-run and uploaded. Not a local mtime -- git does not preserve
# it, so a committed staging file makes every fresh clone look like new data.
root datasource usplf_osm_update_time (
    data_updated_through: usplf_osm_data_updated_through
)
file `./plainfield_osm_probe.py`;

# Every partition extends ../tree_dedup.preql's `tree_partition`, which maps
# the shared raw_* columns; a source that names a column differently re-binds
# it here (`dbh: ?raw_dbh`).
root partial datasource plainfield_raw_tree_info extends tree_partition (
    data_source: usplf_source,
    species: ?raw_species,
)
complete where city = 'USPLF' and usplf_source = 'PLAINFIELD_PARK_DISTRICT'
file `./plainfield_tree_info.py`;


# Approved community submissions for this city. The shared ingest script emits
# every city's rows; the `complete where` clause narrows it to USPLF and makes
# it a disjoint partition, and the `where` clause is what actually filters --
# `complete where` asserts, it does not promise a predicate.
root partial datasource usplf_community_tree_info extends tree_partition (
    data_source: usplf_source,
    species: ?raw_species,
)
complete where city = 'USPLF' and usplf_source = 'COMMUNITY_USPLF'
file `../community_tree_info.py`
where city = 'USPLF';


# OpenStreetMap trees, read from the staged parquet in GCS rather than Overpass
# -- extraction is decoupled from refresh. OSM overlaps the municipal inventory
# by construction; the overlap is resolved by ../tree_dedup.preql. The `where`
# is the city's CITY_TERRITORY (tools/sync_osm_territory.py keeps it so): a
# staged extract keeps the territory it was cut with until its next firing.
root partial datasource usplf_osm_tree_info extends tree_partition (
    data_source: usplf_source,
    species: ?raw_species,
)
complete where city = 'USPLF' and usplf_source = 'OSM_USPLF'
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/usplf_osm_staging.parquet`
where (raw_latitude >= 41.5692 and raw_latitude < 41.6802 and raw_longitude >= -88.3026 and raw_longitude < -88.1628);


# --- Cross-source dedup and attribute merge --------------------------------
#
# Shared: ../tree_dedup.preql groups the partitions into one cluster per
# tree and picks each canonical attribute across the cluster; this city's grid
# cell size and its calibration live in DEDUP_CELL_METRES in shared/ingest.py.
# The per-city lines are the dbh merge, because Boston imputes it, and the
# position policy: a city with an Overture lookup imports ../tree_position.preql
# instead of the two position merges (see that file).
merge merged_dbh into diameter_at_breast_height;
merge merged_latitude into latitude;
merge merged_longitude into longitude;


# The published target extends ../tree_dedup.preql's `published_tree_info`:
# the canonical columns, the prune, and the guard that refuses a build which
# lost a quarter of the city.  The two `@source_kept` lines are the same guard
# per bulk source; add one for every municipal or OSM label in the enum
# (`test_every_city_refuses_a_collapsed_build`).
partial datasource plainfield_tree_info extends published_tree_info (
    data_source: usplf_source,
    ?species,
    usplf_published_data_updated_through,
)
complete where city = 'USPLF'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/usplf_tree_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/usplf_tree_info_v{data_version}.parquet`
freshness by usplf_published_data_updated_through
assert @source_kept(tree_id, usplf_source, 'PLAINFIELD_PARK_DISTRICT', 0.75)
assert @source_kept(tree_id, usplf_source, 'OSM_USPLF', 0.75);
