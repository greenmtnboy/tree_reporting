import ..landmark_common;

root datasource plainfield_landmarks_update_time (
    data_updated_through: usplf_landmark_data_updated_through
)
file `./plainfield_landmarks_probe.py`;

# Plainfield, IL's National Register listings (the National Park Service's
# nrhp_locations MapServer cut to the city), read live -- no Nominatim
# geocoding, no committed CSV and no staging object.  A register of the
# city's own is a follow-up.  `lm_type` names the register and
# `register_number` the NRIS reference number.
root partial datasource raw_plainfield_landmark_info extends landmark_partition (
    address: ?address,
    lm_type: ?lm_type,
    register_number: ?register_number,
    year_designated: ?year_designated,
)
complete where city = 'USPLF'
file `./plainfield_landmarks.py`;

partial datasource plainfield_landmark_info extends published_landmark_info (
    ?address,
    ?lm_type,
    ?register_number,
    ?year_designated,
    usplf_landmark_data_updated_through,
)
complete where city = 'USPLF'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/usplf_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/usplf_landmark_info_v{data_version}.parquet`
freshness by usplf_landmark_data_updated_through;
