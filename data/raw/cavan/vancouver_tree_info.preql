import ..tree_common;
import ..community_tree_info;
import ..tree_dedup;

auto cavan_published_data_updated_through <- greatest(cavan_data_updated_through, cavan_community_data_updated_through, cavan_osm_data_updated_through);

key cavan_source enum<string>['VANCOUVER_OPENDATA', 'COMMUNITY_CAVAN', 'OSM_CAVAN']; # originating dataset for the row

# Feed the shared cross-source merge (../tree_dedup.preql): it classifies rows
# by the label's prefix and records provenance from it.
auto cavan_source_label <- concat(cavan_source, '');
merge cavan_source_label into source_label;

root datasource vancouver_update_time (
    data_updated_through: cavan_data_updated_through
)
file `./vancouver_update_time.py`;

# Only this city's column, so an approval elsewhere does not mark CAVAN's
# Parquet stale. Trilogy probes this as MAX over the one column.
root datasource cavan_community_update_time (
    cavan_community_data_updated_through: cavan_community_data_updated_through
)
file `../community_update_time.py`;




# GCS publication time of the staged OSM parquet (see vancouver_osm_extract.py);
# it only moves when an extraction is re-run and uploaded.
root datasource cavan_osm_update_time (
    data_updated_through: cavan_osm_data_updated_through
)
file `./vancouver_osm_probe.py`;

# OpenStreetMap trees, read from the staged parquet in GCS rather than
# Overpass -- extraction is decoupled from refresh (see _osm_shared.py and
# EXTENDING.md).  Overlapping rows are resolved by the
# shared cluster merge (../tree_dedup.preql).
root partial datasource cavan_osm_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: cavan_source,
    species: ?raw_species,
    tree_name: ?raw_tree_name,
    plant_date: ?raw_plant_date,
    latitude: ?raw_latitude,
    longitude: ?raw_longitude,
    diameter_at_breast_height: ?raw_dbh,
    submission_photo_url: ?raw_photo_url,
)
grain (tree_id)
complete where city = 'CAVAN' and cavan_source = 'OSM_CAVAN'
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/cavan_osm_staging.parquet`;

root partial datasource vancouver_raw_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: cavan_source,
    species: raw_species,
    tree_name: ?raw_tree_name,
    plant_date: ?raw_plant_date,
    latitude: ?raw_latitude,
    longitude: ?raw_longitude,
    diameter_at_breast_height: ?raw_dbh,
    submission_photo_url: ?raw_photo_url,
)
grain (tree_id)
complete where city = 'CAVAN' and cavan_source = 'VANCOUVER_OPENDATA'
file `./vancouver_tree_info.py`;


# Approved community submissions for this city. The shared ingest script
# emits every city's rows; the `complete where` clause narrows it to CAVAN
# and makes it a disjoint partition alongside vancouver_raw_tree_info.
root partial datasource cavan_community_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: cavan_source,
    species: raw_species,
    tree_name: ?raw_tree_name,
    plant_date: ?raw_plant_date,
    diameter_at_breast_height: ?raw_dbh,
    latitude: ?raw_latitude,
    longitude: ?raw_longitude,
    submission_photo_url: ?raw_photo_url,
)
grain (tree_id)
complete where city = 'CAVAN' and cavan_source = 'COMMUNITY_CAVAN'
file `../community_tree_info.py`
where city = 'CAVAN';



# --- Cross-source dedup and attribute merge --------------------------------
#
# Shared: ../tree_dedup.preql groups the three partitions into one cluster per
# tree and picks each canonical attribute across the cluster; this city's grid
# cell size and its calibration live in DEDUP_CELL_METRES in _ingest_shared.py.
# The only per-city line is the dbh merge, because Boston imputes it.
merge merged_dbh into diameter_at_breast_height;


# The `where` below is the prune: this target publishes only the row that owns
# its cluster, so the parquet holds exactly one tree per row.  It needs
# pytrilogy 0.3.348+ and fails quietly on older planners -- see "The prune" in
# ../tree_dedup.preql.
partial datasource vancouver_tree_info (
    tree_id,
    city,
    data_source: cavan_source,
    species,
    ?tree_name,
    ?plant_date,
    ?diameter_at_breast_height,
    ?latitude,
    ?longitude,
    ?submission_photo_url,
    cluster_id,
    merged_sources,
    ?merged_tree_ids,
    cavan_published_data_updated_through,
)
grain (tree_id)
complete where city = 'CAVAN'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/cavan_tree_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/cavan_tree_info_v{data_version}.parquet`
where tree_id = cluster_id
freshness by cavan_published_data_updated_through;
