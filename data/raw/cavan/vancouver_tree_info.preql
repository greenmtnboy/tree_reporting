import ..tree_common;
import ..community_tree_info;

auto cavan_published_data_updated_through <- greatest(cavan_data_updated_through, cavan_community_data_updated_through, cavan_osm_data_updated_through);

key cavan_source enum<string>['VANCOUVER_OPENDATA', 'COMMUNITY_CAVAN', 'OSM_CAVAN']; # originating dataset for the row

root datasource vancouver_update_time (
    data_updated_through: cavan_data_updated_through
)
file `./vancouver_update_time.py`;

# Only this city's column, so an approval elsewhere does not mark CAVAN's
# Parquet stale. Trilogy probes this as MAX over the one column.
root datasource cavan_community_update_time (
    cavan_community_data_updated_through: cavan_community_data_updated_through
)
file `../community_update_time.py`;




# GCS publication time of the staged OSM parquet (see vancouver_osm_extract.py);
# it only moves when an extraction is re-run and uploaded.
root datasource cavan_osm_update_time (
    data_updated_through: cavan_osm_data_updated_through
)
file `./vancouver_osm_probe.py`;

# OpenStreetMap trees, read from the staged parquet in GCS rather than
# Overpass -- extraction is decoupled from refresh (see _osm_shared.py and
# EXTENDING.md).  Overlapping rows are kept and flagged via
# cavan_is_duplicate below, never dropped: the Parquet must contain the union
# of its declared sources, and the flag keeps the dedup tunable and auditable.
root partial datasource cavan_osm_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: cavan_source,
    species: ?species,
    tree_name: ?tree_name,
    plant_date: ?plant_date,
    latitude: ?latitude,
    longitude: ?longitude,
    diameter_at_breast_height: ?diameter_at_breast_height,
    submission_photo_url: ?submission_photo_url,
)
grain (tree_id)
complete where city = 'CAVAN' and cavan_source = 'OSM_CAVAN'
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/cavan_osm_staging.parquet`;

root partial datasource vancouver_raw_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: cavan_source,
    species: species,
    tree_name: ?tree_name,
    plant_date: ?plant_date,
    latitude: ?latitude,
    longitude: ?longitude,
    diameter_at_breast_height: ?diameter_at_breast_height,
    submission_photo_url: ?submission_photo_url,
)
grain (tree_id)
complete where city = 'CAVAN' and cavan_source = 'VANCOUVER_OPENDATA'
file `./vancouver_tree_info.py`;


# Approved community submissions for this city. The shared ingest script
# emits every city's rows; the `complete where` clause narrows it to CAVAN
# and makes it a disjoint partition alongside vancouver_raw_tree_info.
root partial datasource cavan_community_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: cavan_source,
    species: species,
    tree_name: ?tree_name,
    plant_date: ?plant_date,
    diameter_at_breast_height: ?diameter_at_breast_height,
    latitude: ?latitude,
    longitude: ?longitude,
    submission_photo_url: ?submission_photo_url,
)
grain (tree_id)
complete where city = 'CAVAN' and cavan_source = 'COMMUNITY_CAVAN'
file `../community_tree_info.py`
where city = 'CAVAN';



# --- Cross-source dedup: stack + aggregate over four staggered grids -------
#
# Same construction as ustem/tempe_tree_info.preql (full rationale there and in
# EXTENDING.md): an OSM row is a duplicate when a non-OSM tree shares its
# ~10m grid cell in ANY of four half-cell-staggered grid copies -- a guaranteed
# match within 5m, possible out to a ~14m diagonal.
#
# CALIBRATED at 10m. This city's 5-10m band is 26.7% mutual-NN over
# n=2883 -- neighbour-dominated: a false flag hides a real tree
# while a missed duplicate only double-renders one, so a band that is not
# clearly duplicate-dominated should not be flagged. Re-check with:
#     cd data/raw && uv run ./osm_dedup_validation.py --city CAVAN
#
# Cell sizes: 10m of latitude is 10/111320 deg; longitude shrinks by
# cos(49.25 deg) here.
const cavan_cell_lat_deg <- 0.00008983;
const cavan_cell_lon_deg <- 0.00013762;

auto cavan_cell_a <- concat(cast(floor(longitude / cavan_cell_lon_deg) as string), ':', cast(floor(latitude / cavan_cell_lat_deg) as string));
auto cavan_cell_b <- concat(cast(floor(longitude / cavan_cell_lon_deg + 0.5) as string), ':', cast(floor(latitude / cavan_cell_lat_deg) as string));
auto cavan_cell_c <- concat(cast(floor(longitude / cavan_cell_lon_deg) as string), ':', cast(floor(latitude / cavan_cell_lat_deg + 0.5) as string));
auto cavan_cell_d <- concat(cast(floor(longitude / cavan_cell_lon_deg + 0.5) as string), ':', cast(floor(latitude / cavan_cell_lat_deg + 0.5) as string));

auto cavan_anchor_count_a <- count(tree_id ? cavan_source != 'OSM_CAVAN') by cavan_cell_a;
auto cavan_anchor_count_b <- count(tree_id ? cavan_source != 'OSM_CAVAN') by cavan_cell_b;
auto cavan_anchor_count_c <- count(tree_id ? cavan_source != 'OSM_CAVAN') by cavan_cell_c;
auto cavan_anchor_count_d <- count(tree_id ? cavan_source != 'OSM_CAVAN') by cavan_cell_d;

auto cavan_is_duplicate <- cavan_source = 'OSM_CAVAN' and (
    cavan_anchor_count_a > 0
    or cavan_anchor_count_b > 0
    or cavan_anchor_count_c > 0
    or cavan_anchor_count_d > 0
);

partial datasource vancouver_tree_info (
    tree_id,
    city,
    data_source: cavan_source,
    species,
    ?tree_name,
    ?plant_date,
    ?diameter_at_breast_height,
    ?latitude,
    ?longitude,
    ?submission_photo_url,
    is_duplicate: cavan_is_duplicate,
    cavan_published_data_updated_through,
)
grain (tree_id)
complete where city = 'CAVAN'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/cavan_tree_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/cavan_tree_info_v{data_version}.parquet`
freshness by cavan_published_data_updated_through;
