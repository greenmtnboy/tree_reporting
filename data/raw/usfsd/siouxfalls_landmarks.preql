import ..landmark_common;

root datasource siouxfalls_landmarks_update_time (
    data_updated_through: usfsd_landmark_data_updated_through
)
file `./siouxfalls_landmarks_probe.py`;

# Sioux Falls's local historic register (the City's Historic Properties layer,
# on the same ArcGIS Server as the trees) and the National Park Service's
# National Register listings in Sioux Falls -- registers read live, so no
# Nominatim geocoding, no committed CSV and no staging object.  `lm_type`
# names the register and `register_number` the NRIS reference number (the
# local register publishes none).
root partial datasource raw_siouxfalls_landmark_info extends landmark_partition (
    address: ?address,
    lm_type: ?lm_type,
    register_number: ?register_number,
    year_designated: ?year_designated,
)
complete where city = 'USFSD'
file `./siouxfalls_landmarks.py`;

partial datasource siouxfalls_landmark_info extends published_landmark_info (
    ?address,
    ?lm_type,
    ?register_number,
    ?year_designated,
    usfsd_landmark_data_updated_through,
)
complete where city = 'USFSD'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/usfsd_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/usfsd_landmark_info_v{data_version}.parquet`
freshness by usfsd_landmark_data_updated_through;
