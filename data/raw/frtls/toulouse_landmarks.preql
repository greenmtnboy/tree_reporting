import ..landmark_common;

root datasource toulouse_landmarks_update_time (
    data_updated_through: frtls_landmark_data_updated_through
)
file `./toulouse_landmarks_probe.py`;

# Toulouse's protected monuments -- buildings classés or inscrits under the
# Monuments Historiques -- read from the Ministry of Culture's national Mérimée
# export (Licence Ouverte v2.0) and filtered to the commune of Toulouse; see
# toulouse_landmarks.py.  The register's own attributes ride along in existing
# landmark_common properties: the address, the protection (date and type, as
# Paris carries it) and the building type.
root partial datasource raw_toulouse_landmark_info extends landmark_partition (
    address: ?address,
    protection_type: ?protection_type,
    denomination: ?denomination,
)
complete where city = 'FRTLS'
file `./toulouse_landmarks.py`;

partial datasource toulouse_landmark_info extends published_landmark_info (
    ?address,
    ?protection_type,
    ?denomination,
    frtls_landmark_data_updated_through,
)
complete where city = 'FRTLS'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/frtls_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/frtls_landmark_info_v{data_version}.parquet`
freshness by frtls_landmark_data_updated_through;
