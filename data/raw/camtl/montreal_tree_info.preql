import ..tree_common;
import ..community_tree_info;
import ..tree_dedup;

auto camtl_published_data_updated_through <- greatest(camtl_data_updated_through, camtl_community_data_updated_through, camtl_osm_data_updated_through);

key camtl_source enum<string>['MONTREAL_OPENDATA', 'COMMUNITY_CAMTL', 'OSM_CAMTL']; # originating dataset for the row

# Feed the shared cross-source merge (../tree_dedup.preql): it classifies rows
# by the label's prefix and records provenance from it.
auto camtl_source_label <- concat(camtl_source, '');
merge camtl_source_label into source_label;

root datasource montreal_update_time (
    data_updated_through: camtl_data_updated_through
)
file `./montreal_update_time.py`;

# Only this city's column, so an approval elsewhere does not mark CAMTL's
# Parquet stale. Trilogy probes this as MAX over the one column.
root datasource camtl_community_update_time (
    camtl_community_data_updated_through: camtl_community_data_updated_through
)
file `../community_update_time.py`;

# GCS publication time of the staged OSM parquet; it only moves when an
# extraction is re-run and uploaded. Not a local mtime -- git does not preserve
# it, so a committed staging file makes every fresh clone look like new data.
root datasource camtl_osm_update_time (
    data_updated_through: camtl_osm_data_updated_through
)
file `./montreal_osm_probe.py`;

root partial datasource montreal_raw_tree_info extends tree_partition (
    data_source: camtl_source,
)
complete where city = 'CAMTL' and camtl_source = 'MONTREAL_OPENDATA'
file `./montreal_tree_info.py`;


# Approved community submissions for this city. The shared ingest script emits
# every city's rows; the `complete where` clause narrows it to CAMTL and makes
# it a disjoint partition, and the `where` clause is what actually filters --
# `complete where` asserts, it does not promise a predicate.
root partial datasource camtl_community_tree_info extends tree_partition (
    data_source: camtl_source,
)
complete where city = 'CAMTL' and camtl_source = 'COMMUNITY_CAMTL'
file `../community_tree_info.py`
where city = 'CAMTL';


# OpenStreetMap trees, read from the staged parquet in GCS rather than Overpass
# -- extraction is decoupled from refresh. OSM overlaps the municipal inventory
# by construction; the overlap is resolved by ../tree_dedup.preql.
root partial datasource camtl_osm_tree_info extends tree_partition (
    data_source: camtl_source,
)
complete where city = 'CAMTL' and camtl_source = 'OSM_CAMTL'
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/camtl_osm_staging.parquet`;


# --- Cross-source dedup and attribute merge --------------------------------
#
# Shared: ../tree_dedup.preql groups the three partitions into one cluster per
# tree and picks each canonical attribute across the cluster; this city's grid
# cell size and its calibration live in DEDUP_CELL_METRES in shared/ingest.py.
# The only per-city line is the dbh merge, because Boston imputes it.
merge merged_dbh into diameter_at_breast_height;
# Position: the survivor's own point.  A city with an Overture lookup imports
# ../tree_position.preql instead, which merges the corrected point.
merge merged_latitude into latitude;
merge merged_longitude into longitude;


partial datasource montreal_tree_info extends published_tree_info (
    data_source: camtl_source,
    camtl_published_data_updated_through,
)
complete where city = 'CAMTL'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/camtl_tree_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/camtl_tree_info_v{data_version}.parquet`
freshness by camtl_published_data_updated_through
assert @source_kept(tree_id, camtl_source, 'MONTREAL_OPENDATA', 0.75)
assert @source_kept(tree_id, camtl_source, 'OSM_CAMTL', 0.75);
