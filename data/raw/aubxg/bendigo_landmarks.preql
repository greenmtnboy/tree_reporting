import ..landmark_common;

root datasource bendigo_landmarks_update_time (
    data_updated_through: aubxg_landmark_data_updated_through
)
file `./bendigo_landmarks_probe.py`;

# Greater Bendigo's places on the Victorian Heritage Register, read live from
# Vicmap's open-data WFS and cut to the City of Greater Bendigo with the LGA's
# own boundary (see bendigo_landmarks.py) -- an official register, so no
# Nominatim geocoding, no committed CSV and no staging object.  `lm_type`
# names the register and `register_number` carries the VHR number (H1234).
root partial datasource raw_bendigo_landmark_info extends landmark_partition (
    lm_type: ?lm_type,
    register_number: ?register_number,
)
complete where city = 'AUBXG'
file `./bendigo_landmarks.py`;

partial datasource bendigo_landmark_info extends published_landmark_info (
    ?lm_type,
    ?register_number,
    aubxg_landmark_data_updated_through,
)
complete where city = 'AUBXG'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/aubxg_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/aubxg_landmark_info_v{data_version}.parquet`
freshness by aubxg_landmark_data_updated_through;
