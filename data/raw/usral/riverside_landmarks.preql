import ..landmark_common;

root datasource riverside_landmarks_update_time (
    data_updated_through: usral_landmark_data_updated_through
)
file `./riverside_landmarks_probe.py`;

# Riverside's designated City Landmarks (the city's own register under
# Municipal Code Title 20, the City Landmark rows of its Historic Properties
# Designations layer on ArcGIS Online) and the National Park Service's
# National Register listings in Riverside -- registers read live, so no
# Nominatim geocoding, no committed CSV and no staging object.  `lm_type`
# names the register and `register_number` the NRIS reference number.
root partial datasource raw_riverside_landmark_info extends landmark_partition (
    address: ?address,
    lm_type: ?lm_type,
    register_number: ?register_number,
    year_designated: ?year_designated,
)
complete where city = 'USRAL'
file `./riverside_landmarks.py`;

partial datasource riverside_landmark_info extends published_landmark_info (
    ?address,
    ?lm_type,
    ?register_number,
    ?year_designated,
    usral_landmark_data_updated_through,
)
complete where city = 'USRAL'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/usral_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/usral_landmark_info_v{data_version}.parquet`
freshness by usral_landmark_data_updated_through;
