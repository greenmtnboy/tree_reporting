import ..tree_common;
import ..community_tree_info;
import ..tree_dedup;

auto caque_published_data_updated_through <- greatest(caque_data_updated_through, caque_community_data_updated_through, caque_osm_data_updated_through);

key caque_source enum<string>['QUEBEC_OPENDATA', 'COMMUNITY_CAQUE', 'OSM_CAQUE']; # originating dataset for the row

# Feed the shared cross-source merge (../tree_dedup.preql): it classifies rows
# by the label's prefix and records provenance from it.
auto caque_source_label <- concat(caque_source, '');
merge caque_source_label into source_label;

root datasource quebec_update_time (
    data_updated_through: caque_data_updated_through
)
file `./quebec_update_time.py`;

# Only this city's column, so an approval elsewhere does not mark CAQUE's
# Parquet stale. Trilogy probes this as MAX over the one column.
root datasource caque_community_update_time (
    caque_community_data_updated_through: caque_community_data_updated_through
)
file `../community_update_time.py`;

# GCS publication time of the staged OSM parquet; it only moves when an
# extraction is re-run and uploaded. Not a local mtime -- git does not preserve
# it, so a committed staging file makes every fresh clone look like new data.
root datasource caque_osm_update_time (
    data_updated_through: caque_osm_data_updated_through
)
file `./quebec_osm_probe.py`;

root partial datasource quebec_raw_tree_info extends tree_partition (
    data_source: caque_source,
)
complete where city = 'CAQUE' and caque_source = 'QUEBEC_OPENDATA'
file `./quebec_tree_info.py`;


# Approved community submissions for this city. The shared ingest script emits
# every city's rows; the `complete where` clause narrows it to CAQUE and makes
# it a disjoint partition, and the `where` clause is what actually filters --
# `complete where` asserts, it does not promise a predicate.
root partial datasource caque_community_tree_info extends tree_partition (
    data_source: caque_source,
)
complete where city = 'CAQUE' and caque_source = 'COMMUNITY_CAQUE'
file `../community_tree_info.py`
where city = 'CAQUE';


# OpenStreetMap trees, read from the staged parquet in GCS rather than Overpass
# -- extraction is decoupled from refresh. OSM overlaps the municipal inventory
# by construction; the overlap is resolved by ../tree_dedup.preql.
root partial datasource caque_osm_tree_info extends tree_partition (
    data_source: caque_source,
)
complete where city = 'CAQUE' and caque_source = 'OSM_CAQUE'
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/caque_osm_staging.parquet`;


# --- Cross-source dedup and attribute merge --------------------------------
#
# Shared: ../tree_dedup.preql groups the three partitions into one cluster per
# tree and picks each canonical attribute across the cluster; this city's grid
# cell size and its calibration live in DEDUP_CELL_METRES in shared/ingest.py.
# The only per-city line is the dbh merge, because Boston imputes it.
merge merged_dbh into diameter_at_breast_height;
# Position: the survivor's own point.  A city with an Overture lookup imports
# ../tree_position.preql instead, which merges the corrected point.
merge merged_latitude into latitude;
merge merged_longitude into longitude;


partial datasource quebec_tree_info extends published_tree_info (
    data_source: caque_source,
    caque_published_data_updated_through,
)
complete where city = 'CAQUE'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/caque_tree_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/caque_tree_info_v{data_version}.parquet`
freshness by caque_published_data_updated_through
assert @source_kept(tree_id, caque_source, 'QUEBEC_OPENDATA', 0.75)
assert @source_kept(tree_id, caque_source, 'OSM_CAQUE', 0.75);
