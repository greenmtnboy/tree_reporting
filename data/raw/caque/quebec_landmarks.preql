import ..landmark_common;

root datasource quebec_landmarks_update_time (
    data_updated_through: caque_landmark_data_updated_through
)
file `./quebec_landmarks_probe.py`;

# Quebec City's 100 entries in the Repertoire du patrimoine culturel du Quebec,
# the province's official register of designated heritage property -- the
# runbook's first preference.  Two resources on Donnees Quebec (classified by
# the minister, cited by the municipality), unioned and filtered to this
# municipality by quebec_landmarks.py, so no Nominatim geocoding, no committed
# CSV and no staging object.
#
# `category` is the designation itself ("Classement" or "Citation") rather than
# a building type; `property_type` carries the register's `usage`.
root partial datasource raw_quebec_landmark_info (
    landmark_id: landmark_id,
    city: city,
    name: name,
    geometry_raw: ?geometry_raw,
    address: ?address,
    category: ?category,
    property_type: ?property_type,
    designation_date: ?designation_date,
)
grain (landmark_id)
complete where city = 'CAQUE'
file `./quebec_landmarks.py`;

partial datasource quebec_landmark_info (
    landmark_id,
    city,
    name,
    ?geometry,
    ?latitude,
    ?longitude,
    ?address,
    ?category,
    ?property_type,
    ?designation_date,
    caque_landmark_data_updated_through,
)
grain (landmark_id)
complete where city = 'CAQUE'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/caque_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/caque_landmark_info_v{data_version}.parquet`
freshness by caque_landmark_data_updated_through;
