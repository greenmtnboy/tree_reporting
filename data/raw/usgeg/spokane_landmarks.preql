import ..landmark_common;

root datasource spokane_landmarks_update_time (
    data_updated_through: usgeg_landmark_data_updated_through
)
file `./spokane_landmarks_probe.py`;

# The National Park Service's National Register listings in Spokane, read
# live -- no Nominatim geocoding, no committed CSV and no staging object.
# The city's own Spokane Register layer carries no names and is not used
# (see spokane_landmarks.py).  `lm_type` names the register and
# `register_number` the NRIS reference number.
root partial datasource raw_spokane_landmark_info extends landmark_partition (
    address: ?address,
    lm_type: ?lm_type,
    register_number: ?register_number,
    year_designated: ?year_designated,
)
complete where city = 'USGEG'
file `./spokane_landmarks.py`;

partial datasource spokane_landmark_info extends published_landmark_info (
    ?address,
    ?lm_type,
    ?register_number,
    ?year_designated,
    usgeg_landmark_data_updated_through,
)
complete where city = 'USGEG'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/usgeg_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/usgeg_landmark_info_v{data_version}.parquet`
freshness by usgeg_landmark_data_updated_through;
