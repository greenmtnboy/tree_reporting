import ..landmark_common;

root datasource wodonga_landmarks_update_time (
    data_updated_through: auwod_landmark_data_updated_through
)
file `./wodonga_landmarks_probe.py`;

# Wodonga's places on the Victorian Heritage Register, read live from
# Vicmap's open-data WFS and cut to the City of Wodonga with the LGA's own
# boundary (see wodonga_landmarks.py) -- an official register, so no
# Nominatim geocoding, no committed CSV and no staging object.  `lm_type`
# names the register and `register_number` carries the VHR number (H1835).
root partial datasource raw_wodonga_landmark_info extends landmark_partition (
    lm_type: ?lm_type,
    register_number: ?register_number,
)
complete where city = 'AUWOD'
file `./wodonga_landmarks.py`;

partial datasource wodonga_landmark_info extends published_landmark_info (
    ?lm_type,
    ?register_number,
    auwod_landmark_data_updated_through,
)
complete where city = 'AUWOD'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/auwod_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/auwod_landmark_info_v{data_version}.parquet`
freshness by auwod_landmark_data_updated_through;
