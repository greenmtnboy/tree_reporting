import ..landmark_common;

root datasource utrecht_landmarks_update_time (
    data_updated_through: nlutc_landmark_data_updated_through
)
file `./utrecht_landmarks_probe.py`;

# Utrecht's national and municipal monument registers (Rijksmonumenten and
# Gemeentelijke monumenten, open.utrecht.nl, CC BY-SA 4.0 on the WFS), read
# from the city's GeoServer; only monuments the register names (a church, a
# bridge, a memorial) publish, not those known only by an address.  See
# utrecht_landmarks.py.  The register's attributes ride along in existing
# landmark_common properties: the register (category), the address and the
# year built.
root partial datasource raw_utrecht_landmark_info extends landmark_partition (
    category: ?category,
    address: ?address,
    year_built: ?year_built,
)
complete where city = 'NLUTC'
file `./utrecht_landmarks.py`;

partial datasource utrecht_landmark_info extends published_landmark_info (
    ?category,
    ?address,
    ?year_built,
    nlutc_landmark_data_updated_through,
)
complete where city = 'NLUTC'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/nlutc_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/nlutc_landmark_info_v{data_version}.parquet`
freshness by nlutc_landmark_data_updated_through;
