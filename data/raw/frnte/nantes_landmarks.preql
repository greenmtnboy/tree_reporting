import ..landmark_common;

root datasource nantes_landmarks_update_time (
    data_updated_through: frnte_landmark_data_updated_through
)
file `./nantes_landmarks_probe.py`;

# Nantes's protected monuments -- buildings classés or inscrits under the
# Monuments Historiques -- read from the Ministry of Culture's national Mérimée
# export (Licence Ouverte v2.0) and filtered to the 24 communes of Nantes
# Métropole, the tree inventory's territory; see nantes_landmarks.py.
# The register's own attributes ride along in existing landmark_common
# properties: the address, the protection (date and type, as Paris carries it)
# and the building type.
root partial datasource raw_nantes_landmark_info extends landmark_partition (
    address: ?address,
    protection_type: ?protection_type,
    denomination: ?denomination,
)
complete where city = 'FRNTE'
file `./nantes_landmarks.py`;

partial datasource nantes_landmark_info extends published_landmark_info (
    ?address,
    ?protection_type,
    ?denomination,
    frnte_landmark_data_updated_through,
)
complete where city = 'FRNTE'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/frnte_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/frnte_landmark_info_v{data_version}.parquet`
freshness by frnte_landmark_data_updated_through;
