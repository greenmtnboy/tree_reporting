import ..landmark_common;

root datasource las_vegas_landmarks_update_time (
    data_updated_through: uslas_landmark_data_updated_through
)
file `./las_vegas_landmarks_probe.py`;

# The City of Las Vegas's Historic Property Register (the City's own
# register, no licence stated: display with attribution only) and the National
# Park Service's National Register listings inside the City's limits --
# registers read live, so no Nominatim geocoding, no committed CSV and no
# staging object.  `lm_type` names the register and `register_number` the
# City resolution (`R-65-94`) or the NRIS reference number.
root partial datasource raw_las_vegas_landmark_info extends landmark_partition (
    address: ?address,
    lm_type: ?lm_type,
    register_number: ?register_number,
    year_designated: ?year_designated,
)
complete where city = 'USLAS'
file `./las_vegas_landmarks.py`;

partial datasource las_vegas_landmark_info extends published_landmark_info (
    ?address,
    ?lm_type,
    ?register_number,
    ?year_designated,
    uslas_landmark_data_updated_through,
)
complete where city = 'USLAS'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/uslas_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/uslas_landmark_info_v{data_version}.parquet`
freshness by uslas_landmark_data_updated_through;
