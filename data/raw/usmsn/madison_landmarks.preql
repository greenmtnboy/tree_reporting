import ..landmark_common;

root datasource madison_landmarks_update_time (
    data_updated_through: usmsn_landmark_data_updated_through
)
file `./madison_landmarks_probe.py`;

# Madison's Local Landmarks (designated by the Landmarks Commission; Planning's
# layer on the same ArcGIS Server as the trees) and the National Park
# Service's National Register listings in Madison -- registers read live, so
# no Nominatim geocoding, no committed CSV and no staging object.  `lm_type`
# names the register, `register_number` the landmark number (`12`, `33A`) or
# the NRIS reference number, and `property_type` the register's own type
# (Structure, Effigy Mounds, Area; building, site, structure).
root partial datasource raw_madison_landmark_info extends landmark_partition (
    address: ?address,
    lm_type: ?lm_type,
    property_type: ?property_type,
    register_number: ?register_number,
    year_built: ?year_built,
    year_designated: ?year_designated,
)
complete where city = 'USMSN'
file `./madison_landmarks.py`;

partial datasource madison_landmark_info extends published_landmark_info (
    ?address,
    ?lm_type,
    ?property_type,
    ?register_number,
    ?year_built,
    ?year_designated,
    usmsn_landmark_data_updated_through,
)
complete where city = 'USMSN'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/usmsn_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/usmsn_landmark_info_v{data_version}.parquet`
freshness by usmsn_landmark_data_updated_through;
