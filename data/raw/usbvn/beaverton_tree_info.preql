import ..tree_common;
import ..community_tree_info;
import ..tree_dedup;

# Beaverton's OSM trees were published by Portland's model (USPOR) under the
# rectangle Portland had until #285 drew it to its Census line (issue #287).
# It is its own city now, its territory the city's real boundary
# (boundaries/usbvn.json), with the City's own inventory (common names only,
# resolved in the ingest; no licence stated, displayed with attribution only)
# beside the community and OSM rows.

auto usbvn_published_data_updated_through <- greatest(usbvn_data_updated_through, usbvn_community_data_updated_through, usbvn_osm_data_updated_through);

key usbvn_source enum<string>['BEAVERTON', 'COMMUNITY_USBVN', 'OSM_USBVN']; # originating dataset for the row

# Feed the shared cross-source merge (../tree_dedup.preql): it classifies rows
# by the label's prefix and records provenance from it.
auto usbvn_source_label <- concat(usbvn_source, '');
merge usbvn_source_label into source_label;

root datasource beaverton_update_time (
    data_updated_through: usbvn_data_updated_through
)
file `./beaverton_update_time.py`;

# Only this city's column, so an approval elsewhere does not mark USBVN's
# Parquet stale. Trilogy probes this as MAX over the one column.
root datasource usbvn_community_update_time (
    usbvn_community_data_updated_through: usbvn_community_data_updated_through
)
file `../community_update_time.py`;

# GCS publication time of the staged OSM parquet; it only moves when an
# extraction is re-run and uploaded. Not a local mtime -- git does not preserve
# it, so a committed staging file makes every fresh clone look like new data.
root datasource usbvn_osm_update_time (
    data_updated_through: usbvn_osm_data_updated_through
)
file `./beaverton_osm_probe.py`;

# Every partition extends ../tree_dedup.preql's `tree_partition`, which maps
# the shared raw_* columns.
root partial datasource beaverton_raw_tree_info extends tree_partition (
    data_source: usbvn_source,
    species: ?raw_species,
)
complete where city = 'USBVN' and usbvn_source = 'BEAVERTON'
file `./beaverton_tree_info.py`;

# Approved community submissions for this city. The shared ingest script emits
# every city's rows; the `complete where` clause narrows it to USBVN and makes
# it a disjoint partition, and the `where` clause is what actually filters --
# `complete where` asserts, it does not promise a predicate.  A submission
# recorded under Portland that stands in Beaverton arrives here as USBVN
# (`territory_city` in shared/ingest.py).
root partial datasource usbvn_community_tree_info extends tree_partition (
    data_source: usbvn_source,
    species: ?raw_species,
)
complete where city = 'USBVN' and usbvn_source = 'COMMUNITY_USBVN'
file `../community_tree_info.py`
where city = 'USBVN';


# OpenStreetMap trees, read from the staged parquet in GCS rather than Overpass
# -- extraction is decoupled from refresh. The `where` is the city's territory
# (tools/sync_osm_territory.py keeps it so): a staged extract keeps the
# territory it was cut with until its next firing.
root partial datasource usbvn_osm_tree_info extends tree_partition (
    data_source: usbvn_source,
    species: ?raw_species,
)
complete where city = 'USBVN' and usbvn_source = 'OSM_USBVN'
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/usbvn_osm_staging.parquet`
where (raw_latitude >= 45.4246 and raw_latitude < 45.543 and raw_longitude >= -122.8778 and raw_longitude < -122.7436);


# --- Cross-source dedup and attribute merge --------------------------------
#
# Shared: ../tree_dedup.preql groups the partitions into one cluster per
# tree and picks each canonical attribute across the cluster; this city's grid
# cell size lives in DEDUP_CELL_METRES in shared/ingest.py.
merge merged_dbh into diameter_at_breast_height;
merge merged_latitude into latitude;
merge merged_longitude into longitude;


# The published target extends ../tree_dedup.preql's `published_tree_info`:
# the canonical columns, the prune, and the guard that refuses a build which
# lost a quarter of the city.  The two `@source_kept` lines are the same guard
# per bulk source (`test_every_city_refuses_a_collapsed_build`).
partial datasource beaverton_tree_info extends published_tree_info (
    data_source: usbvn_source,
    ?species,
    usbvn_published_data_updated_through,
)
complete where city = 'USBVN'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/usbvn_tree_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/usbvn_tree_info_v{data_version}.parquet`
freshness by usbvn_published_data_updated_through
assert @source_kept(tree_id, usbvn_source, 'BEAVERTON', 0.75)
assert @source_kept(tree_id, usbvn_source, 'OSM_USBVN', 0.75);
