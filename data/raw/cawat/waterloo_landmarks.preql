import ..landmark_common;

root datasource waterloo_landmarks_update_time (
    data_updated_through: cawat_landmark_data_updated_through
)
file `./waterloo_landmarks_probe.py`;

# Waterloo's (Ontario) Municipal Heritage Register (Part IV and Part V
# designations and listed non-designated properties), read live off the
# City's open-data layer -- an official register, so no geocoding and
# nothing to stage.
root partial datasource raw_waterloo_landmark_info extends landmark_partition (
    address: ?address,
    year_built: ?year_built,
    property_type: ?property_type,
)
complete where city = 'CAWAT'
file `./waterloo_landmarks.py`;

partial datasource waterloo_landmark_info extends published_landmark_info (
    ?address,
    ?year_built,
    ?property_type,
    cawat_landmark_data_updated_through,
)
complete where city = 'CAWAT'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/cawat_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/cawat_landmark_info_v{data_version}.parquet`
freshness by cawat_landmark_data_updated_through;
