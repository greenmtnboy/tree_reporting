# The browser projection: one small parquet per city holding exactly the
# rows and columns the map's worker keeps resident, so a city opens with one
# scan and no joins.
#
# The worker used to assemble this shape itself on every visit: the city's
# published inventory, a LEFT JOIN to the enrichment table for the display
# name and growth form, a LEFT JOIN to the crown-prediction slice for the
# predicted width, and a vocabulary pass per string column. In DuckDB-wasm
# the heap keeps whatever those joins grew it to, and on NYC the predictions
# join alone was a third of the load's transient (docs/MOBILE_LOAD_BUDGET.md).
# Resolving the joins here, once a day, takes them out of every phone's
# budget; the map falls back to assembling the shape itself only for a city
# whose projection has not been published yet.
#
# Inputs are the three published parquets this job must never rebuild, each
# reached through its root `_source.preql` view: the rollup (`full_tree_info`),
# the enrichment table (`tree_enrichment`) and the predictions
# (`tree_predictions`). The views are named like the managed datasources that
# write them, which is the edge trilogy-cloud orders the tick by, so this job
# runs after all three producers (test_browser_projection.py pins the names).
#
# What each column is:
#   display_name   the enrichment table's first common name, else the name the
#                  source recorded, else the species. The sentinels (`Unknown`,
#                  `Palm`, ...) have authored enrichment rows (ingest.py,
#                  SENTINEL_ENRICHMENT), so they label themselves the same way.
#   tree_form      the enrichment growth form, `default` where there is none;
#                  the icon and the default colour are chosen from it.
#   tree_name      the source's own name field, unchanged.
#   predicted_crown_width_m  tree_predictions' allometric estimate; null for a
#                  tree the model could not size (a palm, or no diameter and
#                  no planting date).
#
# Rows are written along a Hilbert curve over (latitude, longitude), in row
# groups of 10,240. The phone's window filters on a lat/long box
# (windowStagingSql in src/src/workers/cityTables.ts), and DuckDB skips every
# row group whose footer min/max falls outside it, so a window load reads the
# few groups near the camera instead of the whole file. 10,240 rather than
# 20,480 because it prunes better for a little more footer; the arithmetic is
# in docs/TRILOGY_ORDER_BY_SPEC.md. The sort key is computed for the write and
# not stored. Trees with no position sort last (the index is null).
#
# Every city in MUNICIPAL_DATA_SOURCES has exactly one projection
# (test_cloud_jobs.py::test_browser_projections_cover_every_city); new_city.py
# appends one.

import std.geography;
import tree_common;
import full_tree_info_source;
import tree_enrichment_source;
import tree_predictions_source;

# What the map shows where a common name goes, and the growth form the icon
# and default colour are chosen from (never null).
auto display_name <- coalesce(nullif(trim(common_names[1]), ''), nullif(trim(tree_name), ''), species);
auto browser_tree_form <- coalesce(tree_form, 'default');

# Every projection is this, scoped to one city and written to its own file.
# One that would lose a quarter of its city's rows is refused, keeping the
# published one (`kept`, core.preql).
template datasource city_tree_browser (
    tree_id,
    city,
    data_source,
    species,
    cultivar: ?cultivar,
    tree_name: ?tree_name,
    display_name,
    tree_form: browser_tree_form,
    plant_date: ?plant_date,
    diameter_at_breast_height: ?diameter_at_breast_height,
    crown_width_m: ?crown_width_m,
    predicted_crown_width_m: ?predicted_crown_width_m,
    latitude: ?latitude,
    longitude: ?longitude,
    submission_photo_url: ?submission_photo_url,
    prediction_inputs_published_through,
)
grain (tree_id)
freshness by prediction_inputs_published_through
order by @hilbert_index(latitude, longitude) asc nulls last
storage (row_group_size = 10240)
assert @kept(tree_id, 0.75);

# The vocabularies the worker types the projection's string columns with: one
# row per distinct (data_source, species, cultivar, tree_name, display_name)
# with its tree count, in a file of a few thousand rows beside the
# projection. A windowed phone needs every value before its first window
# (a value first met in the fifth cell must already be in the ENUM), and a
# SELECT DISTINCT over the projection reads most of the file: DuckDB-wasm
# fetches 4 and 16 MiB blocks, and a 10,240-row group's string chunk is a few
# KB, so each block spans every column (71 of Boston's 71 MB). The worker
# trusts the file only when its tree counts sum to the projection's row count
# (from the projection's footer) and scans the projection otherwise. Built by
# the same job, from the same inputs, as the projection beside it.
auto vocab_tree_count <- count(tree_id);
# The projection's watermark, one value per city. The per-tree column is null
# for a tree with no prediction row, and grouping by it would split a value's
# count in two.
auto vocab_inputs_published_through <- max(prediction_inputs_published_through) by city;

template datasource city_tree_vocab (
    city,
    data_source,
    species,
    cultivar: ?cultivar,
    tree_name: ?tree_name,
    display_name,
    tree_count: vocab_tree_count,
    inputs_published_through: vocab_inputs_published_through,
)
grain (city, data_source, species, cultivar, tree_name, display_name)
freshness by vocab_inputs_published_through;

partial datasource arbue_tree_browser extends city_tree_browser ()
complete where city = 'ARBUE'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/arbue_tree_browser_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/arbue_tree_browser_v{data_version}.parquet`;

