import ..tree_common;
import ..community_tree_info;

auto usbtv_published_data_updated_through <- greatest(usbtv_data_updated_through, usbtv_community_data_updated_through, usbtv_osm_data_updated_through);

key usbtv_source enum<string>['BURLINGTON_OPENDATA', 'COMMUNITY_USBTV', 'OSM_USBTV']; # originating dataset for the row

root datasource burlington_update_time (
    data_updated_through: usbtv_data_updated_through
)
file `./burlington_update_time.py`;

# Only this city's column, so an approval elsewhere does not mark USBTV's
# Parquet stale. Trilogy probes this as MAX over the one column.
root datasource usbtv_community_update_time (
    usbtv_community_data_updated_through: usbtv_community_data_updated_through
)
file `../community_update_time.py`;




# GCS publication time of the staged OSM parquet (see burlington_osm_extract.py);
# it only moves when an extraction is re-run and uploaded.
root datasource usbtv_osm_update_time (
    data_updated_through: usbtv_osm_data_updated_through
)
file `./burlington_osm_probe.py`;

# OpenStreetMap trees, read from the staged parquet in GCS rather than
# Overpass -- extraction is decoupled from refresh (see _osm_shared.py and
# EXTENDING.md).  Overlapping rows are kept and flagged via
# usbtv_is_duplicate below, never dropped: the Parquet must contain the union
# of its declared sources, and the flag keeps the dedup tunable and auditable.
root partial datasource usbtv_osm_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: usbtv_source,
    species: ?species,
    tree_name: ?tree_name,
    plant_date: ?plant_date,
    latitude: ?latitude,
    longitude: ?longitude,
    diameter_at_breast_height: ?diameter_at_breast_height,
    submission_photo_url: ?submission_photo_url,
)
grain (tree_id)
complete where city = 'USBTV' and usbtv_source = 'OSM_USBTV'
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/usbtv_osm_staging.parquet`;

root partial datasource burlington_raw_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: usbtv_source,
    species: species,
    tree_name: ?tree_name,
    plant_date: ?plant_date,
    latitude: ?latitude,
    longitude: ?longitude,
    diameter_at_breast_height: ?diameter_at_breast_height,
    submission_photo_url: ?submission_photo_url,
)
grain (tree_id)
complete where city = 'USBTV' and usbtv_source = 'BURLINGTON_OPENDATA'
file `./burlington_tree_info.py`;


# Approved community submissions for this city. The shared ingest script
# emits every city's rows; the `complete where` clause narrows it to USBTV
# and makes it a disjoint partition alongside burlington_raw_tree_info.
root partial datasource usbtv_community_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: usbtv_source,
    species: species,
    tree_name: ?tree_name,
    plant_date: ?plant_date,
    diameter_at_breast_height: ?diameter_at_breast_height,
    latitude: ?latitude,
    longitude: ?longitude,
    submission_photo_url: ?submission_photo_url,
)
grain (tree_id)
complete where city = 'USBTV' and usbtv_source = 'COMMUNITY_USBTV'
file `../community_tree_info.py`
where city = 'USBTV';


# --- Cross-source dedup: stack + aggregate over four staggered grids -------
#
# Same construction as ustem/tempe_tree_info.preql (full rationale there and in
# EXTENDING.md): an OSM row is a duplicate when a non-OSM tree shares its
# ~10m grid cell in ANY of four half-cell-staggered grid copies -- a guaranteed
# match within 5m, possible out to a ~14m diagonal.
#
# The 10m cell is PROVISIONAL until this city is calibrated:
#     cd data/raw && uv run osm_dedup_validation.py --city USBTV
# The break between re-mapped duplicates and interstitial neighbours sits
# wherever this city's OSM positional error ends and its planting spacing
# begins, so it has to be measured rather than copied from Tempe.
#
# Cell sizes: 10m of latitude is 10/111320 deg; longitude shrinks by
# cos(44.48 deg) here.
const usbtv_cell_lat_deg <- 0.00008983;
const usbtv_cell_lon_deg <- 0.00012589;

auto usbtv_cell_a <- concat(cast(floor(longitude / usbtv_cell_lon_deg) as string), ':', cast(floor(latitude / usbtv_cell_lat_deg) as string));
auto usbtv_cell_b <- concat(cast(floor(longitude / usbtv_cell_lon_deg + 0.5) as string), ':', cast(floor(latitude / usbtv_cell_lat_deg) as string));
auto usbtv_cell_c <- concat(cast(floor(longitude / usbtv_cell_lon_deg) as string), ':', cast(floor(latitude / usbtv_cell_lat_deg + 0.5) as string));
auto usbtv_cell_d <- concat(cast(floor(longitude / usbtv_cell_lon_deg + 0.5) as string), ':', cast(floor(latitude / usbtv_cell_lat_deg + 0.5) as string));

auto usbtv_anchor_count_a <- count(tree_id ? usbtv_source != 'OSM_USBTV') by usbtv_cell_a;
auto usbtv_anchor_count_b <- count(tree_id ? usbtv_source != 'OSM_USBTV') by usbtv_cell_b;
auto usbtv_anchor_count_c <- count(tree_id ? usbtv_source != 'OSM_USBTV') by usbtv_cell_c;
auto usbtv_anchor_count_d <- count(tree_id ? usbtv_source != 'OSM_USBTV') by usbtv_cell_d;

auto usbtv_is_duplicate <- usbtv_source = 'OSM_USBTV' and (
    usbtv_anchor_count_a > 0
    or usbtv_anchor_count_b > 0
    or usbtv_anchor_count_c > 0
    or usbtv_anchor_count_d > 0
);

partial datasource burlington_tree_info (
    tree_id,
    city,
    data_source: usbtv_source,
    species,
    ?tree_name,
    ?plant_date,
    ?diameter_at_breast_height,
    ?latitude,
    ?longitude,
    ?submission_photo_url,
    is_duplicate: usbtv_is_duplicate,
    usbtv_published_data_updated_through,
)
grain (tree_id)
complete where city = 'USBTV'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/usbtv_tree_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/usbtv_tree_info_v{data_version}.parquet`
freshness by usbtv_published_data_updated_through;
