import ..tree_common;
import ..community_tree_info;

auto usbtv_published_data_updated_through <- greatest(usbtv_data_updated_through, usbtv_community_data_updated_through);

key usbtv_source enum<string>['BURLINGTON_OPENDATA', 'COMMUNITY_USBTV']; # originating dataset for the row

root datasource burlington_update_time (
    data_updated_through: usbtv_data_updated_through
)
file `./burlington_update_time.py`;

# Only this city's column, so an approval elsewhere does not mark USBTV's
# Parquet stale. Trilogy probes this as MAX over the one column.
root datasource usbtv_community_update_time (
    usbtv_community_data_updated_through: usbtv_community_data_updated_through
)
file `../community_update_time.py`;


# This city has no OpenStreetMap partition, so no row can be a cross-source
# duplicate.  The column is still emitted as a constant so every city's Parquet
# carries `is_duplicate` and the browser worker can select it unconditionally;
# a per-city column set is what forces the worker into city-specific SQL.
# A city that later gains an OSM partition replaces this with the staggered-grid
# derivation in ustem/tempe_tree_info.preql.
auto usbtv_is_duplicate <- False;

root partial datasource burlington_raw_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: usbtv_source,
    species: species,
    tree_name: ?tree_name,
    plant_date: ?plant_date,
    latitude: ?latitude,
    longitude: ?longitude,
    diameter_at_breast_height: ?diameter_at_breast_height,
    submission_photo_url: ?submission_photo_url,
)
grain (tree_id)
complete where city = 'USBTV' and usbtv_source = 'BURLINGTON_OPENDATA'
file `./burlington_tree_info.py`;


# Approved community submissions for this city. The shared ingest script
# emits every city's rows; the `complete where` clause narrows it to USBTV
# and makes it a disjoint partition alongside burlington_raw_tree_info.
root partial datasource usbtv_community_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: usbtv_source,
    species: species,
    tree_name: ?tree_name,
    plant_date: ?plant_date,
    diameter_at_breast_height: ?diameter_at_breast_height,
    latitude: ?latitude,
    longitude: ?longitude,
    submission_photo_url: ?submission_photo_url,
)
grain (tree_id)
complete where city = 'USBTV' and usbtv_source = 'COMMUNITY_USBTV'
file `../community_tree_info.py`
where city = 'USBTV';

partial datasource burlington_tree_info (
    tree_id,
    city,
    data_source: usbtv_source,
    species,
    ?tree_name,
    ?plant_date,
    ?diameter_at_breast_height,
    ?latitude,
    ?longitude,
    ?submission_photo_url,
    is_duplicate: usbtv_is_duplicate,
    usbtv_published_data_updated_through,
)
grain (tree_id)
complete where city = 'USBTV'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/usbtv_tree_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/usbtv_tree_info_v{data_version}.parquet`
freshness by usbtv_published_data_updated_through;
