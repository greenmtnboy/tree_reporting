import ..landmark_common;

root datasource burlington_landmarks_update_time (
    data_updated_through: usbtv_landmark_data_updated_through
)
file `./burlington_landmarks_probe.py`;

root partial datasource raw_burlington_landmark_info (
    landmark_id: landmark_id,
    city: city,
    name: name,
    geometry_raw: ?geometry_raw,
)
grain (landmark_id)
complete where city = 'USBTV'
file `./burlington_landmarks.csv`;

partial datasource burlington_landmark_info (
    landmark_id,
    city,
    name,
    ?geometry,
    ?latitude,
    ?longitude,
    usbtv_landmark_data_updated_through,
)
grain (landmark_id)
complete where city = 'USBTV'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/usbtv_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/usbtv_landmark_info_v{data_version}.parquet`
freshness by usbtv_landmark_data_updated_through;
