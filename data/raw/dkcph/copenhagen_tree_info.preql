import ..tree_common;
import ..community_tree_info;
import ..tree_dedup;

auto dkcph_published_data_updated_through <- greatest(dkcph_data_updated_through, dkcph_community_data_updated_through, dkcph_osm_data_updated_through);

key dkcph_source enum<string>['COPENHAGEN_OPENDATA', 'COMMUNITY_DKCPH', 'OSM_DKCPH']; # originating dataset for the row

# Feed the shared cross-source merge (../tree_dedup.preql): it classifies rows
# by the label's prefix and records provenance from it.
auto dkcph_source_label <- concat(dkcph_source, '');
merge dkcph_source_label into source_label;

root datasource copenhagen_update_time (
    data_updated_through: dkcph_data_updated_through
)
file `./copenhagen_update_time.py`;

# Only this city's column, so an approval elsewhere does not mark DKCPH's
# Parquet stale. Trilogy probes this as MAX over the one column.
root datasource dkcph_community_update_time (
    dkcph_community_data_updated_through: dkcph_community_data_updated_through
)
file `../community_update_time.py`;

# GCS publication time of the staged OSM parquet; it only moves when an
# extraction is re-run and uploaded. Not a local mtime -- git does not preserve
# it, so a committed staging file makes every fresh clone look like new data.
root datasource dkcph_osm_update_time (
    data_updated_through: dkcph_osm_data_updated_through
)
file `./copenhagen_osm_probe.py`;

root partial datasource copenhagen_raw_tree_info extends tree_partition (
    data_source: dkcph_source,
    borough: ?borough,
)
complete where city = 'DKCPH' and dkcph_source = 'COPENHAGEN_OPENDATA'
file `./copenhagen_tree_info.py`;


# Approved community submissions for this city. The shared ingest script emits
# every city's rows; the `complete where` clause narrows it to DKCPH and makes
# it a disjoint partition, and the `where` clause is what actually filters --
# `complete where` asserts, it does not promise a predicate.
root partial datasource dkcph_community_tree_info extends tree_partition (
    data_source: dkcph_source,
    borough: ?borough,
)
complete where city = 'DKCPH' and dkcph_source = 'COMMUNITY_DKCPH'
file `../community_tree_info.py`
where city = 'DKCPH';


# OpenStreetMap trees, read from the staged parquet in GCS rather than Overpass
# -- extraction is decoupled from refresh. OSM overlaps the municipal inventory
# by construction; the overlap is resolved by ../tree_dedup.preql.
root partial datasource dkcph_osm_tree_info extends tree_partition (
    data_source: dkcph_source,
    borough: ?borough,
)
complete where city = 'DKCPH' and dkcph_source = 'OSM_DKCPH'
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/dkcph_osm_staging.parquet`;


# --- Cross-source dedup and attribute merge --------------------------------
#
# Shared: ../tree_dedup.preql groups the three partitions into one cluster per
# tree and picks each canonical attribute across the cluster; this city's grid
# cell size and its calibration live in DEDUP_CELL_METRES in shared/ingest.py.
# The only per-city line is the dbh merge, because Boston imputes it.
merge merged_dbh into diameter_at_breast_height;
# Position: the survivor's own point.  A city with an Overture lookup imports
# ../tree_position.preql instead, which merges the corrected point.
merge merged_latitude into latitude;
merge merged_longitude into longitude;


partial datasource copenhagen_tree_info extends published_tree_info (
    data_source: dkcph_source,
    ?borough,
    dkcph_published_data_updated_through,
)
complete where city = 'DKCPH'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/dkcph_tree_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/dkcph_tree_info_v{data_version}.parquet`
freshness by dkcph_published_data_updated_through
assert @source_kept(tree_id, dkcph_source, 'COPENHAGEN_OPENDATA', 0.75)
assert @source_kept(tree_id, dkcph_source, 'OSM_DKCPH', 0.75);
