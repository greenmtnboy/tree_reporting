# The app's landmark model: what the browser's chat resolves landmark
# questions against, imported under an alias (`landmark`, MAP_CHAT_IMPORTS in
# src/src/composables/chatModelImports.ts) so its `name`, `latitude` and
# `longitude` never meet the trees' concepts of the same names.
#
# It reads the published cross-city union (`full_landmark_publish.preql`, the
# `publish-landmarks` job) and nothing else, so it is no job's entrypoint and
# carries no `freshness by`. It used to import every city's landmark build
# model, which put every city's portal script, partition and watermark into
# each resolver request to read one table that already holds all of them.
#
# The vocabulary is declared here rather than imported from landmark_common,
# for the reason full_landmark_publish.preql gives: there `latitude` and
# `longitude` are derived from `geometry_raw`, a column the union does not
# carry. The per-city registers' own attributes (SF's `year_built`, Paris's
# `arrondissement`, ...) are in their city parquets, not the union, and are
# not exposed here.

import std.geography;
import core;

key landmark_id string; # city-prefixed unique identifier (sf-<objectid>, nyc-<lm_id>)
property landmark_id.name string; # the landmark's name, as its register gives it
property landmark_id.latitude float::latitude; # latitude of the landmark's centroid
property landmark_id.longitude float::longitude; # longitude of the landmark's centroid

root datasource full_landmark_info (
    landmark_id: landmark_id,
    city: city,
    name: name,
    latitude: ?latitude,
    longitude: ?longitude,
)
grain (landmark_id)
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/full_landmark_info_v{data_version}.parquet`;
