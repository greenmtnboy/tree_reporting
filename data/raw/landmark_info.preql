# Per-city landmark refresh: every city's landmark model, imported so that one
# `refresh-landmarks` job rebuilds all forty-one published parquets.
#
# Each city's published target is its own managed asset, so a portal outage
# fails that city and leaves the other forty alone -- which is the whole reason
# the cross-city union moved out to `full_landmark_publish.preql`.
#
# Unlike the tree lane there is no per-city landmark job: the fetch is a bespoke
# script per city rather than one shared module, so splitting this forty-one ways
# is a code-sharing job first. See "Landmarks are still one refresh lane" in
# EXTENDING.md.

import landmark_common;
import ussfo.sf_landmarks;
import usnyc.nyc_landmarks;
import usbos.boston_landmarks;
import frpar.paris_landmarks;
import usbtv.burlington_landmarks;
import cavan.vancouver_landmarks;
import deber.berlin_landmarks;
import nlams.amsterdam_landmarks;
import gblon.london_landmarks;
import aumel.melbourne_landmarks;
import arbue.buenosaires_landmarks;
import uslax.losangeles_landmarks;
import uswas.washingtondc_landmarks;
import ustem.tempe_landmarks;
import grath.athens_landmarks;
import grmlo.milos_landmarks;
import grsan.santorini_landmarks;
import usden.denver_landmarks;
import cacal.calgary_landmarks;
import caedm.edmonton_landmarks;
import cawpg.winnipeg_landmarks;
import cator.toronto_landmarks;
import camtl.montreal_landmarks;
import caque.quebec_landmarks;
import calon.longueuil_landmarks;
import cahfx.halifax_landmarks;
import cakgn.kingston_landmarks;
import calet.lethbridge_landmarks;
import cavic.victoria_landmarks;
import cakel.kelowna_landmarks;
import canwe.new_westminster_landmarks;
import camis.mississauga_landmarks;
import caott.ottawa_landmarks;
import cabur.burlington_on_landmarks;
import caajx.ajax_landmarks;
import camon.moncton_landmarks;
import jptyo.tokyo_landmarks;
import cobog.bogota_landmarks;
import twtpe.taipei_landmarks;
import dkcph.copenhagen_landmarks;
import fihel.helsinki_landmarks;

# The cross-city union is NOT declared here. It lives in
# `full_landmark_publish.preql`, which reads the parquets these imports publish
# and reaches no portal at all -- see that file's header for the outage this
# separation fixes. Refreshing this entrypoint refreshes the forty-one city
# parquets and nothing else, so one city's portal being unwell fails one asset
# instead of the union.
