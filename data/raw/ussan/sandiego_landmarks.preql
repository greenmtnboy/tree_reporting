import ..landmark_common;

root datasource sandiego_landmarks_update_time (
    data_updated_through: ussan_landmark_data_updated_through
)
file `./sandiego_landmarks_probe.py`;

# The City of San Diego's Historical Resources Board register (designated
# historical resources, on the same ArcGIS Server as the trees; the layer gives
# each resource only its HRB number) and the National Park Service's National
# Register listings in San Diego -- registers read live, so no Nominatim
# geocoding, no committed CSV and no staging object.  `lm_type` names the
# register and `register_number` the HRB number (`HRB 680`) or the NRIS
# reference number.
root partial datasource raw_sandiego_landmark_info extends landmark_partition (
    address: ?address,
    lm_type: ?lm_type,
    register_number: ?register_number,
    year_designated: ?year_designated,
)
complete where city = 'USSAN'
file `./sandiego_landmarks.py`;

partial datasource sandiego_landmark_info extends published_landmark_info (
    ?address,
    ?lm_type,
    ?register_number,
    ?year_designated,
    ussan_landmark_data_updated_through,
)
complete where city = 'USSAN'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/ussan_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/ussan_landmark_info_v{data_version}.parquet`
freshness by ussan_landmark_data_updated_through;
