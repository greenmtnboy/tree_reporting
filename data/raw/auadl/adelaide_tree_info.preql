import ..tree_common;
import ..community_tree_info;
import ..tree_dedup;

property <*>.adelaide_city_data_updated_through datetime; # when the City of Adelaide's street-tree CSV is through
property <*>.unley_data_updated_through datetime; # when the City of Unley's Street Trees layer is through
property <*>.burnside_data_updated_through datetime; # when the City of Burnside's street-trees resource on data.sa.gov.au is through

auto auadl_published_data_updated_through <- greatest(auadl_data_updated_through, auadl_community_data_updated_through, auadl_osm_data_updated_through);
auto auadl_data_updated_through <- greatest(adelaide_city_data_updated_through, unley_data_updated_through, burnside_data_updated_through);

# The City of Adelaide plus two neighbouring councils inside AUADL's
# territory, each its own municipal partition (the Melbourne pattern).
key auadl_source enum<string>['ADELAIDE_OPENDATA', 'UNLEY', 'BURNSIDE', 'COMMUNITY_AUADL', 'OSM_AUADL']; # originating dataset for the row

# Feed the shared cross-source merge (../tree_dedup.preql): it classifies rows
# by the label's prefix and records provenance from it.
auto auadl_source_label <- concat(auadl_source, '');
merge auadl_source_label into source_label;

root datasource adelaide_update_time (
    data_updated_through: adelaide_city_data_updated_through
)
file `./adelaide_update_time.py`;

# Unley's probe is its ArcGIS layer's own dataLastEditDate; Burnside's is the
# data.sa.gov.au resource's data watermark (shared/platforms/ckan.py
# `data_last_modified`).
root datasource unley_update_time (
    data_updated_through: unley_data_updated_through
)
file `./unley_update_time.py`;

root datasource burnside_update_time (
    data_updated_through: burnside_data_updated_through
)
file `./burnside_update_time.py`;

# Only this city's column, so an approval elsewhere does not mark AUADL's
# Parquet stale. Trilogy probes this as MAX over the one column.
root datasource auadl_community_update_time (
    auadl_community_data_updated_through: auadl_community_data_updated_through
)
file `../community_update_time.py`;

# GCS publication time of the staged OSM parquet; it only moves when an
# extraction is re-run and uploaded. Not a local mtime -- git does not preserve
# it, so a committed staging file makes every fresh clone look like new data.
root datasource auadl_osm_update_time (
    data_updated_through: auadl_osm_data_updated_through
)
file `./adelaide_osm_probe.py`;

# Every partition extends ../tree_dedup.preql's `tree_partition`, which maps
# the shared raw_* columns; a source that names a column differently re-binds
# it here (`dbh: ?raw_dbh`).
root partial datasource adelaide_raw_tree_info extends tree_partition (
    data_source: auadl_source,
)
complete where city = 'AUADL' and auadl_source = 'ADELAIDE_OPENDATA'
file `./adelaide_tree_info.py`;

# The two neighbouring councils.  Unley shares Greenhill Road and the south
# Park Lands' edge with the City of Adelaide and Burnside shares Greenhill
# Road with Unley, so a boundary-street tree can appear in two inventories;
# the cross-source merge never joins two municipal rows, so such a pair stays
# two rows.  Burnside publishes no crown spread (the template binds it; the
# column is emitted null).
root partial datasource unley_raw_tree_info extends tree_partition (
    data_source: auadl_source,
)
complete where city = 'AUADL' and auadl_source = 'UNLEY'
file `./unley_tree_info.py`;

root partial datasource burnside_raw_tree_info extends tree_partition (
    data_source: auadl_source,
)
complete where city = 'AUADL' and auadl_source = 'BURNSIDE'
file `./burnside_tree_info.py`;


# Approved community submissions for this city. The shared ingest script emits
# every city's rows; the `complete where` clause narrows it to AUADL and makes
# it a disjoint partition, and the `where` clause is what actually filters --
# `complete where` asserts, it does not promise a predicate.
root partial datasource auadl_community_tree_info extends tree_partition (
    data_source: auadl_source,
)
complete where city = 'AUADL' and auadl_source = 'COMMUNITY_AUADL'
file `../community_tree_info.py`
where city = 'AUADL';


# OpenStreetMap trees, read from the staged parquet in GCS rather than Overpass
# -- extraction is decoupled from refresh. OSM overlaps the municipal inventory
# by construction; the overlap is resolved by ../tree_dedup.preql. The `where`
# is the city's CITY_TERRITORY (tools/sync_osm_territory.py keeps it so): a
# staged extract keeps the territory it was cut with until its next firing.
root partial datasource auadl_osm_tree_info extends tree_partition (
    data_source: auadl_source,
)
complete where city = 'AUADL' and auadl_source = 'OSM_AUADL'
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/auadl_osm_staging.parquet`
where (raw_latitude >= -34.98 and raw_latitude < -34.88 and raw_longitude >= 138.56 and raw_longitude < 138.71);


# --- Cross-source dedup and attribute merge --------------------------------
#
# Shared: ../tree_dedup.preql groups the three partitions into one cluster per
# tree and picks each canonical attribute across the cluster; this city's grid
# cell size and its calibration live in DEDUP_CELL_METRES in shared/ingest.py.
# The per-city lines are the dbh merge, because Boston imputes it, and the
# position policy: a city with an Overture lookup imports ../tree_position.preql
# instead of the two position merges (see that file).
merge merged_dbh into diameter_at_breast_height;
merge merged_latitude into latitude;
merge merged_longitude into longitude;


# The published target extends ../tree_dedup.preql's `published_tree_info`:
# the canonical columns, the prune, and the guard that refuses a build which
# lost a quarter of the city.  The two `@source_kept` lines are the same guard
# per bulk source; add one for every municipal or OSM label in the enum
# (`test_every_city_refuses_a_collapsed_build`).
partial datasource adelaide_tree_info extends published_tree_info (
    data_source: auadl_source,
    auadl_published_data_updated_through,
)
complete where city = 'AUADL'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/auadl_tree_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/auadl_tree_info_v{data_version}.parquet`
freshness by auadl_published_data_updated_through
assert @source_kept(tree_id, auadl_source, 'ADELAIDE_OPENDATA', 0.75)
assert @source_kept(tree_id, auadl_source, 'UNLEY', 0.75)
assert @source_kept(tree_id, auadl_source, 'BURNSIDE', 0.75)
assert @source_kept(tree_id, auadl_source, 'OSM_AUADL', 0.75);
