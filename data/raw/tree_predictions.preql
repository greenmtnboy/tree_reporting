# Tree-level predictions: one row per published tree (imagery detections:
# see below), carrying what a model
# says about the tree rather than what a source recorded. Built by the
# `refresh-predictions` [[cloud.job]] in ../trilogy.toml, daily, in the same
# tick as the rest of the core and ordered after the jobs it consumes.
#
# It predicts crown width and height, from a measured diameter where the
# source recorded one and otherwise from a diameter predicted from the tree's
# age, and reserves `predicted_age_years`, published as null until a model
# exists. The map reads both predictions, through the browser projection, as
# the size of a tree's sprite.
#
# ---------------------------------------------------------------------------
# The models, and the stages they are built in
# ---------------------------------------------------------------------------
#
# The crown model is fitted offline on Tallo, a static reference dataset, and
# read from a CSV (tree_allometry_inputs.preql). The age and height models
# are fitted on every build, on the published trees, in two jobs before this
# one, and applied here from the tables they publish:
#
#     refresh-allometry-fits  allometry_fits.preql  the age fits; the height fit's sample
#     refresh-height-fits     height_fits.preql     the height fits, trimmed by their own band
#     refresh-predictions     this file             every tree, with the fits applied
#
# Each stage reads the one before it as stored columns. Fitted in one model,
# the height fit's band -- a per-tree test on the round before it -- nested
# every round's fit, and with it the shading test and the age model, inside
# every moment of the next round's: one column's SQL ran to 1.2 MB and took
# minutes to plan. allometry_common.preql has the arithmetic and the gates.
#
# ---------------------------------------------------------------------------
# The age fallback: a diameter for a tree that has a planting date and no DBH
# ---------------------------------------------------------------------------
#
# For a tree with a planting date and no diameter, `predicted_dbh_cm` stands
# in as the crown model's input, and `crown_dbh_source` says so.
#
# `predicted_dbh_cm` is published for every tree with an age, not only the
# ones that need it, so the trees with a measured diameter are the check on
# the fit. `age_years` is observed -- planting date to the day
# the parquet was built -- and `predicted_age_years` stays reserved for a
# model that infers age where no date was recorded.
#
# ---------------------------------------------------------------------------
# Stand density: carried, not applied
# ---------------------------------------------------------------------------
#
# `local_tree_density_per_ha` counts published trees in a 50 m grid cell
# around each tree (0.25 ha, so trees per hectare is the count times four).
# The grid is in degrees, with the longitude step scaled by the cosine of the
# cell's own latitude band -- a Taylor polynomial, since the planner has no
# `cos` -- so a cell is 50 m on both axes anywhere the map goes. It is a
# covariate for the curation stage to plot crown width against, and it does
# not enter the prediction; see the fit script for why no sourced model has
# a usable density term.
#
# ---------------------------------------------------------------------------
# Imagery detections: only the ones with a surveyed height
# ---------------------------------------------------------------------------
#
# A `PREDICTED_{code}` row is an unreviewed bulk detection: a crown and a
# point, no diameter, no planting date, a genus at best. Every prediction
# here comes out null for it, and its crown reaches the map from the rollup
# (`crown_width_m`), not from this table. What this table does carry for one
# is a LIDAR height -- the map reads `height_m` only through it -- so a
# detection under a surveyed crown keeps its row and the rest are left out,
# as they are of the density count. Boston's 2.4M detections (most of the
# rollup's growth since the North Shore patch) took this build to its
# worker's memory ceiling on 2026-11-10.
#
# Neither this file nor the files it imports is in the frontend's model
# bundle, and none may be: see tree_allometry_inputs.preql.

import tree_allometry_inputs;
import allometry_fits_source;

# --- Diameter from age --------------------------------------------------------
#
#     dbh_cm = scale * age_years ** b        (age clamped to [1, the fit's oldest tree])

# The tree's class's fit, and the fit over every tree, as read from the
# class table; then the one the tree takes.
auto dbh_class_passes <- @for_class(age_division_passes, age_fit_class);
auto dbh_class_n <- @for_class(age_division_n, age_fit_class);
auto dbh_class_a <- @for_class(age_division_a, age_fit_class);
auto dbh_class_b <- @for_class(age_division_b, age_fit_class);
auto dbh_class_sigma <- @for_class(age_division_sigma, age_fit_class);
auto dbh_class_xmax <- @for_class(age_division_xmax, age_fit_class);
auto dbh_all_n <- max(age_global_n) by *;
auto dbh_all_a <- max(age_global_a) by *;
auto dbh_all_b <- max(age_global_b) by *;
auto dbh_all_sigma <- max(age_global_sigma) by *;
auto dbh_all_xmax <- max(age_global_xmax) by *;

auto dbh_uses_genus <- case when genus is null then false else coalesce(age_genus_passes, false) end;
auto dbh_fallback_level <- @fallback_level(crown_fallback_class, coalesce(dbh_class_passes, false));
auto dbh_n <- @pick_fit(dbh_uses_genus, dbh_fallback_level, age_genus_n, dbh_class_n, dbh_all_n);
auto dbh_a <- @pick_fit(dbh_uses_genus, dbh_fallback_level, age_genus_a, dbh_class_a, dbh_all_a);
auto dbh_b <- @pick_fit(dbh_uses_genus, dbh_fallback_level, age_genus_b, dbh_class_b, dbh_all_b);
auto dbh_sigma <- @pick_fit(dbh_uses_genus, dbh_fallback_level, age_genus_sigma, dbh_class_sigma, dbh_all_sigma);
auto dbh_xmax <- @pick_fit(dbh_uses_genus, dbh_fallback_level, age_genus_xmax, dbh_class_xmax, dbh_all_xmax);
auto dbh_scale <- @fit_scale(dbh_a, dbh_sigma);
auto dbh_age_max_years <- 10 ** dbh_xmax;

# Clamped to [1 year, the fit's oldest tree], with the null case spelled out
# for the reason the crown clamp spells it out.
auto dbh_age_years <- case
    when age_years is null then null
    else least(greatest(age_years, 1.0), dbh_age_max_years)
end;

auto predicted_dbh_cm <- dbh_scale * (dbh_age_years ** dbh_b);

auto dbh_model_level <- case
    when age_years is null then 'none'
    when dbh_uses_genus then 'genus'
    when dbh_fallback_level is null then 'none'
    else dbh_fallback_level
end;
auto dbh_model_taxon <- case
    when dbh_model_level = 'none' then null
    when dbh_model_level = 'genus' then genus
    when dbh_model_level = 'global' then 'all'
    else crown_fallback_class
end;
auto dbh_model_n <- case when dbh_model_level = 'none' then null else dbh_n end;

# --- Crown width -----------------------------------------------------------

# What the crown model is applied to: the measured diameter, else the one
# predicted from age. `crown_dbh_source` records which.
auto crown_input_dbh_cm <- coalesce(dbh_cm, predicted_dbh_cm);
auto crown_dbh_source <- case
    when dbh_cm is not null then 'measured'
    when predicted_dbh_cm is not null then 'age'
    else null
end;

auto predicted_crown_width_m <- @crown_width_at(crown_input_dbh_cm);

# The observed crown, where a source recorded one (tree_common's crown_width_m:
# Tokyo's survey, an OSM diameter_crown tag, a reviewed satellite crown), is
# published beside the prediction rather than folded into it, so curation can
# plot one against the other and the prediction stays a prediction.

auto crown_model_level <- case
    when crown_input_dbh_cm is null then 'none'
    when crown_fit_scale is not null then crown_fit_level
    when crown_fallback_class = 'none' then 'none'
    else crown_fallback_level
end;
auto crown_model_taxon <- case
    when crown_model_level = 'none' then null
    when crown_fit_scale is not null then crown_fit_taxon
    else crown_fallback_class
end;
auto crown_model_n <- case
    when crown_model_level = 'none' then null
    when crown_fit_scale is not null then crown_fit_n
    else crown_fallback_n
end;

# --- Height ------------------------------------------------------------------
#
#     height_m = scale * dbh_cm ** b        (dbh clamped to [1, the fit's largest stem])
#
# Same input diameter as the crown, same fallbacks by growth form, same
# clamp. The observed height, where a city published one, is carried beside
# the prediction as `height_m` (tree_height_source.preql) and checked against
# it below.

auto height_class_passes <- @for_class(height_division_passes, height_fit_class);
auto height_class_a <- @for_class(height_division_a, height_fit_class);
auto height_class_b <- @for_class(height_division_b, height_fit_class);
auto height_class_sigma <- @for_class(height_division_sigma, height_fit_class);
auto height_class_xmax <- @for_class(height_division_xmax, height_fit_class);
auto height_all_a <- max(height_global_a) by *;
auto height_all_b <- max(height_global_b) by *;
auto height_all_sigma <- max(height_global_sigma) by *;
auto height_all_xmax <- max(height_global_xmax) by *;

auto height_uses_genus <- case when genus is null then false else coalesce(height_genus_passes, false) end;
auto height_fallback_level <- @fallback_level(crown_fallback_class, coalesce(height_class_passes, false));
auto height_a <- @pick_fit(height_uses_genus, height_fallback_level, height_genus_a, height_class_a, height_all_a);
auto height_b <- @pick_fit(height_uses_genus, height_fallback_level, height_genus_b, height_class_b, height_all_b);
auto height_sigma <- @pick_fit(height_uses_genus, height_fallback_level, height_genus_sigma, height_class_sigma, height_all_sigma);
auto height_xmax <- @pick_fit(height_uses_genus, height_fallback_level, height_genus_xmax, height_class_xmax, height_all_xmax);
auto height_scale <- @fit_scale(height_a, height_sigma);
auto height_dbh_max_cm <- 10 ** height_xmax;

# The null case spelled out for the reason the crown clamp spells it out.
auto height_dbh_cm <- case
    when crown_input_dbh_cm is null then null
    else least(greatest(crown_input_dbh_cm, 1.0), height_dbh_max_cm)
end;

# A palm gets no height, as it gets no crown: its trunk does not thicken with
# its height, and no palm stands under a Boston crown to fit.
auto predicted_height_m <- cast(height_scale * (height_dbh_cm ** height_b) as float);

# --- The gates on an observed height ---------------------------------------
#
# `shaded` is tree_allometry_inputs' test. `out_of_band`: the height is
# outside `height_band_sigmas` standard deviations of the height fit's log
# residual for the tree's fit, either way -- a geocode on a building edge, or
# on a shrub beside a mature tree. The band is the fit's own spread, so a
# genus that varies more is given more room.
#
# A tree whose stem nobody measured keeps its survey height, `unchecked`. A
# shaded or out-of-band tree falls back to its predicted height on the map;
# `height_m` keeps what the survey said, for curation.

# The band, as multiples of the bias-corrected prediction: the residual's
# bounds, less the correction the prediction already carries.
def height_gate(sigmas, s) -> 10 ** (sigmas * s - s ** 2 * ln_10 / 2);
auto height_gate_low <- @height_gate(-1 * height_band_sigmas, height_sigma);
auto height_gate_high <- @height_gate(height_band_sigmas, height_sigma);

auto height_check <- case
    when height_m is null then null
    when not height_stem_measured or predicted_height_m is null then 'unchecked'
    when height_shaded then 'shaded'
    when height_m > predicted_height_m * height_gate_high then 'out_of_band'
    when height_m < predicted_height_m * height_gate_low then 'out_of_band'
    else 'accepted'
end;

# The height the map draws: the survey's where it passed or could not be
# checked, else nothing, and the map falls back to predicted_height_m.
auto accepted_height_m <- case
    when height_check = 'accepted' or height_check = 'unchecked' then height_m
    else null
end;

# --- Stand density covariate ----------------------------------------------

const density_cell_lat_deg <- 0.000449; # 50 m of latitude
const density_cell_area_ha <- 0.25;

auto density_lat_index <- floor(latitude / density_cell_lat_deg);
# cos(latitude) of the cell's band, so every tree in a band shares one
# longitude step and the grid stays a grid: 1 - x^2/2 + x^4/24 - x^6/720,
# within 4e-5 of cos up to 60 degrees.
auto density_band_rad <- density_lat_index * density_cell_lat_deg * 3.141592653589793 / 180;
auto density_cos_lat <- 1 - (density_band_rad ** 2) / 2 + (density_band_rad ** 4) / 24 - (density_band_rad ** 6) / 720;
auto density_lon_index <- floor(longitude * density_cos_lat / density_cell_lat_deg);
# A tree with no coordinates lands in cell -1 rather than in a null cell, so
# the join back from the per-cell count keeps its row; its density is null.
auto density_cell <- coalesce(cast(density_lat_index as bigint) * 2000000 + cast(density_lon_index as bigint), -1);

# Inventory trees only: an imagery detection is not counted (see the header).
auto is_imagery_detection <- data_source like 'PREDICTED_%';
auto local_tree_density_per_ha <- case
    when density_cell = -1 then null
    else coalesce(count(tree_id ? not is_imagery_detection) by density_cell, 0) / density_cell_area_ha
end;

# --- Placeholder -------------------------------------------------------------
#
# Published as null until a model exists. Age is observed where a city
# publishes a planting date (`age_years`, above); a *predicted* age would be
# the inverse of the diameter-from-age fit, for a tree with a diameter and no
# date, and is not modelled yet.

# Written as a case over the tree's own diameter rather than a bare
# `cast(null as float)`: pytrilogy 0.3.353 treats a constant null as having
# no source and drops it from the persist projection ("would write 10 of 12
# declared columns"), while an expression over a tree column is carried.
auto predicted_age_years <- case when dbh_cm is null then cast(null as float) else cast(null as float) end;

# --- The published parquet ------------------------------------------------
#
# `is_imagery_detection`: a detection publishes a row only for its LIDAR
# height (see the header). `data_source` is stored because a target's `where`
# reads only what its columns store or derive row by row.
#
# `where tree_id is not null`: the enrichment source is partial, so the
# planner joins it with a FULL join, which keeps every tree (a species with
# no enrichment row yet is still predicted, on the angiosperm fallback) but
# also emits a row for every enrichment species and coefficient genus that no
# published tree carries. Those rows have no tree, and the grain says so.

datasource tree_predictions (
    tree_id,
    city,
    data_source,
    ?genus,
    ?dbh_cm,
    ?age_years,
    ?predicted_dbh_cm,
    dbh_model_level,
    ?dbh_model_taxon,
    ?dbh_model_n,
    ?crown_dbh_source,
    ?predicted_crown_width_m,
    ?crown_width_m,
    crown_model_level,
    ?crown_model_taxon,
    ?crown_model_n,
    ?local_tree_density_per_ha,
    ?predicted_height_m,
    ?height_m,
    ?height_crown_radius_m,
    ?height_check,
    ?accepted_height_m,
    ?predicted_age_years,
    prediction_inputs_published_through,
)
grain (tree_id)
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/tree_predictions_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/tree_predictions_v{data_version}.parquet`
where tree_id is not null and (not is_imagery_detection or height_m is not null)
freshness by prediction_inputs_published_through
# A city's rows vanishing from this build (its parquet unreadable or shed)
# fails it; see `kept_by` in core.preql.  Dropping a city on purpose takes
# one local `trilogy refresh --skip-validation tree_predictions` build.
assert @kept_by(tree_id, city, 0.75);
