import ..landmark_common;

root datasource longueuil_landmarks_update_time (
    data_updated_through: calon_landmark_data_updated_through
)
file `./longueuil_landmarks_probe.py`;

# Longueuil's 223 named parks and green spaces, on the same portal as the
# trees, with real polygons rather than points.  Read directly -- no Nominatim
# geocoding, no committed CSV and no staging object.
#
# Not the runbook's first preference, because the provincial designation
# registry holds only four Longueuil entries; see longueuil_landmarks.py.
root partial datasource raw_longueuil_landmark_info extends landmark_partition (
    property_type: ?property_type,
)
complete where city = 'CALON'
file `./longueuil_landmarks.py`;

partial datasource longueuil_landmark_info extends published_landmark_info (
    ?property_type,
    calon_landmark_data_updated_through,
)
complete where city = 'CALON'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/calon_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/calon_landmark_info_v{data_version}.parquet`
freshness by calon_landmark_data_updated_through;
