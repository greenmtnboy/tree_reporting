import ..landmark_common;

root datasource davenport_landmarks_update_time (
    data_updated_through: usdvn_landmark_data_updated_through
)
file `./davenport_landmarks_probe.py`;

# Davenport's Local Historic Landmarks (the City's Planning & Zoning layer on
# gis.davenportiowa.com) and the National Park Service's National Register
# listings in Davenport -- registers read live, so no Nominatim geocoding, no
# committed CSV and no staging object.  `lm_type` names the register and
# `register_number` the NRIS reference number (the local register publishes
# none).
root partial datasource raw_davenport_landmark_info extends landmark_partition (
    address: ?address,
    lm_type: ?lm_type,
    register_number: ?register_number,
    year_designated: ?year_designated,
)
complete where city = 'USDVN'
file `./davenport_landmarks.py`;

partial datasource davenport_landmark_info extends published_landmark_info (
    ?address,
    ?lm_type,
    ?register_number,
    ?year_designated,
    usdvn_landmark_data_updated_through,
)
complete where city = 'USDVN'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/usdvn_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/usdvn_landmark_info_v{data_version}.parquet`
freshness by usdvn_landmark_data_updated_through;
