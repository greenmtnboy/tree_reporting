import ..landmark_common;

root datasource fredericton_landmarks_update_time (
    data_updated_through: cafre_landmark_data_updated_through
)
file `./fredericton_landmarks_probe.py`;

# Fredericton's heritage preservation areas (St. Anne's Point, Queen Square,
# St. Mary's), read live off the City's own ArcGIS layer -- an official
# designation, so no geocoding and nothing to stage.
root partial datasource raw_fredericton_landmark_info extends landmark_partition (
    property_type: ?property_type,
)
complete where city = 'CAFRE'
file `./fredericton_landmarks.py`;

partial datasource fredericton_landmark_info extends published_landmark_info (
    ?property_type,
    cafre_landmark_data_updated_through,
)
complete where city = 'CAFRE'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/cafre_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/cafre_landmark_info_v{data_version}.parquet`
freshness by cafre_landmark_data_updated_through;
