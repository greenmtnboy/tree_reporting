import ..landmark_common;

root datasource sydney_landmarks_update_time (
    data_updated_through: ausyd_landmark_data_updated_through
)
file `./sydney_landmarks_probe.py`;

# Sydney's heritage places from two statutory registers, read live from the
# NSW Government's ArcGIS server for the City of Sydney LGA: the NSW State
# Heritage Register (State significance, listed curtilage polygons) and the
# local items of the Sydney LEP 2012 heritage schedule (and the Harold Park
# LEP 2011's three). No geocoding, no committed CSV and no staging object.
# `lm_type` names the register, `category` the SHR's kind of place (Built,
# Landscape, ...), and `register_number` the register's own number.
root partial datasource raw_sydney_landmark_info extends landmark_partition (
    address: ?address,
    category: ?category,
    lm_type: ?lm_type,
    register_number: ?register_number,
    year_designated: ?year_designated,
)
complete where city = 'AUSYD'
file `./sydney_landmarks.py`;

partial datasource sydney_landmark_info extends published_landmark_info (
    ?address,
    ?category,
    ?lm_type,
    ?register_number,
    ?year_designated,
    ausyd_landmark_data_updated_through,
)
complete where city = 'AUSYD'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/ausyd_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/ausyd_landmark_info_v{data_version}.parquet`
freshness by ausyd_landmark_data_updated_through;
