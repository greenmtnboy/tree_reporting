import ..landmark_common;

root datasource brest_landmarks_update_time (
    data_updated_through: frbes_landmark_data_updated_through
)
file `./brest_landmarks_probe.py`;

# Brest's protected monuments -- buildings classés or inscrits under the
# Monuments Historiques -- read from the Ministry of Culture's national Mérimée
# export (Licence Ouverte v2.0) and filtered to the 8 communes of Brest
# Métropole, the tree inventory's territory; see brest_landmarks.py.
# The register's own attributes ride along in existing landmark_common
# properties: the address, the protection (date and type, as Paris carries it)
# and the building type.
root partial datasource raw_brest_landmark_info extends landmark_partition (
    address: ?address,
    protection_type: ?protection_type,
    denomination: ?denomination,
)
complete where city = 'FRBES'
file `./brest_landmarks.py`;

partial datasource brest_landmark_info extends published_landmark_info (
    ?address,
    ?protection_type,
    ?denomination,
    frbes_landmark_data_updated_through,
)
complete where city = 'FRBES'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/frbes_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/frbes_landmark_info_v{data_version}.parquet`
freshness by frbes_landmark_data_updated_through;
