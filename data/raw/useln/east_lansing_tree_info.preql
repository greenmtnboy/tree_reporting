import ..tree_common;
import ..community_tree_info;
import ..tree_dedup;

# East Lansing's trees were OSM rows of Lansing's model (USLAN) under the
# rectangle Lansing had until #285 drew it to its Census line (issue #287).
# It is its own city now, its territory the city's real boundary
# (boundaries/useln.json), with the City's own inventory (Davey's survey and
# the City's inspections; no licence stated, displayed with attribution only)
# beside the community and OSM rows.

auto useln_published_data_updated_through <- greatest(useln_data_updated_through, useln_community_data_updated_through, useln_osm_data_updated_through);

key useln_source enum<string>['EAST_LANSING', 'COMMUNITY_USELN', 'OSM_USELN']; # originating dataset for the row

# Feed the shared cross-source merge (../tree_dedup.preql): it classifies rows
# by the label's prefix and records provenance from it.
auto useln_source_label <- concat(useln_source, '');
merge useln_source_label into source_label;

root datasource east_lansing_update_time (
    data_updated_through: useln_data_updated_through
)
file `./east_lansing_update_time.py`;

# Only this city's column, so an approval elsewhere does not mark USELN's
# Parquet stale. Trilogy probes this as MAX over the one column.
root datasource useln_community_update_time (
    useln_community_data_updated_through: useln_community_data_updated_through
)
file `../community_update_time.py`;

# GCS publication time of the staged OSM parquet; it only moves when an
# extraction is re-run and uploaded. Not a local mtime -- git does not preserve
# it, so a committed staging file makes every fresh clone look like new data.
root datasource useln_osm_update_time (
    data_updated_through: useln_osm_data_updated_through
)
file `./east_lansing_osm_probe.py`;

# Every partition extends ../tree_dedup.preql's `tree_partition`, which maps
# the shared raw_* columns; a source that names a column differently re-binds
# it here (`dbh: ?raw_dbh`).
root partial datasource east_lansing_raw_tree_info extends tree_partition (
    data_source: useln_source,
    species: ?raw_species,
)
complete where city = 'USELN' and useln_source = 'EAST_LANSING'
file `./east_lansing_tree_info.py`;


# Approved community submissions for this city. The shared ingest script emits
# every city's rows; the `complete where` clause narrows it to USELN and makes
# it a disjoint partition, and the `where` clause is what actually filters --
# `complete where` asserts, it does not promise a predicate.
root partial datasource useln_community_tree_info extends tree_partition (
    data_source: useln_source,
    species: ?raw_species,
)
complete where city = 'USELN' and useln_source = 'COMMUNITY_USELN'
file `../community_tree_info.py`
where city = 'USELN';


# OpenStreetMap trees, read from the staged parquet in GCS rather than Overpass
# -- extraction is decoupled from refresh. OSM overlaps the municipal inventory
# by construction; the overlap is resolved by ../tree_dedup.preql. The `where`
# is the city's CITY_TERRITORY (tools/sync_osm_territory.py keeps it so): a
# staged extract keeps the territory it was cut with until its next firing.
root partial datasource useln_osm_tree_info extends tree_partition (
    data_source: useln_source,
    species: ?raw_species,
)
complete where city = 'USELN' and useln_source = 'OSM_USELN'
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/useln_osm_staging.parquet`
where (raw_latitude >= 42.6969 and raw_latitude < 42.8019 and raw_longitude >= -84.5133 and raw_longitude < -84.4388);


# --- Cross-source dedup and attribute merge --------------------------------
#
# Shared: ../tree_dedup.preql groups the partitions into one cluster per
# tree and picks each canonical attribute across the cluster; this city's grid
# cell size and its calibration live in DEDUP_CELL_METRES in shared/ingest.py.
# The per-city lines are the dbh merge, because Boston imputes it, and the
# position policy: a city with an Overture lookup imports ../tree_position.preql
# instead of the two position merges (see that file).
merge merged_dbh into diameter_at_breast_height;
merge merged_latitude into latitude;
merge merged_longitude into longitude;


# The published target extends ../tree_dedup.preql's `published_tree_info`:
# the canonical columns, the prune, and the guard that refuses a build which
# lost a quarter of the city.  The two `@source_kept` lines are the same guard
# per bulk source; add one for every municipal or OSM label in the enum
# (`test_every_city_refuses_a_collapsed_build`).
partial datasource east_lansing_tree_info extends published_tree_info (
    data_source: useln_source,
    ?species,
    useln_published_data_updated_through,
)
complete where city = 'USELN'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/useln_tree_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/useln_tree_info_v{data_version}.parquet`
freshness by useln_published_data_updated_through
assert @source_kept(tree_id, useln_source, 'EAST_LANSING', 0.75)
assert @source_kept(tree_id, useln_source, 'OSM_USELN', 0.75);
