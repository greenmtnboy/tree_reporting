import ..tree_common;
import ..community_tree_info;
import ..tree_dedup;

# deber_osm_data_updated_through was dropped from this greatest() while
# gdi.berlin.de was serving its platform-wide maintenance page, and is now
# back. Both halves of that decision are worth keeping written down.
#
# WHY IT WAS DROPPED. A published watermark is the greatest across a city's
# sources, so any one fresh source marks the Parquet stale -- and a rebuild
# needs *every* partition, including the municipal one. Wiring Berlin's OSM
# partition therefore made the city permanently stale against a dead portal:
# every refresh tried to rebuild Berlin and failed. Note that this defeats a
# safeguard that looks like it should cover the case -- `emit_freshness`
# degrades an unreachable probe to the epoch so its city sits out the run, but
# the epoch loses every greatest(), so it only protects while *all* of a
# city's sources are quiet. One genuinely fresh source is enough to demand a
# rebuild that an unreachable source cannot satisfy.
#
# WHY IT IS BACK. The WFS serves data again (verified 2026-09-04:
# `TYPENAMES=baumbestand:strassenbaeume` returns HTTP 200 JSON with
# totalFeatures=434765), which is the condition the removal note named. The
# cost that motivated the removal has also shrunk: back then a failed Berlin
# rebuild took full_tree_info and tree_enrichment down with it as skipped
# dependencies, because all seventeen cities and the core shared one refresh.
# Since the per-city split they do not -- `city-deber` is its own job and the
# core reads only published parquets -- so a dead portal now reddens Berlin's
# own job and nothing else.
#
# Restoring the term is also what lets a fresh OSM extract reach Berlin at all:
# while it was out, re-running the extract did not mark the city stale, so the
# staged partition sat unread until something else rebuilt the city.
auto deber_published_data_updated_through <- greatest(deber_data_updated_through, deber_community_data_updated_through, deber_osm_data_updated_through);

key deber_source enum<string>['BERLIN_OPENDATA', 'COMMUNITY_DEBER', 'OSM_DEBER']; # originating dataset for the row

# Feed the shared cross-source merge (../tree_dedup.preql): it classifies rows
# by the label's prefix and records provenance from it.
auto deber_source_label <- concat(deber_source, '');
merge deber_source_label into source_label;

root datasource berlin_update_time (
    data_updated_through: deber_data_updated_through
)
file `./berlin_update_time.py`;

# Only this city's column, so an approval elsewhere does not mark DEBER's
# Parquet stale. Trilogy probes this as MAX over the one column.
root datasource deber_community_update_time (
    deber_community_data_updated_through: deber_community_data_updated_through
)
file `../community_update_time.py`;




# GCS publication time of the staged OSM parquet (see berlin_osm_extract.py);
# it only moves when an extraction is re-run and uploaded.
root datasource deber_osm_update_time (
    data_updated_through: deber_osm_data_updated_through
)
file `./berlin_osm_probe.py`;

# OpenStreetMap trees, read from the staged parquet in GCS rather than
# Overpass -- extraction is decoupled from refresh (see _osm_shared.py and
# EXTENDING.md).  Overlapping rows are resolved by the
# shared cluster merge (../tree_dedup.preql).
root partial datasource deber_osm_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: deber_source,
    species: ?raw_species,
    tree_name: ?raw_tree_name,
    plant_date: ?raw_plant_date,
    latitude: ?raw_latitude,
    longitude: ?raw_longitude,
    diameter_at_breast_height: ?raw_dbh,
    submission_photo_url: ?raw_photo_url,
)
grain (tree_id)
complete where city = 'DEBER' and deber_source = 'OSM_DEBER'
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/deber_osm_staging.parquet`;

root partial datasource berlin_raw_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: deber_source,
    species: raw_species,
    tree_name: ?raw_tree_name,
    plant_date: ?raw_plant_date,
    latitude: ?raw_latitude,
    longitude: ?raw_longitude,
    diameter_at_breast_height: ?raw_dbh,
    submission_photo_url: ?raw_photo_url,
)
grain (tree_id)
complete where city = 'DEBER' and deber_source = 'BERLIN_OPENDATA'
file `./berlin_tree_info.py`;


# Approved community submissions for this city. The shared ingest script
# emits every city's rows; the `complete where` clause narrows it to DEBER
# and makes it a disjoint partition alongside berlin_raw_tree_info.
root partial datasource deber_community_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: deber_source,
    species: raw_species,
    tree_name: ?raw_tree_name,
    plant_date: ?raw_plant_date,
    diameter_at_breast_height: ?raw_dbh,
    latitude: ?raw_latitude,
    longitude: ?raw_longitude,
    submission_photo_url: ?raw_photo_url,
)
grain (tree_id)
complete where city = 'DEBER' and deber_source = 'COMMUNITY_DEBER'
file `../community_tree_info.py`
where city = 'DEBER';



# --- Cross-source dedup and attribute merge --------------------------------
#
# Shared: ../tree_dedup.preql groups the three partitions into one cluster per
# tree and picks each canonical attribute across the cluster; this city's grid
# cell size and its calibration live in DEDUP_CELL_METRES in _ingest_shared.py.
# The only per-city line is the dbh merge, because Boston imputes it.
merge merged_dbh into diameter_at_breast_height;


# INTENDED END STATE: `where tree_id = cluster_id` on this target, so the
# parquet holds exactly one row per tree and needs no client-side filter; see
# "Intended end state" in ../tree_dedup.preql for what blocks it upstream.
partial datasource berlin_tree_info (
    tree_id,
    city,
    data_source: deber_source,
    species,
    ?tree_name,
    ?plant_date,
    ?diameter_at_breast_height,
    ?latitude,
    ?longitude,
    ?submission_photo_url,
    merged_sources,
    ?merged_tree_ids,
    is_duplicate,
    deber_published_data_updated_through,
)
grain (tree_id)
complete where city = 'DEBER'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/deber_tree_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/deber_tree_info_v{data_version}.parquet`
where tree_id = cluster_id
freshness by deber_published_data_updated_through;
