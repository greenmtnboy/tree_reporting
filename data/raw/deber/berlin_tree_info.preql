import ..tree_common;
import ..community_tree_info;

# deber_osm_data_updated_through is deliberately NOT in this greatest().
#
# A published watermark is the greatest across a city's sources, so any one
# fresh source marks the Parquet stale -- and a rebuild needs *every* partition,
# including the municipal one. Wiring Berlin's OSM partition therefore made the
# city permanently stale against a `gdi.berlin.de` that has been serving its
# maintenance page for days, so every refresh tried to rebuild Berlin, failed on
# the dead portal, and took full_tree_info and tree_enrichment down with it as
# skipped dependencies.
#
# This is worth being precise about, because it defeats a safeguard that looks
# like it should cover the case: `emit_freshness` degrades an unreachable
# probe to the epoch so its city sits out the run, but the epoch loses every
# greatest() -- and it only protects while *all* of a city's sources are quiet.
# One genuinely fresh source is enough to demand a rebuild that an unreachable
# source cannot satisfy.
#
# Dropping the OSM term restores that: Berlin's watermark is now the degrading
# municipal probe and the community column, so the city sits out cleanly while
# the portal is down and the other thirteen keep publishing.
#
# THE COST: re-running berlin_osm_extract.py no longer makes Berlin stale, so a
# fresh OSM extract is not picked up until something else rebuilds the city.
# Put the term back when gdi.berlin.de returns -- that is also the moment the
# municipal rebuild clears the 1,601 NULL species and 25 'Unbekannt' left in
# the hand-patched Parquet.
auto deber_published_data_updated_through <- greatest(deber_data_updated_through, deber_community_data_updated_through);

key deber_source enum<string>['BERLIN_OPENDATA', 'COMMUNITY_DEBER', 'OSM_DEBER']; # originating dataset for the row

root datasource berlin_update_time (
    data_updated_through: deber_data_updated_through
)
file `./berlin_update_time.py`;

# Only this city's column, so an approval elsewhere does not mark DEBER's
# Parquet stale. Trilogy probes this as MAX over the one column.
root datasource deber_community_update_time (
    deber_community_data_updated_through: deber_community_data_updated_through
)
file `../community_update_time.py`;




# GCS publication time of the staged OSM parquet (see berlin_osm_extract.py);
# it only moves when an extraction is re-run and uploaded.
root datasource deber_osm_update_time (
    data_updated_through: deber_osm_data_updated_through
)
file `./berlin_osm_probe.py`;

# OpenStreetMap trees, read from the staged parquet in GCS rather than
# Overpass -- extraction is decoupled from refresh (see _osm_shared.py and
# EXTENDING.md).  Overlapping rows are kept and flagged via
# deber_is_duplicate below, never dropped: the Parquet must contain the union
# of its declared sources, and the flag keeps the dedup tunable and auditable.
root partial datasource deber_osm_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: deber_source,
    species: ?species,
    tree_name: ?tree_name,
    plant_date: ?plant_date,
    latitude: ?latitude,
    longitude: ?longitude,
    diameter_at_breast_height: ?diameter_at_breast_height,
    submission_photo_url: ?submission_photo_url,
)
grain (tree_id)
complete where city = 'DEBER' and deber_source = 'OSM_DEBER'
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/deber_osm_staging.parquet`;

root partial datasource berlin_raw_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: deber_source,
    species: species,
    tree_name: ?tree_name,
    plant_date: ?plant_date,
    latitude: ?latitude,
    longitude: ?longitude,
    diameter_at_breast_height: ?diameter_at_breast_height,
    submission_photo_url: ?submission_photo_url,
)
grain (tree_id)
complete where city = 'DEBER' and deber_source = 'BERLIN_OPENDATA'
file `./berlin_tree_info.py`;


# Approved community submissions for this city. The shared ingest script
# emits every city's rows; the `complete where` clause narrows it to DEBER
# and makes it a disjoint partition alongside berlin_raw_tree_info.
root partial datasource deber_community_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: deber_source,
    species: species,
    tree_name: ?tree_name,
    plant_date: ?plant_date,
    diameter_at_breast_height: ?diameter_at_breast_height,
    latitude: ?latitude,
    longitude: ?longitude,
    submission_photo_url: ?submission_photo_url,
)
grain (tree_id)
complete where city = 'DEBER' and deber_source = 'COMMUNITY_DEBER'
file `../community_tree_info.py`
where city = 'DEBER';



# --- Cross-source dedup: stack + aggregate over four staggered grids -------
#
# Same construction as ustem/tempe_tree_info.preql (full rationale there and in
# EXTENDING.md): an OSM row is a duplicate when a non-OSM tree shares its
# ~10m grid cell in ANY of four half-cell-staggered grid copies -- a guaranteed
# match within 5m, possible out to a ~14m diagonal.
#
# CALIBRATED at 10m. This city's 5-10m band is 18.4% mutual-NN over
# n=12630 -- neighbour-dominated: a false flag hides a real tree
# while a missed duplicate only double-renders one, so a band that is not
# clearly duplicate-dominated should not be flagged. Re-check with:
#     cd data/raw && uv run ./osm_dedup_validation.py --city DEBER
#
# Cell sizes: 10m of latitude is 10/111320 deg; longitude shrinks by
# cos(52.50 deg) here.
const deber_cell_lat_deg <- 0.00008983;
const deber_cell_lon_deg <- 0.00014756;

auto deber_cell_a <- concat(cast(floor(longitude / deber_cell_lon_deg) as string), ':', cast(floor(latitude / deber_cell_lat_deg) as string));
auto deber_cell_b <- concat(cast(floor(longitude / deber_cell_lon_deg + 0.5) as string), ':', cast(floor(latitude / deber_cell_lat_deg) as string));
auto deber_cell_c <- concat(cast(floor(longitude / deber_cell_lon_deg) as string), ':', cast(floor(latitude / deber_cell_lat_deg + 0.5) as string));
auto deber_cell_d <- concat(cast(floor(longitude / deber_cell_lon_deg + 0.5) as string), ':', cast(floor(latitude / deber_cell_lat_deg + 0.5) as string));

auto deber_anchor_count_a <- count(tree_id ? deber_source != 'OSM_DEBER') by deber_cell_a;
auto deber_anchor_count_b <- count(tree_id ? deber_source != 'OSM_DEBER') by deber_cell_b;
auto deber_anchor_count_c <- count(tree_id ? deber_source != 'OSM_DEBER') by deber_cell_c;
auto deber_anchor_count_d <- count(tree_id ? deber_source != 'OSM_DEBER') by deber_cell_d;

auto deber_is_duplicate <- deber_source = 'OSM_DEBER' and (
    deber_anchor_count_a > 0
    or deber_anchor_count_b > 0
    or deber_anchor_count_c > 0
    or deber_anchor_count_d > 0
);

partial datasource berlin_tree_info (
    tree_id,
    city,
    data_source: deber_source,
    species,
    ?tree_name,
    ?plant_date,
    ?diameter_at_breast_height,
    ?latitude,
    ?longitude,
    ?submission_photo_url,
    is_duplicate: deber_is_duplicate,
    deber_published_data_updated_through,
)
grain (tree_id)
complete where city = 'DEBER'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/deber_tree_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/deber_tree_info_v{data_version}.parquet`
freshness by deber_published_data_updated_through;
