import ..tree_common;
import ..community_tree_info;

auto deber_published_data_updated_through <- greatest(deber_data_updated_through, deber_community_data_updated_through);

key deber_source enum<string>['BERLIN_OPENDATA', 'COMMUNITY_DEBER']; # originating dataset for the row

root datasource berlin_update_time (
    data_updated_through: deber_data_updated_through
)
file `./berlin_update_time.py`;

# Only this city's column, so an approval elsewhere does not mark DEBER's
# Parquet stale. Trilogy probes this as MAX over the one column.
root datasource deber_community_update_time (
    deber_community_data_updated_through: deber_community_data_updated_through
)
file `../community_update_time.py`;


# This city has no OpenStreetMap partition, so no row can be a cross-source
# duplicate.  The column is still emitted as a constant so every city's Parquet
# carries `is_duplicate` and the browser worker can select it unconditionally;
# a per-city column set is what forces the worker into city-specific SQL.
# A city that later gains an OSM partition replaces this with the staggered-grid
# derivation in ustem/tempe_tree_info.preql.
auto deber_is_duplicate <- False;

root partial datasource berlin_raw_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: deber_source,
    species: species,
    tree_name: ?tree_name,
    plant_date: ?plant_date,
    latitude: ?latitude,
    longitude: ?longitude,
    diameter_at_breast_height: ?diameter_at_breast_height,
    submission_photo_url: ?submission_photo_url,
)
grain (tree_id)
complete where city = 'DEBER' and deber_source = 'BERLIN_OPENDATA'
file `./berlin_tree_info.py`;


# Approved community submissions for this city. The shared ingest script
# emits every city's rows; the `complete where` clause narrows it to DEBER
# and makes it a disjoint partition alongside berlin_raw_tree_info.
root partial datasource deber_community_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: deber_source,
    species: species,
    tree_name: ?tree_name,
    plant_date: ?plant_date,
    diameter_at_breast_height: ?diameter_at_breast_height,
    latitude: ?latitude,
    longitude: ?longitude,
    submission_photo_url: ?submission_photo_url,
)
grain (tree_id)
complete where city = 'DEBER' and deber_source = 'COMMUNITY_DEBER'
file `../community_tree_info.py`
where city = 'DEBER';


partial datasource berlin_tree_info (
    tree_id,
    city,
    data_source: deber_source,
    species,
    ?tree_name,
    ?plant_date,
    ?diameter_at_breast_height,
    ?latitude,
    ?longitude,
    ?submission_photo_url,
    is_duplicate: deber_is_duplicate,
    deber_published_data_updated_through,
)
grain (tree_id)
complete where city = 'DEBER'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/deber_tree_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/deber_tree_info_v{data_version}.parquet`
freshness by deber_published_data_updated_through;
