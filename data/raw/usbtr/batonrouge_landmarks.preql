import ..landmark_common;

root datasource batonrouge_landmarks_update_time (
    data_updated_through: usbtr_landmark_data_updated_through
)
file `./batonrouge_landmarks_probe.py`;

# Baton Rouge's local historic landmarks (the City-Parish's Historic
# MapServer on maps.brla.gov) and the National Park Service's National
# Register listings in East Baton Rouge Parish -- registers read live, so no
# Nominatim geocoding, no committed CSV and no staging object.  `lm_type`
# names the register and `register_number` the NRIS reference number (the
# local register publishes none).
root partial datasource raw_batonrouge_landmark_info extends landmark_partition (
    address: ?address,
    lm_type: ?lm_type,
    register_number: ?register_number,
    year_designated: ?year_designated,
)
complete where city = 'USBTR'
file `./batonrouge_landmarks.py`;

partial datasource batonrouge_landmark_info extends published_landmark_info (
    ?address,
    ?lm_type,
    ?register_number,
    ?year_designated,
    usbtr_landmark_data_updated_through,
)
complete where city = 'USBTR'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/usbtr_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/usbtr_landmark_info_v{data_version}.parquet`
freshness by usbtr_landmark_data_updated_through;
