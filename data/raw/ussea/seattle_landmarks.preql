import ..landmark_common;

root datasource seattle_landmarks_update_time (
    data_updated_through: ussea_landmark_data_updated_through
)
file `./seattle_landmarks_probe.py`;

# Seattle's designated City Landmarks (the city's own register under SMC
# 25.12, published by SDCI on the city's ArcGIS Online) and the National Park
# Service's National Register listings in Seattle -- registers read live, so
# no Nominatim geocoding, no committed CSV and no staging object.  `lm_type`
# names the register and `register_number` the landmark number or the NRIS
# reference number.
root partial datasource raw_seattle_landmark_info extends landmark_partition (
    address: ?address,
    lm_type: ?lm_type,
    register_number: ?register_number,
    year_designated: ?year_designated,
)
complete where city = 'USSEA'
file `./seattle_landmarks.py`;

partial datasource seattle_landmark_info extends published_landmark_info (
    ?address,
    ?lm_type,
    ?register_number,
    ?year_designated,
    ussea_landmark_data_updated_through,
)
complete where city = 'USSEA'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/ussea_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/ussea_landmark_info_v{data_version}.parquet`
freshness by ussea_landmark_data_updated_through;
