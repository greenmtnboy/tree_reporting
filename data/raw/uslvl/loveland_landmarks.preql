import ..landmark_common;

root datasource loveland_landmarks_update_time (
    data_updated_through: uslvl_landmark_data_updated_through
)
file `./loveland_landmarks_probe.py`;

# Loveland's designated local historic properties (the City's Historic
# Survey layer, `LOCAL = 'Designated'`) and the National Park Service's
# National Register listings in Loveland -- registers read live, so no
# Nominatim geocoding, no committed CSV and no staging object.  `lm_type`
# names the register and `register_number` the Colorado OAHP site number or
# the NRIS reference number.
root partial datasource raw_loveland_landmark_info extends landmark_partition (
    address: ?address,
    lm_type: ?lm_type,
    register_number: ?register_number,
    year_designated: ?year_designated,
)
complete where city = 'USLVL'
file `./loveland_landmarks.py`;

partial datasource loveland_landmark_info extends published_landmark_info (
    ?address,
    ?lm_type,
    ?register_number,
    ?year_designated,
    uslvl_landmark_data_updated_through,
)
complete where city = 'USLVL'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/uslvl_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/uslvl_landmark_info_v{data_version}.parquet`
freshness by uslvl_landmark_data_updated_through;
