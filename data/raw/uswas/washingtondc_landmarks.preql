import ..landmark_common;

root datasource washingtondc_landmarks_update_time (
    data_updated_through: uswas_landmark_data_updated_through
)
file `./washingtondc_landmarks_probe.py`;

root partial datasource raw_washingtondc_landmark_info extends landmark_partition (
)
complete where city = 'USWAS'
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/washingtondc_landmarks.csv`;

partial datasource washingtondc_landmark_info extends published_landmark_info (
    uswas_landmark_data_updated_through,
)
complete where city = 'USWAS'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/uswas_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/uswas_landmark_info_v{data_version}.parquet`
freshness by uswas_landmark_data_updated_through;
