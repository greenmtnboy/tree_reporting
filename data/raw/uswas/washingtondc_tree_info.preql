import ..tree_common;
import ..community_tree_info;

auto uswas_published_data_updated_through <- greatest(uswas_data_updated_through, uswas_community_data_updated_through);

key uswas_source enum<string>['WASHINGTONDC_OPENDATA', 'COMMUNITY_USWAS']; # originating dataset for the row

root datasource washingtondc_update_time (
    data_updated_through: uswas_data_updated_through
)
file `./washingtondc_update_time.py`;

# Only this city's column, so an approval elsewhere does not mark USWAS's
# Parquet stale. Trilogy probes this as MAX over the one column.
root datasource uswas_community_update_time (
    uswas_community_data_updated_through: uswas_community_data_updated_through
)
file `../community_update_time.py`;

root partial datasource washingtondc_raw_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: uswas_source,
    species: species,
    tree_name: ?tree_name,
    plant_date: ?plant_date,
    latitude: ?latitude,
    longitude: ?longitude,
    diameter_at_breast_height: ?diameter_at_breast_height,
    submission_photo_url: ?submission_photo_url,
)
grain (tree_id)
complete where city = 'USWAS' and uswas_source = 'WASHINGTONDC_OPENDATA'
file `./washingtondc_tree_info.py`;


# Approved community submissions for this city. The shared ingest script
# emits every city's rows; the `complete where` clause narrows it to USWAS
# and makes it a disjoint partition alongside washingtondc_raw_tree_info.
root partial datasource uswas_community_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: uswas_source,
    species: species,
    tree_name: ?tree_name,
    plant_date: ?plant_date,
    diameter_at_breast_height: ?diameter_at_breast_height,
    latitude: ?latitude,
    longitude: ?longitude,
    submission_photo_url: ?submission_photo_url,
)
grain (tree_id)
complete where city = 'USWAS' and uswas_source = 'COMMUNITY_USWAS'
file `../community_tree_info.py`
where city = 'USWAS';

partial datasource washingtondc_tree_info (
    tree_id,
    city,
    data_source: uswas_source,
    species,
    ?tree_name,
    ?plant_date,
    ?diameter_at_breast_height,
    ?latitude,
    ?longitude,
    ?submission_photo_url,
    uswas_published_data_updated_through,
)
grain (tree_id)
complete where city = 'USWAS'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/uswas_tree_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/uswas_tree_info_v{data_version}.parquet`
freshness by uswas_published_data_updated_through;
