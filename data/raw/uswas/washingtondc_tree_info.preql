import ..tree_common;
import ..community_tree_info;

auto uswas_published_data_updated_through <- greatest(uswas_data_updated_through, uswas_community_data_updated_through, uswas_osm_data_updated_through);

key uswas_source enum<string>['WASHINGTONDC_OPENDATA', 'COMMUNITY_USWAS', 'OSM_USWAS']; # originating dataset for the row

root datasource washingtondc_update_time (
    data_updated_through: uswas_data_updated_through
)
file `./washingtondc_update_time.py`;

# Only this city's column, so an approval elsewhere does not mark USWAS's
# Parquet stale. Trilogy probes this as MAX over the one column.
root datasource uswas_community_update_time (
    uswas_community_data_updated_through: uswas_community_data_updated_through
)
file `../community_update_time.py`;




# GCS publication time of the staged OSM parquet (see washingtondc_osm_extract.py);
# it only moves when an extraction is re-run and uploaded.
root datasource uswas_osm_update_time (
    data_updated_through: uswas_osm_data_updated_through
)
file `./washingtondc_osm_probe.py`;

# OpenStreetMap trees, read from the staged parquet in GCS rather than
# Overpass -- extraction is decoupled from refresh (see _osm_shared.py and
# EXTENDING.md).  Overlapping rows are kept and flagged via
# uswas_is_duplicate below, never dropped: the Parquet must contain the union
# of its declared sources, and the flag keeps the dedup tunable and auditable.
root partial datasource uswas_osm_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: uswas_source,
    species: ?species,
    tree_name: ?tree_name,
    plant_date: ?plant_date,
    latitude: ?latitude,
    longitude: ?longitude,
    diameter_at_breast_height: ?diameter_at_breast_height,
    submission_photo_url: ?submission_photo_url,
)
grain (tree_id)
complete where city = 'USWAS' and uswas_source = 'OSM_USWAS'
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/uswas_osm_staging.parquet`;

root partial datasource washingtondc_raw_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: uswas_source,
    species: species,
    tree_name: ?tree_name,
    plant_date: ?plant_date,
    latitude: ?latitude,
    longitude: ?longitude,
    diameter_at_breast_height: ?diameter_at_breast_height,
    submission_photo_url: ?submission_photo_url,
)
grain (tree_id)
complete where city = 'USWAS' and uswas_source = 'WASHINGTONDC_OPENDATA'
file `./washingtondc_tree_info.py`;


# Approved community submissions for this city. The shared ingest script
# emits every city's rows; the `complete where` clause narrows it to USWAS
# and makes it a disjoint partition alongside washingtondc_raw_tree_info.
root partial datasource uswas_community_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: uswas_source,
    species: species,
    tree_name: ?tree_name,
    plant_date: ?plant_date,
    diameter_at_breast_height: ?diameter_at_breast_height,
    latitude: ?latitude,
    longitude: ?longitude,
    submission_photo_url: ?submission_photo_url,
)
grain (tree_id)
complete where city = 'USWAS' and uswas_source = 'COMMUNITY_USWAS'
file `../community_tree_info.py`
where city = 'USWAS';


# --- Cross-source dedup: stack + aggregate over four staggered grids -------
#
# Same construction as ustem/tempe_tree_info.preql (full rationale there and in
# EXTENDING.md): an OSM row is a duplicate when a non-OSM tree shares its
# ~10m grid cell in ANY of four half-cell-staggered grid copies -- a guaranteed
# match within 5m, possible out to a ~14m diagonal.
#
# CALIBRATED at 10m. This city's 5-10m band is 35.1% mutual-NN over
# n=558 -- neighbour-dominated: a false flag hides a real tree
# while a missed duplicate only double-renders one, so a band that is not
# clearly duplicate-dominated should not be flagged. Re-check with:
#     cd data/raw && uv run ./osm_dedup_validation.py --city USWAS
#
# Cell sizes: 10m of latitude is 10/111320 deg; longitude shrinks by
# cos(38.89 deg) here.
const uswas_cell_lat_deg <- 0.00008983;
const uswas_cell_lon_deg <- 0.00011542;

auto uswas_cell_a <- concat(cast(floor(longitude / uswas_cell_lon_deg) as string), ':', cast(floor(latitude / uswas_cell_lat_deg) as string));
auto uswas_cell_b <- concat(cast(floor(longitude / uswas_cell_lon_deg + 0.5) as string), ':', cast(floor(latitude / uswas_cell_lat_deg) as string));
auto uswas_cell_c <- concat(cast(floor(longitude / uswas_cell_lon_deg) as string), ':', cast(floor(latitude / uswas_cell_lat_deg + 0.5) as string));
auto uswas_cell_d <- concat(cast(floor(longitude / uswas_cell_lon_deg + 0.5) as string), ':', cast(floor(latitude / uswas_cell_lat_deg + 0.5) as string));

auto uswas_anchor_count_a <- count(tree_id ? uswas_source != 'OSM_USWAS') by uswas_cell_a;
auto uswas_anchor_count_b <- count(tree_id ? uswas_source != 'OSM_USWAS') by uswas_cell_b;
auto uswas_anchor_count_c <- count(tree_id ? uswas_source != 'OSM_USWAS') by uswas_cell_c;
auto uswas_anchor_count_d <- count(tree_id ? uswas_source != 'OSM_USWAS') by uswas_cell_d;

auto uswas_is_duplicate <- uswas_source = 'OSM_USWAS' and (
    uswas_anchor_count_a > 0
    or uswas_anchor_count_b > 0
    or uswas_anchor_count_c > 0
    or uswas_anchor_count_d > 0
);

partial datasource washingtondc_tree_info (
    tree_id,
    city,
    data_source: uswas_source,
    species,
    ?tree_name,
    ?plant_date,
    ?diameter_at_breast_height,
    ?latitude,
    ?longitude,
    ?submission_photo_url,
    is_duplicate: uswas_is_duplicate,
    uswas_published_data_updated_through,
)
grain (tree_id)
complete where city = 'USWAS'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/uswas_tree_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/uswas_tree_info_v{data_version}.parquet`
freshness by uswas_published_data_updated_through;
