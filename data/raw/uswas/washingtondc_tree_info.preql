import ..tree_common;
import ..community_tree_info;
import ..tree_dedup;

auto uswas_published_data_updated_through <- greatest(uswas_data_updated_through, uswas_community_data_updated_through, uswas_osm_data_updated_through);

key uswas_source enum<string>['WASHINGTONDC_OPENDATA', 'COMMUNITY_USWAS', 'OSM_USWAS']; # originating dataset for the row

# Feed the shared cross-source merge (../tree_dedup.preql): it classifies rows
# by the label's prefix and records provenance from it.
auto uswas_source_label <- concat(uswas_source, '');
merge uswas_source_label into source_label;

root datasource washingtondc_update_time (
    data_updated_through: uswas_data_updated_through
)
file `./washingtondc_update_time.py`;

# Only this city's column, so an approval elsewhere does not mark USWAS's
# Parquet stale. Trilogy probes this as MAX over the one column.
root datasource uswas_community_update_time (
    uswas_community_data_updated_through: uswas_community_data_updated_through
)
file `../community_update_time.py`;




# GCS publication time of the staged OSM parquet (see washingtondc_osm_extract.py);
# it only moves when an extraction is re-run and uploaded.
root datasource uswas_osm_update_time (
    data_updated_through: uswas_osm_data_updated_through
)
file `./washingtondc_osm_probe.py`;

# OpenStreetMap trees, read from the staged parquet in GCS rather than
# Overpass -- extraction is decoupled from refresh (see shared/osm.py and
# EXTENDING.md).  Overlapping rows are resolved by the
# shared cluster merge (../tree_dedup.preql).
root partial datasource uswas_osm_tree_info extends tree_partition (
    data_source: uswas_source,
    species: ?raw_species,
)
complete where city = 'USWAS' and uswas_source = 'OSM_USWAS'
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/uswas_osm_staging.parquet`;

root partial datasource washingtondc_raw_tree_info extends tree_partition (
    data_source: uswas_source,
)
complete where city = 'USWAS' and uswas_source = 'WASHINGTONDC_OPENDATA'
file `./washingtondc_tree_info.py`;


# Approved community submissions for this city. The shared ingest script
# emits every city's rows; the `complete where` clause narrows it to USWAS
# and makes it a disjoint partition alongside washingtondc_raw_tree_info.
root partial datasource uswas_community_tree_info extends tree_partition (
    data_source: uswas_source,
)
complete where city = 'USWAS' and uswas_source = 'COMMUNITY_USWAS'
file `../community_tree_info.py`
where city = 'USWAS';


# --- Cross-source dedup and attribute merge --------------------------------
#
# Shared: ../tree_dedup.preql groups the three partitions into one cluster per
# tree and picks each canonical attribute across the cluster; this city's grid
# cell size and its calibration live in DEDUP_CELL_METRES in shared/ingest.py.
# The only per-city line is the dbh merge, because Boston imputes it.
merge merged_dbh into diameter_at_breast_height;
# Position: the survivor's own point.  A city with an Overture lookup imports
# ../tree_position.preql instead, which merges the corrected point.
merge merged_latitude into latitude;
merge merged_longitude into longitude;


# The `where` below is the prune: this target publishes only the row that owns
# its cluster, so the parquet holds exactly one tree per row.  It needs
# pytrilogy 0.3.348+ and fails quietly on older planners -- see "The prune" in
# ../tree_dedup.preql.
partial datasource washingtondc_tree_info extends published_tree_info (
    data_source: uswas_source,
    uswas_published_data_updated_through,
)
complete where city = 'USWAS'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/uswas_tree_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/uswas_tree_info_v{data_version}.parquet`
freshness by uswas_published_data_updated_through
assert @source_kept(tree_id, uswas_source, 'WASHINGTONDC_OPENDATA', 0.75)
assert @source_kept(tree_id, uswas_source, 'OSM_USWAS', 0.75);
