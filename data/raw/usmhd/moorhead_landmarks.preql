import ..landmark_common;

root datasource moorhead_landmarks_update_time (
    data_updated_through: usmhd_landmark_data_updated_through
)
file `./moorhead_landmarks_probe.py`;

# Moorhead's National Register of Historic Places listings (the National Park
# Service's register, cut to the City's box and its `City = Moorhead` rows;
# the City publishes no local register) -- read live, so no Nominatim
# geocoding, no committed CSV and no staging object.  `lm_type` names the
# register and `register_number` the NRIS reference number.
root partial datasource raw_moorhead_landmark_info extends landmark_partition (
    address: ?address,
    lm_type: ?lm_type,
    register_number: ?register_number,
    year_designated: ?year_designated,
)
complete where city = 'USMHD'
file `./moorhead_landmarks.py`;

partial datasource moorhead_landmark_info extends published_landmark_info (
    ?address,
    ?lm_type,
    ?register_number,
    ?year_designated,
    usmhd_landmark_data_updated_through,
)
complete where city = 'USMHD'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/usmhd_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/usmhd_landmark_info_v{data_version}.parquet`
freshness by usmhd_landmark_data_updated_through;
