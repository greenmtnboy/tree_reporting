import ..landmark_common;

root datasource nyc_landmarks_update_time (
    data_updated_through: nyc_landmark_data_updated_through
)
file `./nyc_landmarks_probe.py`;


root partial datasource raw_nyc_landmark_info (
    landmark_id: landmark_id,
    city: city,
    name: name,
    borough: ?borough,
    the_geom: ?geometry_raw,
)
grain (landmark_id)
complete where city = 'USNYC'
file `./nyc_landmarks.py`;


partial datasource nyc_landmark_info (
    landmark_id,
    city,
    name,
    ?borough,
    ?latitude,
    ?longitude,
    ?geometry,
    nyc_landmark_data_updated_through,
)
grain (landmark_id)
complete where city = 'USNYC'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/usnyc_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/usnyc_landmark_info_v{data_version}.parquet`
freshness by nyc_landmark_data_updated_through;
