import ..landmark_common;

root datasource providence_landmarks_update_time (
    data_updated_through: uspvd_landmark_data_updated_through
)
file `./providence_landmarks_probe.py`;

# The National Park Service's National Register listings in Providence
# (buildings, sites and structures; districts are areas and are not
# published) -- a register read live, so no Nominatim geocoding, no committed
# CSV and no staging object. The City's own historic designations are
# districts and a PDF overlay, with no named point register to read.
# `lm_type` names the register and `register_number` the NRIS reference number.
root partial datasource raw_providence_landmark_info extends landmark_partition (
    address: ?address,
    lm_type: ?lm_type,
    register_number: ?register_number,
    year_designated: ?year_designated,
)
complete where city = 'USPVD'
file `./providence_landmarks.py`;

partial datasource providence_landmark_info extends published_landmark_info (
    ?address,
    ?lm_type,
    ?register_number,
    ?year_designated,
    uspvd_landmark_data_updated_through,
)
complete where city = 'USPVD'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/uspvd_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/uspvd_landmark_info_v{data_version}.parquet`
freshness by uspvd_landmark_data_updated_through;
