    f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/camtl_tree_predictions_v{data_version}.parquet`,
    f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/canwe_tree_predictions_v{data_version}.parquet`,
    f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/caott_tree_predictions_v{data_version}.parquet`,
    f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/caque_tree_predictions_v{data_version}.parquet`,
