import ..landmark_common;

root datasource bordeaux_landmarks_update_time (
    data_updated_through: frbod_landmark_data_updated_through
)
file `./bordeaux_landmarks_probe.py`;

# Bordeaux Métropole's protected monuments -- buildings classés or inscrits
# under the Monuments Historiques -- read from the Ministry of Culture's
# national Mérimée export (Licence Ouverte v2.0) and filtered to the
# Métropole's 28 communes; see bordeaux_landmarks.py.  The register's own
# attributes ride along in existing landmark_common properties: the address,
# the protection (date and type, as Paris carries it) and the building type.
root partial datasource raw_bordeaux_landmark_info extends landmark_partition (
    address: ?address,
    protection_type: ?protection_type,
    denomination: ?denomination,
)
complete where city = 'FRBOD'
file `./bordeaux_landmarks.py`;

partial datasource bordeaux_landmark_info extends published_landmark_info (
    ?address,
    ?protection_type,
    ?denomination,
    frbod_landmark_data_updated_through,
)
complete where city = 'FRBOD'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/frbod_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/frbod_landmark_info_v{data_version}.parquet`
freshness by frbod_landmark_data_updated_through;
