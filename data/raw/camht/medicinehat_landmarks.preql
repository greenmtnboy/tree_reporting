import ..landmark_common;

root datasource medicinehat_landmarks_update_time (
    data_updated_through: camht_landmark_data_updated_through
)
file `./medicinehat_landmarks_probe.py`;

# Medicine Hat's designated historic resources (Municipal, Provincial and
# National), read live off the City's own ArcGIS Online "Historic Resources"
# map layer -- the City's own list, so nothing geocoded or staged.
root partial datasource raw_medicinehat_landmark_info extends landmark_partition (
    address: ?address,
)
complete where city = 'CAMHT'
file `./medicinehat_landmarks.py`;

partial datasource medicinehat_landmark_info extends published_landmark_info (
    ?address,
    camht_landmark_data_updated_through,
)
complete where city = 'CAMHT'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/camht_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/camht_landmark_info_v{data_version}.parquet`
freshness by camht_landmark_data_updated_through;
