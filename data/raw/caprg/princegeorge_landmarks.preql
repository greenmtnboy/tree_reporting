import ..landmark_common;

root datasource princegeorge_landmarks_update_time (
    data_updated_through: caprg_landmark_data_updated_through
)
file `./princegeorge_landmarks_probe.py`;

# Prince George's Heritage Register (the City's register page; no licence
# stated), each place located live on the City's civic address points
# (Open Government License - City of Prince George) -- nothing geocoded by a
# third party or staged.
root partial datasource raw_princegeorge_landmark_info extends landmark_partition (
    address: ?address,
    year_built: ?year_built,
)
complete where city = 'CAPRG'
file `./princegeorge_landmarks.py`;

partial datasource princegeorge_landmark_info extends published_landmark_info (
    ?address,
    ?year_built,
    caprg_landmark_data_updated_through,
)
complete where city = 'CAPRG'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/caprg_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/caprg_landmark_info_v{data_version}.parquet`
freshness by caprg_landmark_data_updated_through;
