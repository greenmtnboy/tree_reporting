import ..landmark_common;

root datasource colacotway_landmarks_update_time (
    data_updated_through: aucol_landmark_data_updated_through
)
file `./colacotway_landmarks_probe.py`;

# Colac Otway Shire's places on the Victorian Heritage Register, read live from
# Vicmap's open-data WFS and cut to the shire with the LGA's
# own boundary (see colacotway_landmarks.py) -- an official register, so no
# Nominatim geocoding, no committed CSV and no staging object.  `lm_type`
# names the register and `register_number` carries the VHR number (H1234).
root partial datasource raw_colacotway_landmark_info extends landmark_partition (
    lm_type: ?lm_type,
    register_number: ?register_number,
)
complete where city = 'AUCOL'
file `./colacotway_landmarks.py`;

partial datasource colacotway_landmark_info extends published_landmark_info (
    ?lm_type,
    ?register_number,
    aucol_landmark_data_updated_through,
)
complete where city = 'AUCOL'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/aucol_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/aucol_landmark_info_v{data_version}.parquet`
freshness by aucol_landmark_data_updated_through;
