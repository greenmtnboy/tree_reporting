import ..landmark_common;

root datasource athens_landmarks_update_time (
    data_updated_through: grath_landmark_data_updated_through
)
file `./athens_landmarks_probe.py`;

# Curated + Nominatim-geocoded (see athens_landmarks_geocode.py): Greece's
# national monuments registry has no machine-readable export, and the city
# portal's only heritage layer is the Acropolis protection-zone polygon.
# The refresh reads the GCS staging copy of the committed CSV; re-uploading it
# via _ingest_shared.upload_staging is what marks this city's Parquet stale.
root partial datasource raw_athens_landmark_info (
    landmark_id: landmark_id,
    city: city,
    name: name,
    geometry_raw: ?geometry_raw,
)
grain (landmark_id)
complete where city = 'GRATH'
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/athens_landmarks.csv`;

partial datasource athens_landmark_info (
    landmark_id,
    city,
    name,
    ?geometry,
    ?latitude,
    ?longitude,
    grath_landmark_data_updated_through,
)
grain (landmark_id)
complete where city = 'GRATH'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/grath_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/grath_landmark_info_v{data_version}.parquet`
freshness by grath_landmark_data_updated_through;
