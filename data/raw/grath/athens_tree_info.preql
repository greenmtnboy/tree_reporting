import ..tree_common;
import ..community_tree_info;
import ..tree_dedup;

auto grath_published_data_updated_through <- greatest(grath_data_updated_through, grath_community_data_updated_through, grath_osm_data_updated_through);

key grath_source enum<string>['ATHENS_OPENDATA', 'COMMUNITY_GRATH', 'OSM_GRATH']; # originating dataset for the row

# Feed the shared cross-source merge (../tree_dedup.preql): it classifies rows
# by the label's prefix and records provenance from it.
auto grath_source_label <- concat(grath_source, '');
merge grath_source_label into source_label;

root datasource athens_update_time (
    data_updated_through: grath_data_updated_through
)
file `./athens_update_time.py`;

# Only this city's column, so an approval elsewhere does not mark GRATH's
# Parquet stale. Trilogy probes this as MAX over the one column.
root datasource grath_community_update_time (
    grath_community_data_updated_through: grath_community_data_updated_through
)
file `../community_update_time.py`;

# GCS publication time of the staged OSM parquet (see athens_osm_extract.py);
# it only moves when an extraction is re-run and uploaded.
root datasource grath_osm_update_time (
    data_updated_through: grath_osm_data_updated_through
)
file `./athens_osm_probe.py`;

# OpenStreetMap trees, read from the staged parquet in GCS rather than
# Overpass -- extraction is decoupled from refresh (see _osm_shared.py and
# EXTENDING.md).  Overlapping rows are resolved by the
# shared cluster merge (../tree_dedup.preql).
root partial datasource grath_osm_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: grath_source,
    species: ?raw_species,
    tree_name: ?raw_tree_name,
    plant_date: ?raw_plant_date,
    latitude: ?raw_latitude,
    longitude: ?raw_longitude,
    diameter_at_breast_height: ?raw_dbh,
    submission_photo_url: ?raw_photo_url,
)
grain (tree_id)
complete where city = 'GRATH' and grath_source = 'OSM_GRATH'
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/grath_osm_staging.parquet`;

# The National Garden inventory — the only tree dataset any Greek open data
# portal publishes (Aug 2026), so the municipal partition covers the garden's
# ~6,350 trees rather than a citywide street inventory.
root partial datasource athens_raw_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: grath_source,
    species: raw_species,
    tree_name: ?raw_tree_name,
    plant_date: ?raw_plant_date,
    latitude: ?raw_latitude,
    longitude: ?raw_longitude,
    diameter_at_breast_height: ?raw_dbh,
    submission_photo_url: ?raw_photo_url,
)
grain (tree_id)
complete where city = 'GRATH' and grath_source = 'ATHENS_OPENDATA'
file `./athens_tree_info.py`;


# Approved community submissions for this city. The shared ingest script
# emits every city's rows; the `where` clause narrows it to GRATH and the
# `complete where` makes it a disjoint partition alongside athens_raw_tree_info.
root partial datasource grath_community_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: grath_source,
    species: raw_species,
    tree_name: ?raw_tree_name,
    plant_date: ?raw_plant_date,
    diameter_at_breast_height: ?raw_dbh,
    latitude: ?raw_latitude,
    longitude: ?raw_longitude,
    submission_photo_url: ?raw_photo_url,
)
grain (tree_id)
complete where city = 'GRATH' and grath_source = 'COMMUNITY_GRATH'
file `../community_tree_info.py`
where city = 'GRATH';


# --- Cross-source dedup and attribute merge --------------------------------
#
# Shared: ../tree_dedup.preql groups the three partitions into one cluster per
# tree and picks each canonical attribute across the cluster; this city's grid
# cell size and its calibration live in DEDUP_CELL_METRES in _ingest_shared.py.
# The only per-city line is the dbh merge, because Boston imputes it.
merge merged_dbh into diameter_at_breast_height;


# The `where` below is the prune: this target publishes only the row that owns
# its cluster, so the parquet holds exactly one tree per row.  It needs
# pytrilogy 0.3.348+ and fails quietly on older planners -- see "The prune" in
# ../tree_dedup.preql.
partial datasource athens_tree_info (
    tree_id,
    city,
    data_source: grath_source,
    species,
    ?tree_name,
    ?plant_date,
    ?diameter_at_breast_height,
    ?latitude,
    ?longitude,
    ?submission_photo_url,
    cluster_id,
    merged_sources,
    ?merged_tree_ids,
    grath_published_data_updated_through,
)
grain (tree_id)
complete where city = 'GRATH'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/grath_tree_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/grath_tree_info_v{data_version}.parquet`
where tree_id = cluster_id
freshness by grath_published_data_updated_through;
