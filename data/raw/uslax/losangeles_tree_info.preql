import ..tree_common;
import ..community_tree_info;
import ..satellite_tree_info;
import ..tree_dedup;

auto uslax_published_data_updated_through <- greatest(uslax_data_updated_through, uslax_community_data_updated_through, uslax_osm_data_updated_through, uslax_satellite_data_updated_through, uslax_predicted_data_updated_through);

key uslax_source enum<string>['LOSANGELES_OPENDATA', 'COMMUNITY_USLAX', 'OSM_USLAX', 'SATELLITE_USLAX', 'PREDICTED_USLAX']; # originating dataset for the row

# Feed the shared cross-source merge (../tree_dedup.preql): it classifies rows
# by the label's prefix and records provenance from it.
auto uslax_source_label <- concat(uslax_source, '');
merge uslax_source_label into source_label;

root datasource losangeles_update_time (
    data_updated_through: uslax_data_updated_through
)
file `./losangeles_update_time.py`;

# Only this city's column, so an approval elsewhere does not mark USLAX's
# Parquet stale. Trilogy probes this as MAX over the one column.
root datasource uslax_community_update_time (
    uslax_community_data_updated_through: uslax_community_data_updated_through
)
file `../community_update_time.py`;

# Likewise for reviewed aerial-imagery detections: one column, this city's.
root datasource uslax_satellite_update_time (
    uslax_satellite_data_updated_through: uslax_satellite_data_updated_through
)
file `../satellite_update_time.py`;

# Bulk imagery predictions: the GCS publication time of this city's staged
# run file (../predicted_update_time.py).
root datasource uslax_predicted_update_time (
    uslax_predicted_data_updated_through: uslax_predicted_data_updated_through
)
file `../predicted_update_time.py`;


# GCS publication time of the staged OSM parquet (see losangeles_osm_extract.py);
# it only moves when an extraction is re-run and uploaded.
root datasource uslax_osm_update_time (
    data_updated_through: uslax_osm_data_updated_through
)
file `./losangeles_osm_probe.py`;

# OpenStreetMap trees, read from the staged parquet in GCS rather than
# Overpass -- extraction is decoupled from refresh (see shared/osm.py and
# EXTENDING.md).  Overlapping rows are resolved by the
# shared cluster merge (../tree_dedup.preql).
root partial datasource uslax_osm_tree_info extends tree_partition (
    data_source: uslax_source,
    species: ?raw_species,
)
complete where city = 'USLAX' and uslax_source = 'OSM_USLAX'
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/uslax_osm_staging.parquet`
where (raw_latitude >= 33.7036 and raw_latitude < 34.3374 and raw_longitude >= -118.6682 and raw_longitude < -118.1552);

root partial datasource losangeles_raw_tree_info extends tree_partition (
    data_source: uslax_source,
)
complete where city = 'USLAX' and uslax_source = 'LOSANGELES_OPENDATA'
file `./losangeles_tree_info.py`;



# Approved community submissions for this city. The shared ingest script
# emits every city's rows; the `complete where` clause narrows it to USLAX
# and makes it a disjoint partition alongside losangeles_raw_tree_info.
root partial datasource uslax_community_tree_info extends tree_partition (
    data_source: uslax_source,
)
complete where city = 'USLAX' and uslax_source = 'COMMUNITY_USLAX'
file `../community_tree_info.py`
where city = 'USLAX';


# Reviewed aerial-imagery detections (reviewer/satellite.ts), read from the
# public export the reviewer publishes -- see ../satellite_tree_info.py.  A
# detection linked to an inventory tree is absorbed by the shared merge; an
# unlinked one publishes as its own tree.
root partial datasource uslax_satellite_tree_info extends tree_partition (
    data_source: uslax_source,
    species: ?raw_species,
)
complete where city = 'USLAX' and uslax_source = 'SATELLITE_USLAX'
file `../satellite_tree_info.py`
where city = 'USLAX';


# Bulk aerial-imagery predictions, published without per-tree review (see
# ../predicted_tree_info.py).  The weakest class in the shared merge: any tree
# another source has absorbs the prediction and takes none of its values, so
# these rows only show where nothing else has a tree.  No `source_kept` guard:
# a new run at a stricter threshold may rightly shed a quarter of them.  Until
# a run is staged the file is absent and this partition is empty.
root partial datasource uslax_predicted_tree_info extends tree_partition (
    data_source: uslax_source,
    species: ?raw_species,
)
complete where city = 'USLAX' and uslax_source = 'PREDICTED_USLAX'
file `../predicted_tree_info.py`
where city = 'USLAX';


# --- Cross-source dedup and attribute merge --------------------------------
#
# Shared: ../tree_dedup.preql groups the partitions into one cluster per
# tree and picks each canonical attribute across the cluster; this city's grid
# cell size and its calibration live in DEDUP_CELL_METRES in shared/ingest.py.
# The only per-city line is the dbh merge, because Boston imputes it.
merge merged_dbh into diameter_at_breast_height;
# Position: the survivor's own point.  A city with an Overture lookup imports
# ../tree_position.preql instead, which merges the corrected point.
merge merged_latitude into latitude;
merge merged_longitude into longitude;


# The `where` below is the prune: this target publishes only the row that owns
# its cluster, so the parquet holds exactly one tree per row.  It needs
# pytrilogy 0.3.348+ and fails quietly on older planners -- see "The prune" in
# ../tree_dedup.preql.
partial datasource losangeles_tree_info extends published_tree_info (
    data_source: uslax_source,
    uslax_published_data_updated_through,
)
complete where city = 'USLAX'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/uslax_tree_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/uslax_tree_info_v{data_version}.parquet`
freshness by uslax_published_data_updated_through
assert @source_kept(tree_id, uslax_source, 'LOSANGELES_OPENDATA', 0.75)
assert @source_kept(tree_id, uslax_source, 'OSM_USLAX', 0.75);
