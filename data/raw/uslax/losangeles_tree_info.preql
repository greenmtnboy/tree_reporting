import ..tree_common;
import ..community_tree_info;

auto uslax_published_data_updated_through <- greatest(uslax_data_updated_through, uslax_community_data_updated_through, uslax_osm_data_updated_through);

key uslax_source enum<string>['LOSANGELES_OPENDATA', 'COMMUNITY_USLAX', 'OSM_USLAX']; # originating dataset for the row

root datasource losangeles_update_time (
    data_updated_through: uslax_data_updated_through
)
file `./losangeles_update_time.py`;

# Only this city's column, so an approval elsewhere does not mark USLAX's
# Parquet stale. Trilogy probes this as MAX over the one column.
root datasource uslax_community_update_time (
    uslax_community_data_updated_through: uslax_community_data_updated_through
)
file `../community_update_time.py`;




# GCS publication time of the staged OSM parquet (see losangeles_osm_extract.py);
# it only moves when an extraction is re-run and uploaded.
root datasource uslax_osm_update_time (
    data_updated_through: uslax_osm_data_updated_through
)
file `./losangeles_osm_probe.py`;

# OpenStreetMap trees, read from the staged parquet in GCS rather than
# Overpass -- extraction is decoupled from refresh (see _osm_shared.py and
# EXTENDING.md).  Overlapping rows are kept and flagged via
# uslax_is_duplicate below, never dropped: the Parquet must contain the union
# of its declared sources, and the flag keeps the dedup tunable and auditable.
root partial datasource uslax_osm_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: uslax_source,
    species: ?species,
    tree_name: ?tree_name,
    plant_date: ?plant_date,
    latitude: ?latitude,
    longitude: ?longitude,
    diameter_at_breast_height: ?diameter_at_breast_height,
    submission_photo_url: ?submission_photo_url,
)
grain (tree_id)
complete where city = 'USLAX' and uslax_source = 'OSM_USLAX'
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/uslax_osm_staging.parquet`;

root partial datasource losangeles_raw_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: uslax_source,
    species: species,
    tree_name: ?tree_name,
    plant_date: ?plant_date,
    latitude: ?latitude,
    longitude: ?longitude,
    diameter_at_breast_height: ?diameter_at_breast_height,
    submission_photo_url: ?submission_photo_url,
)
grain (tree_id)
complete where city = 'USLAX' and uslax_source = 'LOSANGELES_OPENDATA'
file `./losangeles_tree_info.py`;


# Approved community submissions for this city. The shared ingest script
# emits every city's rows; the `complete where` clause narrows it to USLAX
# and makes it a disjoint partition alongside losangeles_raw_tree_info.
root partial datasource uslax_community_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: uslax_source,
    species: species,
    tree_name: ?tree_name,
    plant_date: ?plant_date,
    diameter_at_breast_height: ?diameter_at_breast_height,
    latitude: ?latitude,
    longitude: ?longitude,
    submission_photo_url: ?submission_photo_url,
)
grain (tree_id)
complete where city = 'USLAX' and uslax_source = 'COMMUNITY_USLAX'
file `../community_tree_info.py`
where city = 'USLAX';


# --- Cross-source dedup: stack + aggregate over four staggered grids -------
#
# Same construction as ustem/tempe_tree_info.preql (full rationale there and in
# EXTENDING.md): an OSM row is a duplicate when a non-OSM tree shares its
# ~20m grid cell in ANY of four half-cell-staggered grid copies -- a guaranteed
# match within 10m, possible out to a ~28m diagonal.
#
# CALIBRATED at 20m, unlike most cities. This city's 5-10m band is
# 67.2% mutual-NN over n=296 -- duplicate-dominated, so those matches are
# re-mapped inventory trees rather than neighbours at planting spacing, and
# a 10m cell would miss them. Re-check with:
#     cd data/raw && uv run ./osm_dedup_validation.py --city USLAX
#
# Cell sizes: 20m of latitude is 20/111320 deg; longitude shrinks by
# cos(34.03 deg) here.
const uslax_cell_lat_deg <- 0.00017966;
const uslax_cell_lon_deg <- 0.00021678;

auto uslax_cell_a <- concat(cast(floor(longitude / uslax_cell_lon_deg) as string), ':', cast(floor(latitude / uslax_cell_lat_deg) as string));
auto uslax_cell_b <- concat(cast(floor(longitude / uslax_cell_lon_deg + 0.5) as string), ':', cast(floor(latitude / uslax_cell_lat_deg) as string));
auto uslax_cell_c <- concat(cast(floor(longitude / uslax_cell_lon_deg) as string), ':', cast(floor(latitude / uslax_cell_lat_deg + 0.5) as string));
auto uslax_cell_d <- concat(cast(floor(longitude / uslax_cell_lon_deg + 0.5) as string), ':', cast(floor(latitude / uslax_cell_lat_deg + 0.5) as string));

auto uslax_anchor_count_a <- count(tree_id ? uslax_source != 'OSM_USLAX') by uslax_cell_a;
auto uslax_anchor_count_b <- count(tree_id ? uslax_source != 'OSM_USLAX') by uslax_cell_b;
auto uslax_anchor_count_c <- count(tree_id ? uslax_source != 'OSM_USLAX') by uslax_cell_c;
auto uslax_anchor_count_d <- count(tree_id ? uslax_source != 'OSM_USLAX') by uslax_cell_d;

auto uslax_is_duplicate <- uslax_source = 'OSM_USLAX' and (
    uslax_anchor_count_a > 0
    or uslax_anchor_count_b > 0
    or uslax_anchor_count_c > 0
    or uslax_anchor_count_d > 0
);

partial datasource losangeles_tree_info (
    tree_id,
    city,
    data_source: uslax_source,
    species,
    ?tree_name,
    ?plant_date,
    ?diameter_at_breast_height,
    ?latitude,
    ?longitude,
    ?submission_photo_url,
    is_duplicate: uslax_is_duplicate,
    uslax_published_data_updated_through,
)
grain (tree_id)
complete where city = 'USLAX'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/uslax_tree_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/uslax_tree_info_v{data_version}.parquet`
freshness by uslax_published_data_updated_through;
