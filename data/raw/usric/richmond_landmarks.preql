import ..landmark_common;

root datasource richmond_landmarks_update_time (
    data_updated_through: usric_landmark_data_updated_through
)
file `./richmond_landmarks_probe.py`;

# The City of Richmond's individually designated Old and Historic sites (the
# City's own register, no licence stated: display with attribution only) and
# the National Park Service's National Register listings in the independent
# city -- registers read live, so no Nominatim geocoding, no committed CSV and
# no staging object.  `lm_type` names the register and `register_number` the
# last affecting ordinance (`1970-111-118`) or the NRIS reference number.
root partial datasource raw_richmond_landmark_info extends landmark_partition (
    address: ?address,
    lm_type: ?lm_type,
    register_number: ?register_number,
    year_designated: ?year_designated,
)
complete where city = 'USRIC'
file `./richmond_landmarks.py`;

partial datasource richmond_landmark_info extends published_landmark_info (
    ?address,
    ?lm_type,
    ?register_number,
    ?year_designated,
    usric_landmark_data_updated_through,
)
complete where city = 'USRIC'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/usric_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/usric_landmark_info_v{data_version}.parquet`
freshness by usric_landmark_data_updated_through;
