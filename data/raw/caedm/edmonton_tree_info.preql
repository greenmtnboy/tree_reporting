import ..tree_common;
import ..community_tree_info;
import ..tree_dedup;

auto caedm_published_data_updated_through <- greatest(caedm_data_updated_through, caedm_community_data_updated_through, caedm_osm_data_updated_through);

key caedm_source enum<string>['EDMONTON_OPENDATA', 'COMMUNITY_CAEDM', 'OSM_CAEDM']; # originating dataset for the row

# Feed the shared cross-source merge (../tree_dedup.preql): it classifies rows
# by the label's prefix and records provenance from it.
auto caedm_source_label <- concat(caedm_source, '');
merge caedm_source_label into source_label;

root datasource edmonton_update_time (
    data_updated_through: caedm_data_updated_through
)
file `./edmonton_update_time.py`;

# Only this city's column, so an approval elsewhere does not mark CAEDM's
# Parquet stale. Trilogy probes this as MAX over the one column.
root datasource caedm_community_update_time (
    caedm_community_data_updated_through: caedm_community_data_updated_through
)
file `../community_update_time.py`;

# GCS publication time of the staged OSM parquet; it only moves when an
# extraction is re-run and uploaded. Not a local mtime -- git does not preserve
# it, so a committed staging file makes every fresh clone look like new data.
root datasource caedm_osm_update_time (
    data_updated_through: caedm_osm_data_updated_through
)
file `./edmonton_osm_probe.py`;

root partial datasource edmonton_raw_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: caedm_source,
    species: raw_species,
    tree_name: ?raw_tree_name,
    plant_date: ?raw_plant_date,
    latitude: ?raw_latitude,
    longitude: ?raw_longitude,
    diameter_at_breast_height: ?raw_dbh,
    submission_photo_url: ?raw_photo_url,
    cultivar: ?raw_cultivar,
)
grain (tree_id)
complete where city = 'CAEDM' and caedm_source = 'EDMONTON_OPENDATA'
file `./edmonton_tree_info.py`;


# Approved community submissions for this city. The shared ingest script emits
# every city's rows; the `complete where` clause narrows it to CAEDM and makes
# it a disjoint partition, and the `where` clause is what actually filters --
# `complete where` asserts, it does not promise a predicate.
root partial datasource caedm_community_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: caedm_source,
    species: raw_species,
    tree_name: ?raw_tree_name,
    plant_date: ?raw_plant_date,
    diameter_at_breast_height: ?raw_dbh,
    latitude: ?raw_latitude,
    longitude: ?raw_longitude,
    submission_photo_url: ?raw_photo_url,
    cultivar: ?raw_cultivar,
)
grain (tree_id)
complete where city = 'CAEDM' and caedm_source = 'COMMUNITY_CAEDM'
file `../community_tree_info.py`
where city = 'CAEDM';


# OpenStreetMap trees, read from the staged parquet in GCS rather than Overpass
# -- extraction is decoupled from refresh. OSM overlaps the municipal inventory
# by construction; the overlap is resolved by ../tree_dedup.preql.
root partial datasource caedm_osm_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: caedm_source,
    species: raw_species,
    tree_name: ?raw_tree_name,
    plant_date: ?raw_plant_date,
    latitude: ?raw_latitude,
    longitude: ?raw_longitude,
    diameter_at_breast_height: ?raw_dbh,
    submission_photo_url: ?raw_photo_url,
    cultivar: ?raw_cultivar,
)
grain (tree_id)
complete where city = 'CAEDM' and caedm_source = 'OSM_CAEDM'
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/caedm_osm_staging.parquet`;


# --- Cross-source dedup and attribute merge --------------------------------
#
# Shared: ../tree_dedup.preql groups the three partitions into one cluster per
# tree and picks each canonical attribute across the cluster; this city's grid
# cell size and its calibration live in DEDUP_CELL_METRES in _ingest_shared.py.
# The only per-city line is the dbh merge, because Boston imputes it.
merge merged_dbh into diameter_at_breast_height;


partial datasource edmonton_tree_info (
    tree_id,
    city,
    data_source: caedm_source,
    species,
    ?tree_name,
    ?plant_date,
    ?diameter_at_breast_height,
    ?latitude,
    ?longitude,
    ?submission_photo_url,
    ?cultivar,
    merged_sources,
    ?merged_tree_ids,
    caedm_published_data_updated_through,
)
grain (tree_id)
complete where city = 'CAEDM'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/caedm_tree_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/caedm_tree_info_v{data_version}.parquet`
where tree_id = cluster_id
freshness by caedm_published_data_updated_through;
