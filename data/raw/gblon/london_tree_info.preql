import ..tree_common;

root datasource london_update_time (
    data_updated_through: gblon_data_updated_through
)
file `./london_update_time.py`;

root partial datasource london_raw_tree_info (
    tree_id: tree_id,
    city: city,
    species: species,
    tree_name: ?tree_name,
    borough: ?borough,
    plant_date: ?plant_date,
    latitude: ?latitude,
    longitude: ?longitude,
    diameter_at_breast_height: ?diameter_at_breast_height,
)
grain (tree_id)
complete where city = 'GBLON'
file `./london_tree_info.py`;


partial datasource london_tree_info (
    tree_id,
    city,
    species,
    ?tree_name,
    ?borough,
    ?plant_date,
    ?diameter_at_breast_height,
    ?latitude,
    ?longitude,
    gblon_data_updated_through,
)
grain (tree_id)
complete where city = 'GBLON'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/gblon_tree_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/gblon_tree_info_v{data_version}.parquet`
freshness by gblon_data_updated_through;
