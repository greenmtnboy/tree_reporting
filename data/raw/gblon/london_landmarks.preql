import ..landmark_common;

root datasource london_landmarks_update_time (
    data_updated_through: gblon_landmark_data_updated_through
)
file `./london_landmarks_probe.py`;

# Read from the staged Parquet in GCS, not Overpass: extraction is
# decoupled from refresh (see the *_landmarks_extract.py sibling and
# EXTENDING.md).  Re-running the extract and committing the result is what
# makes this city's published Parquet stale.
root partial datasource raw_london_landmark_info extends landmark_partition (
)
complete where city = 'GBLON'
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/gblon_landmarks_staging.parquet`;

partial datasource london_landmark_info extends published_landmark_info (
    gblon_landmark_data_updated_through,
)
complete where city = 'GBLON'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/gblon_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/gblon_landmark_info_v{data_version}.parquet`
freshness by gblon_landmark_data_updated_through;
