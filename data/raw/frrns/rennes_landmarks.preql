import ..landmark_common;

root datasource rennes_landmarks_update_time (
    data_updated_through: frrns_landmark_data_updated_through
)
file `./rennes_landmarks_probe.py`;

# Rennes Métropole's protected monuments -- buildings classés or inscrits
# under the Monuments Historiques -- read from the Ministry of Culture's
# national Mérimée export (Licence Ouverte v2.0) and filtered to the 43
# communes of the metropole; see rennes_landmarks.py.  The register's own
# attributes ride along in existing landmark_common properties: the address,
# the protection (date and type, as Paris carries it) and the building type.
root partial datasource raw_rennes_landmark_info extends landmark_partition (
    address: ?address,
    protection_type: ?protection_type,
    denomination: ?denomination,
)
complete where city = 'FRRNS'
file `./rennes_landmarks.py`;

partial datasource rennes_landmark_info extends published_landmark_info (
    ?address,
    ?protection_type,
    ?denomination,
    frrns_landmark_data_updated_through,
)
complete where city = 'FRRNS'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/frrns_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/frrns_landmark_info_v{data_version}.parquet`
freshness by frrns_landmark_data_updated_through;
