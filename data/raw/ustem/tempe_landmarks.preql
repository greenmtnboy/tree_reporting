import ..landmark_common;

root datasource tempe_landmarks_update_time (
    data_updated_through: ustem_landmark_data_updated_through
)
file `./tempe_landmarks_probe.py`;

root partial datasource raw_tempe_landmark_info extends landmark_partition (
)
complete where city = 'USTEM'
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/tempe_landmarks.csv`;

partial datasource tempe_landmark_info extends published_landmark_info (
    ustem_landmark_data_updated_through,
)
complete where city = 'USTEM'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/ustem_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/ustem_landmark_info_v{data_version}.parquet`
freshness by ustem_landmark_data_updated_through;
