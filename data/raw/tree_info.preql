import tree_common;
import ussfo.sf_tree_info;
import usnyc.nyc_tree_info;
import usbos.boston_tree_info;
import frpar.paris_tree_info;
import usbtv.burlington_tree_info;
import cavan.vancouver_tree_info;
import deber.berlin_tree_info;
import nlams.amsterdam_tree_info;
import gblon.london_tree_info;
import aumel.melbourne_tree_info;
import arbue.buenosaires_tree_info;
import uslax.losangeles_tree_info;
import uswas.washingtondc_tree_info;
import ustem.tempe_tree_info;

auto latest_update_through <- greatest(
ussfo_published_data_updated_through,
usnyc_published_data_updated_through,
usbos_published_data_updated_through,
frpar_published_data_updated_through,
usbtv_published_data_updated_through,
cavan_published_data_updated_through,
deber_published_data_updated_through,
nlams_published_data_updated_through,
gblon_published_data_updated_through,
aumel_published_data_updated_through,
arbue_published_data_updated_through,
uslax_published_data_updated_through,
uswas_published_data_updated_through,
ustem_published_data_updated_through);
# --- Merged union datasource ---

datasource tree_info (
    tree_id,
    city,
    species,
    tree_name,
    ?plant_date,
    ?diameter_at_breast_height,
    ?latitude,
    ?longitude,
    latest_update_through
)
grain (tree_id)
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/full_tree_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/full_tree_info_v{data_version}.parquet`
freshness by latest_update_through;
