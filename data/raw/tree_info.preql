import tree_common;
import ussfo.sf_tree_info;
import usnyc.nyc_tree_info;
import usbos.boston_tree_info;
import frpar.paris_tree_info;
import usbtv.burlington_tree_info;
import cavan.vancouver_tree_info;
import deber.berlin_tree_info;
import nlams.amsterdam_tree_info;
import gblon.london_tree_info;
import aumel.melbourne_tree_info;
import arbue.buenosaires_tree_info;
import uslax.losangeles_tree_info;
import uswas.washingtondc_tree_info;
import ustem.tempe_tree_info;
import grath.athens_tree_info;
import grmlo.milos_tree_info;

# Each city models its originating dataset as its own enum key so Trilogy can
# prove per-city partition coverage (see core.preql). Merging them here — and
# only here — gives the cross-city Parquet a single `data_source` concept
# without disturbing how each city model resolves.
key data_source string; # originating dataset for the tree record
merge ussfo_source into data_source;
merge usnyc_source into data_source;
merge usbos_source into data_source;
merge frpar_source into data_source;
merge usbtv_source into data_source;
merge cavan_source into data_source;
merge deber_source into data_source;
merge nlams_source into data_source;
merge gblon_source into data_source;
merge aumel_source into data_source;
merge arbue_source into data_source;
merge uslax_source into data_source;
merge uswas_source into data_source;
merge ustem_source into data_source;
merge grath_source into data_source;
merge grmlo_source into data_source;

# `is_duplicate` is deliberately NOT merged the same way, and the cross-city
# Parquet does not carry it.  Merging the fourteen per-city keys makes the
# planner resolve a city's dedup aggregate over the union of all fourteen
# cities, and it fails outright:
#
#   UnresolvableQueryException: Planner emitted a keyless join between
#   row-bearing sources that share a join axis: ...unioned_at_local_data_source
#   _local_tree_id_grouped_by_local.usbos_cell_a... This would render as a
#   cross join (ON 1=1) and fan out; the join axis was lost upstream.
#
# The flag exists per city because it is derived from a per-city grid aggregate
# over that city's own rows (see ustem/tempe_tree_info.preql); there is no
# cross-city meaning to give it.  The browser worker only ever loads the
# per-city Parquet, so it filters on the per-city column and skips the filter
# on the full-file fallback path.

auto latest_update_through <- greatest(
ussfo_published_data_updated_through,
usnyc_published_data_updated_through,
usbos_published_data_updated_through,
frpar_published_data_updated_through,
usbtv_published_data_updated_through,
cavan_published_data_updated_through,
deber_published_data_updated_through,
nlams_published_data_updated_through,
gblon_published_data_updated_through,
aumel_published_data_updated_through,
arbue_published_data_updated_through,
uslax_published_data_updated_through,
uswas_published_data_updated_through,
ustem_published_data_updated_through,
grath_published_data_updated_through,
grmlo_published_data_updated_through);
# --- Merged union datasource ---

datasource tree_info (
    tree_id,
    city,
    data_source,
    species,
    tree_name,
    ?plant_date,
    ?diameter_at_breast_height,
    ?latitude,
    ?longitude,
    ?submission_photo_url,
    latest_update_through
)
grain (tree_id)
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/full_tree_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/full_tree_info_v{data_version}.parquet`
freshness by latest_update_through;
