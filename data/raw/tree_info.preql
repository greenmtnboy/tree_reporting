import tree_common;
import sf.sf_tree_info;
import nyc.nyc_tree_info;
import boston.boston_tree_info;
import paris.paris_tree_info;
import burlington.burlington_tree_info;

auto latest_update_through <- greatest(sf_data_updated_through, nyc_data_updated_through, boston_data_updated_through, paris_data_updated_through, usbtv_data_updated_through);
# --- Merged union datasource ---

datasource tree_info (
    tree_id,
    city,
    species,
    tree_name,
    ?plant_date,
    ?diameter_at_breast_height,
    ?latitude,
    ?longitude,
    latest_update_through
)
grain (tree_id)
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/full_tree_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/full_tree_info_v{data_version}.parquet`
freshness by latest_update_through;
