import tree_common;
import ussfo.sf_tree_info;
import usnyc.nyc_tree_info;
import usbos.boston_tree_info;
import frpar.paris_tree_info;
import usbtv.burlington_tree_info;
import cavan.vancouver_tree_info;
import deber.berlin_tree_info;
import nlams.amsterdam_tree_info;
import gblon.london_tree_info;
import aumel.melbourne_tree_info;

auto latest_update_through <- greatest(
ussfo_data_updated_through, 
usnyc_data_updated_through, 
usbos_data_updated_through, 
frpar_data_updated_through, 
usbtv_data_updated_through, 
cavan_data_updated_through, 
deber_data_updated_through, 
nlams_data_updated_through, 
gblon_data_updated_through, 
aumel_data_updated_through);
# --- Merged union datasource ---

datasource tree_info (
    tree_id,
    city,
    species,
    tree_name,
    ?plant_date,
    ?diameter_at_breast_height,
    ?latitude,
    ?longitude,
    latest_update_through
)
grain (tree_id)
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/full_tree_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/full_tree_info_v{data_version}.parquet`
freshness by latest_update_through;
