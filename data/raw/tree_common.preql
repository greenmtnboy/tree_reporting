import std.geography;
import core;

key tree_id string; # unique identifier for the tree record (prefixed: sf-<id> or nyc-<id>)
key species string; # scientific species name (Latin binomial, no common-name suffix)
property tree_id.tree_name string; # original name field from source data, which may be unique to certain trees
property tree_id.plant_date date; # date the tree was planted
property tree_id.diameter_at_breast_height float; # diameter at breast height - standard forestry measure of tree diameter at about 4.5 feet above ground
property tree_id.latitude float::latitude; # geographic latitude for mapping
property tree_id.longitude float::longitude; # geographic longitude for mapping
property tree_id.borough string; # administrative borough/district (London)
property tree_id.submission_photo_url string; # publicly readable photo of this specific tree, from an approved community submission; null for municipal sources. Distinct from species.photo_url in tree_enrichment.preql, which is a stock photo of the species.



property <*>.ussfo_data_updated_through datetime; # when SF data is through
property <*>.usnyc_data_updated_through datetime; # when NYC data is through
# defined in boston dataset as it's a erivation
# property <*>.usbos_data_updated_through datetime; # when Boston data is through
property <*>.frpar_data_updated_through datetime; # when Paris data is through
property <*>.usbtv_data_updated_through datetime; # when Burlington VT data is through
property <*>.cavan_data_updated_through datetime; # when Vancouver data is through
property <*>.deber_data_updated_through datetime; # when Berlin data is through
property <*>.nlams_data_updated_through datetime; # when Amsterdam data is through
property <*>.gblon_data_updated_through datetime; # when London data is through
property <*>.aumel_data_updated_through datetime; # when Melbourne data is through
property <*>.arbue_data_updated_through datetime; # when Buenos Aires data is through
property <*>.uslax_data_updated_through datetime; # when Los Angeles data is through
property <*>.uswas_data_updated_through datetime; # when Washington DC data is through
property <*>.ustem_data_updated_through datetime; # when Tempe data is through
property <*>.ustem_osm_data_updated_through datetime; # mtime of Tempe's committed OSM staging parquet



