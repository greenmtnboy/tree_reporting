import ..landmark_common;

root datasource baltimore_landmarks_update_time (
    data_updated_through: usbal_landmark_data_updated_through
)
file `./baltimore_landmarks_probe.py`;

# The Baltimore City Landmark List (CHAP's register, Open Baltimore's
# "Designated Landmarks" layer, one row per landmark with its points grouped)
# and the National Park Service's National Register listings inside the city
# line -- registers read live, so no Nominatim geocoding, no committed CSV and
# no staging object. `lm_type` names the register and `register_number` the
# landmark-list number or the NRIS reference number.
root partial datasource raw_baltimore_landmark_info extends landmark_partition (
    address: ?address,
    lm_type: ?lm_type,
    register_number: ?register_number,
    year_designated: ?year_designated,
)
complete where city = 'USBAL'
file `./baltimore_landmarks.py`;

partial datasource baltimore_landmark_info extends published_landmark_info (
    ?address,
    ?lm_type,
    ?register_number,
    ?year_designated,
    usbal_landmark_data_updated_through,
)
complete where city = 'USBAL'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/usbal_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/usbal_landmark_info_v{data_version}.parquet`
freshness by usbal_landmark_data_updated_through;
