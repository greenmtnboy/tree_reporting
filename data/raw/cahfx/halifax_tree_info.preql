import ..tree_common;
import ..community_tree_info;
import ..tree_dedup;

auto cahfx_published_data_updated_through <- greatest(cahfx_data_updated_through, cahfx_community_data_updated_through, cahfx_osm_data_updated_through);

key cahfx_source enum<string>['HALIFAX_OPENDATA', 'COMMUNITY_CAHFX', 'OSM_CAHFX']; # originating dataset for the row

# Feed the shared cross-source merge (../tree_dedup.preql): it classifies rows
# by the label's prefix and records provenance from it.
auto cahfx_source_label <- concat(cahfx_source, '');
merge cahfx_source_label into source_label;

root datasource halifax_update_time (
    data_updated_through: cahfx_data_updated_through
)
file `./halifax_update_time.py`;

# Only this city's column, so an approval elsewhere does not mark CAHFX's
# Parquet stale. Trilogy probes this as MAX over the one column.
root datasource cahfx_community_update_time (
    cahfx_community_data_updated_through: cahfx_community_data_updated_through
)
file `../community_update_time.py`;

# GCS publication time of the staged OSM parquet; it only moves when an
# extraction is re-run and uploaded. Not a local mtime -- git does not preserve
# it, so a committed staging file makes every fresh clone look like new data.
root datasource cahfx_osm_update_time (
    data_updated_through: cahfx_osm_data_updated_through
)
file `./halifax_osm_probe.py`;

root partial datasource halifax_raw_tree_info extends tree_partition (
    data_source: cahfx_source,
)
complete where city = 'CAHFX' and cahfx_source = 'HALIFAX_OPENDATA'
file `./halifax_tree_info.py`;


# Approved community submissions for this city. The shared ingest script emits
# every city's rows; the `complete where` clause narrows it to CAHFX and makes
# it a disjoint partition, and the `where` clause is what actually filters --
# `complete where` asserts, it does not promise a predicate.
root partial datasource cahfx_community_tree_info extends tree_partition (
    data_source: cahfx_source,
)
complete where city = 'CAHFX' and cahfx_source = 'COMMUNITY_CAHFX'
file `../community_tree_info.py`
where city = 'CAHFX';


# OpenStreetMap trees, read from the staged parquet in GCS rather than Overpass
# -- extraction is decoupled from refresh. OSM overlaps the municipal inventory
# by construction; the overlap is resolved by ../tree_dedup.preql.
root partial datasource cahfx_osm_tree_info extends tree_partition (
    data_source: cahfx_source,
)
complete where city = 'CAHFX' and cahfx_source = 'OSM_CAHFX'
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/cahfx_osm_staging.parquet`;


# --- Cross-source dedup and attribute merge --------------------------------
#
# Shared: ../tree_dedup.preql groups the three partitions into one cluster per
# tree and picks each canonical attribute across the cluster; this city's grid
# cell size and its calibration live in DEDUP_CELL_METRES in shared/ingest.py.
# The only per-city line is the dbh merge, because Boston imputes it.
merge merged_dbh into diameter_at_breast_height;
# Position: the survivor's own point.  A city with an Overture lookup imports
# ../tree_position.preql instead, which merges the corrected point.
merge merged_latitude into latitude;
merge merged_longitude into longitude;


partial datasource halifax_tree_info extends published_tree_info (
    data_source: cahfx_source,
    cahfx_published_data_updated_through,
)
complete where city = 'CAHFX'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/cahfx_tree_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/cahfx_tree_info_v{data_version}.parquet`
freshness by cahfx_published_data_updated_through
assert @source_kept(tree_id, cahfx_source, 'HALIFAX_OPENDATA', 0.75)
assert @source_kept(tree_id, cahfx_source, 'OSM_CAHFX', 0.75);
