import ..landmark_common;

root datasource belfast_landmarks_update_time (
    data_updated_through: gbbfs_landmark_data_updated_through
)
file `./belfast_landmarks_probe.py`;

# The Department for Communities' Historic Environment Division registers --
# listed buildings (Historic Buildings Record, listed grades only) and
# scheduled or state-care monuments (Sites and Monuments Record) -- cut to
# HED's own `Council = 'Belfast'` attribution and read live from its public
# FeatureServer (OGL), so no Nominatim geocoding, no committed CSV and no
# staging object. `lm_type` names the designation and grade, `register_number`
# the HED reference (HB or SMR number).
root partial datasource raw_belfast_landmark_info extends landmark_partition (
    address: ?address,
    lm_type: ?lm_type,
    register_number: ?register_number,
)
complete where city = 'GBBFS'
file `./belfast_landmarks.py`;

partial datasource belfast_landmark_info extends published_landmark_info (
    ?address,
    ?lm_type,
    ?register_number,
    gbbfs_landmark_data_updated_through,
)
complete where city = 'GBBFS'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/gbbfs_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/gbbfs_landmark_info_v{data_version}.parquet`
freshness by gbbfs_landmark_data_updated_through;
