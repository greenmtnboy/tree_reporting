# Per-city slices of the published crown predictions, for the browser.
#
# The map sizes every tree sprite from `predicted_crown_width_m` before it
# marks a city ready. Read from tree_predictions_v{data_version}.parquet that
# meant downloading every city's predictions (~146 MB: DuckDB-wasm fetches a
# whole object on first read) before the first landmark or chart could
# query. Each slice here is one city's rows and the three columns the browser
# reads, a few MB.
#
# The source is the published parquet itself, read as a root under concepts
# of its own: importing tree_predictions.preql would let the planner
# recompute every prediction from the rollup, the enrichment table and the
# coefficient CSVs once per city. Its job runs after refresh-predictions.
#
# Every city in MUNICIPAL_DATA_SOURCES has exactly one slice
# (test_cloud_jobs.py::test_crown_slices_cover_every_city); new_city.py
# appends one.

import tree_common;

property tree_id.published_crown_width_m float; # predicted_crown_width_m as tree_predictions.preql published it
property <*>.published_prediction_inputs_through datetime; # prediction_inputs_published_through as published

root datasource published_tree_predictions (
    tree_id: tree_id,
    city: city,
    predicted_crown_width_m: ?published_crown_width_m,
    prediction_inputs_published_through: published_prediction_inputs_through,
)
grain (tree_id)
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/tree_predictions_v{data_version}.parquet`;

partial datasource arbue_tree_predictions (
    tree_id,
    city,
    predicted_crown_width_m: ?published_crown_width_m,
    prediction_inputs_published_through: published_prediction_inputs_through,
)
grain (tree_id)
complete where city = 'ARBUE'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/arbue_tree_predictions_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/arbue_tree_predictions_v{data_version}.parquet`
freshness by published_prediction_inputs_through;

