import ..tree_common;
import ..community_tree_info;

auto frpar_published_data_updated_through <- greatest(frpar_data_updated_through, frpar_community_data_updated_through);

key frpar_source enum<string>['PARIS_OPENDATA', 'COMMUNITY_FRPAR']; # originating dataset for the row

root datasource paris_update_time (
    data_updated_through: frpar_data_updated_through
)
file `./paris_update_time.py`;

# Only this city's column, so an approval elsewhere does not mark FRPAR's
# Parquet stale. Trilogy probes this as MAX over the one column.
root datasource frpar_community_update_time (
    frpar_community_data_updated_through: frpar_community_data_updated_through
)
file `../community_update_time.py`;

root partial datasource paris_raw_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: frpar_source,
    species: species,
    tree_name: ?tree_name,
    plant_date: ?plant_date,
    latitude: ?latitude,
    longitude: ?longitude,
    diameter_at_breast_height: ?diameter_at_breast_height,
    submission_photo_url: ?submission_photo_url,
)
grain (tree_id)
complete where city = 'FRPAR' and frpar_source = 'PARIS_OPENDATA'
file `./paris_tree_info.py`;


# Approved community submissions for this city. The shared ingest script
# emits every city's rows; the `complete where` clause narrows it to FRPAR
# and makes it a disjoint partition alongside paris_raw_tree_info.
root partial datasource frpar_community_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: frpar_source,
    species: species,
    tree_name: ?tree_name,
    plant_date: ?plant_date,
    diameter_at_breast_height: ?diameter_at_breast_height,
    latitude: ?latitude,
    longitude: ?longitude,
    submission_photo_url: ?submission_photo_url,
)
grain (tree_id)
complete where city = 'FRPAR' and frpar_source = 'COMMUNITY_FRPAR'
file `../community_tree_info.py`
where city = 'FRPAR';


partial datasource paris_tree_info (
    tree_id,
    city,
    data_source: frpar_source,
    species,
    ?tree_name,
    ?plant_date,
    ?diameter_at_breast_height,
    ?latitude,
    ?longitude,
    ?submission_photo_url,
    frpar_published_data_updated_through,
)
grain (tree_id)
complete where city = 'FRPAR'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/frpar_tree_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/frpar_tree_info_v{data_version}.parquet`
freshness by frpar_published_data_updated_through;
