import ..tree_common;
import ..community_tree_info;

auto frpar_published_data_updated_through <- greatest(frpar_data_updated_through, frpar_community_data_updated_through, frpar_osm_data_updated_through);

key frpar_source enum<string>['PARIS_OPENDATA', 'COMMUNITY_FRPAR', 'OSM_FRPAR']; # originating dataset for the row

root datasource paris_update_time (
    data_updated_through: frpar_data_updated_through
)
file `./paris_update_time.py`;

# Only this city's column, so an approval elsewhere does not mark FRPAR's
# Parquet stale. Trilogy probes this as MAX over the one column.
root datasource frpar_community_update_time (
    frpar_community_data_updated_through: frpar_community_data_updated_through
)
file `../community_update_time.py`;




# GCS publication time of the staged OSM parquet (see paris_osm_extract.py);
# it only moves when an extraction is re-run and uploaded.
root datasource frpar_osm_update_time (
    data_updated_through: frpar_osm_data_updated_through
)
file `./paris_osm_probe.py`;

# OpenStreetMap trees, read from the staged parquet in GCS rather than
# Overpass -- extraction is decoupled from refresh (see _osm_shared.py and
# EXTENDING.md).  Overlapping rows are kept and flagged via
# frpar_is_duplicate below, never dropped: the Parquet must contain the union
# of its declared sources, and the flag keeps the dedup tunable and auditable.
root partial datasource frpar_osm_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: frpar_source,
    species: ?species,
    tree_name: ?tree_name,
    plant_date: ?plant_date,
    latitude: ?latitude,
    longitude: ?longitude,
    diameter_at_breast_height: ?diameter_at_breast_height,
    submission_photo_url: ?submission_photo_url,
)
grain (tree_id)
complete where city = 'FRPAR' and frpar_source = 'OSM_FRPAR'
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/frpar_osm_staging.parquet`;

root partial datasource paris_raw_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: frpar_source,
    species: species,
    tree_name: ?tree_name,
    plant_date: ?plant_date,
    latitude: ?latitude,
    longitude: ?longitude,
    diameter_at_breast_height: ?diameter_at_breast_height,
    submission_photo_url: ?submission_photo_url,
)
grain (tree_id)
complete where city = 'FRPAR' and frpar_source = 'PARIS_OPENDATA'
file `./paris_tree_info.py`;


# Approved community submissions for this city. The shared ingest script
# emits every city's rows; the `complete where` clause narrows it to FRPAR
# and makes it a disjoint partition alongside paris_raw_tree_info.
root partial datasource frpar_community_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: frpar_source,
    species: species,
    tree_name: ?tree_name,
    plant_date: ?plant_date,
    diameter_at_breast_height: ?diameter_at_breast_height,
    latitude: ?latitude,
    longitude: ?longitude,
    submission_photo_url: ?submission_photo_url,
)
grain (tree_id)
complete where city = 'FRPAR' and frpar_source = 'COMMUNITY_FRPAR'
file `../community_tree_info.py`
where city = 'FRPAR';



# --- Cross-source dedup: stack + aggregate over four staggered grids -------
#
# Same construction as ustem/tempe_tree_info.preql (full rationale there and in
# EXTENDING.md): an OSM row is a duplicate when a non-OSM tree shares its
# ~10m grid cell in ANY of four half-cell-staggered grid copies -- a guaranteed
# match within 5m, possible out to a ~14m diagonal.
#
# The 10m cell is PROVISIONAL until this city is calibrated:
#     cd data/raw && uv run osm_dedup_validation.py --city FRPAR
# The break between re-mapped duplicates and interstitial neighbours sits
# wherever this city's OSM positional error ends and its planting spacing
# begins, so it has to be measured rather than copied from Tempe.
#
# Cell sizes: 10m of latitude is 10/111320 deg; longitude shrinks by
# cos(48.88 deg) here.
const frpar_cell_lat_deg <- 0.00008983;
const frpar_cell_lon_deg <- 0.00013658;

auto frpar_cell_a <- concat(cast(floor(longitude / frpar_cell_lon_deg) as string), ':', cast(floor(latitude / frpar_cell_lat_deg) as string));
auto frpar_cell_b <- concat(cast(floor(longitude / frpar_cell_lon_deg + 0.5) as string), ':', cast(floor(latitude / frpar_cell_lat_deg) as string));
auto frpar_cell_c <- concat(cast(floor(longitude / frpar_cell_lon_deg) as string), ':', cast(floor(latitude / frpar_cell_lat_deg + 0.5) as string));
auto frpar_cell_d <- concat(cast(floor(longitude / frpar_cell_lon_deg + 0.5) as string), ':', cast(floor(latitude / frpar_cell_lat_deg + 0.5) as string));

auto frpar_anchor_count_a <- count(tree_id ? frpar_source != 'OSM_FRPAR') by frpar_cell_a;
auto frpar_anchor_count_b <- count(tree_id ? frpar_source != 'OSM_FRPAR') by frpar_cell_b;
auto frpar_anchor_count_c <- count(tree_id ? frpar_source != 'OSM_FRPAR') by frpar_cell_c;
auto frpar_anchor_count_d <- count(tree_id ? frpar_source != 'OSM_FRPAR') by frpar_cell_d;

auto frpar_is_duplicate <- frpar_source = 'OSM_FRPAR' and (
    frpar_anchor_count_a > 0
    or frpar_anchor_count_b > 0
    or frpar_anchor_count_c > 0
    or frpar_anchor_count_d > 0
);

partial datasource paris_tree_info (
    tree_id,
    city,
    data_source: frpar_source,
    species,
    ?tree_name,
    ?plant_date,
    ?diameter_at_breast_height,
    ?latitude,
    ?longitude,
    ?submission_photo_url,
    is_duplicate: frpar_is_duplicate,
    frpar_published_data_updated_through,
)
grain (tree_id)
complete where city = 'FRPAR'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/frpar_tree_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/frpar_tree_info_v{data_version}.parquet`
freshness by frpar_published_data_updated_through;
