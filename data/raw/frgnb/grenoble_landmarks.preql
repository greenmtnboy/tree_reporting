import ..landmark_common;

root datasource grenoble_landmarks_update_time (
    data_updated_through: frgnb_landmark_data_updated_through
)
file `./grenoble_landmarks_probe.py`;

# Grenoble's protected monuments -- buildings classés or inscrits under the
# Monuments Historiques -- read from the Ministry of Culture's national Mérimée
# export (Licence Ouverte v2.0) and filtered to the 49 communes of
# Grenoble-Alpes Métropole, the tree inventory's territory; see
# grenoble_landmarks.py.  The register's own attributes ride along in existing
# landmark_common properties: the address, the protection (date and type, as
# Paris carries it) and the building type.
root partial datasource raw_grenoble_landmark_info extends landmark_partition (
    address: ?address,
    protection_type: ?protection_type,
    denomination: ?denomination,
)
complete where city = 'FRGNB'
file `./grenoble_landmarks.py`;

partial datasource grenoble_landmark_info extends published_landmark_info (
    ?address,
    ?protection_type,
    ?denomination,
    frgnb_landmark_data_updated_through,
)
complete where city = 'FRGNB'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/frgnb_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/frgnb_landmark_info_v{data_version}.parquet`
freshness by frgnb_landmark_data_updated_through;
