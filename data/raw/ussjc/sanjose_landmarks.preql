import ..landmark_common;

root datasource sanjose_landmarks_update_time (
    data_updated_through: ussjc_landmark_data_updated_through
)
file `./sanjose_landmarks_probe.py`;

# San José's City Landmarks (the designated rows of the city's Historic
# Resources Inventory, on the same ArcGIS Server as the trees) and the National
# Park Service's National Register listings in San José -- registers read live,
# so no Nominatim geocoding, no committed CSV and no staging object. `lm_type`
# names the register and `register_number` the city's landmark number
# (`HL-137`) or the NRIS reference number.
root partial datasource raw_sanjose_landmark_info extends landmark_partition (
    address: ?address,
    year_built: ?year_built,
    lm_type: ?lm_type,
    register_number: ?register_number,
    year_designated: ?year_designated,
)
complete where city = 'USSJC'
file `./sanjose_landmarks.py`;

partial datasource sanjose_landmark_info extends published_landmark_info (
    ?address,
    ?year_built,
    ?lm_type,
    ?register_number,
    ?year_designated,
    ussjc_landmark_data_updated_through,
)
complete where city = 'USSJC'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/ussjc_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/ussjc_landmark_info_v{data_version}.parquet`
freshness by ussjc_landmark_data_updated_through;
