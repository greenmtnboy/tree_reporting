import ..landmark_common;

root datasource plano_landmarks_update_time (
    data_updated_through: uspln_landmark_data_updated_through
)
file `./plano_landmarks_probe.py`;

# The National Park Service's National Register listings in Plano, read live
# -- no Nominatim geocoding, no committed CSV and no staging object.  Plano
# publishes no open register of its own Heritage Resources (see the script).
# `lm_type` names the register and `register_number` the NRIS reference
# number.
root partial datasource raw_plano_landmark_info extends landmark_partition (
    address: ?address,
    lm_type: ?lm_type,
    register_number: ?register_number,
    year_designated: ?year_designated,
)
complete where city = 'USPLN'
file `./plano_landmarks.py`;

partial datasource plano_landmark_info extends published_landmark_info (
    ?address,
    ?lm_type,
    ?register_number,
    ?year_designated,
    uspln_landmark_data_updated_through,
)
complete where city = 'USPLN'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/uspln_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/uspln_landmark_info_v{data_version}.parquet`
freshness by uspln_landmark_data_updated_through;
