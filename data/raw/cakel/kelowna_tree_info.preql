import ..tree_common;
import ..community_tree_info;
import ..tree_dedup;

auto cakel_published_data_updated_through <- greatest(cakel_data_updated_through, cakel_community_data_updated_through, cakel_osm_data_updated_through);

key cakel_source enum<string>['KELOWNA_OPENDATA', 'COMMUNITY_CAKEL', 'OSM_CAKEL']; # originating dataset for the row

# Feed the shared cross-source merge (../tree_dedup.preql): it classifies rows
# by the label's prefix and records provenance from it.
auto cakel_source_label <- concat(cakel_source, '');
merge cakel_source_label into source_label;

root datasource kelowna_update_time (
    data_updated_through: cakel_data_updated_through
)
file `./kelowna_update_time.py`;

# Only this city's column, so an approval elsewhere does not mark CAKEL's
# Parquet stale. Trilogy probes this as MAX over the one column.
root datasource cakel_community_update_time (
    cakel_community_data_updated_through: cakel_community_data_updated_through
)
file `../community_update_time.py`;

# GCS publication time of the staged OSM parquet; it only moves when an
# extraction is re-run and uploaded. Not a local mtime -- git does not preserve
# it, so a committed staging file makes every fresh clone look like new data.
root datasource cakel_osm_update_time (
    data_updated_through: cakel_osm_data_updated_through
)
file `./kelowna_osm_probe.py`;

root partial datasource kelowna_raw_tree_info extends tree_partition (
    data_source: cakel_source,
)
complete where city = 'CAKEL' and cakel_source = 'KELOWNA_OPENDATA'
file `./kelowna_tree_info.py`;


# Approved community submissions for this city. The shared ingest script emits
# every city's rows; the `complete where` clause narrows it to CAKEL and makes
# it a disjoint partition, and the `where` clause is what actually filters --
# `complete where` asserts, it does not promise a predicate.
root partial datasource cakel_community_tree_info extends tree_partition (
    data_source: cakel_source,
)
complete where city = 'CAKEL' and cakel_source = 'COMMUNITY_CAKEL'
file `../community_tree_info.py`
where city = 'CAKEL';


# OpenStreetMap trees, read from the staged parquet in GCS rather than Overpass
# -- extraction is decoupled from refresh. OSM overlaps the municipal inventory
# by construction; the overlap is resolved by ../tree_dedup.preql.
root partial datasource cakel_osm_tree_info extends tree_partition (
    data_source: cakel_source,
)
complete where city = 'CAKEL' and cakel_source = 'OSM_CAKEL'
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/cakel_osm_staging.parquet`;


# --- Cross-source dedup and attribute merge --------------------------------
#
# Shared: ../tree_dedup.preql groups the three partitions into one cluster per
# tree and picks each canonical attribute across the cluster; this city's grid
# cell size and its calibration live in DEDUP_CELL_METRES in shared/ingest.py.
# The only per-city line is the dbh merge, because Boston imputes it.
merge merged_dbh into diameter_at_breast_height;
# Position: the survivor's own point.  A city with an Overture lookup imports
# ../tree_position.preql instead, which merges the corrected point.
merge merged_latitude into latitude;
merge merged_longitude into longitude;


partial datasource kelowna_tree_info extends published_tree_info (
    data_source: cakel_source,
    cakel_published_data_updated_through,
)
complete where city = 'CAKEL'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/cakel_tree_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/cakel_tree_info_v{data_version}.parquet`
freshness by cakel_published_data_updated_through
assert @source_kept(tree_id, cakel_source, 'KELOWNA_OPENDATA', 0.75)
assert @source_kept(tree_id, cakel_source, 'OSM_CAKEL', 0.75);
