import ..landmark_common;

root datasource kelowna_landmarks_update_time (
    data_updated_through: cakel_landmark_data_updated_through
)
file `./kelowna_landmarks_probe.py`;

# Kelowna's heritage registry, read live off the same ArcGIS portal as the
# trees -- an official designation registry.
root partial datasource raw_kelowna_landmark_info (
    landmark_id: landmark_id,
    city: city,
    name: name,
    geometry_raw: ?geometry_raw,
)
grain (landmark_id)
complete where city = 'CAKEL'
file `./kelowna_landmarks.py`;

partial datasource kelowna_landmark_info (
    landmark_id,
    city,
    name,
    ?geometry,
    ?latitude,
    ?longitude,
    cakel_landmark_data_updated_through,
)
grain (landmark_id)
complete where city = 'CAKEL'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/cakel_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/cakel_landmark_info_v{data_version}.parquet`
freshness by cakel_landmark_data_updated_through;
