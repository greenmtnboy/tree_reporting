import ..landmark_common;

root datasource barrie_landmarks_update_time (
    data_updated_through: cabar_landmark_data_updated_through
)
file `./barrie_landmarks_probe.py`;

# Barrie's Municipal Heritage Register (properties designated under the
# Ontario Heritage Act, and listed non-designated properties), read live off
# the City's own ArcGIS Server layer -- an official register, so no geocoding
# and nothing to stage.  No licence is stated; see barrie_landmarks.py.
root partial datasource raw_barrie_landmark_info extends landmark_partition (
    address: ?address,
    property_type: ?property_type,
    year_built: ?year_built,
    year_designated: ?year_designated,
)
complete where city = 'CABAR'
file `./barrie_landmarks.py`;

partial datasource barrie_landmark_info extends published_landmark_info (
    ?address,
    ?property_type,
    ?year_built,
    ?year_designated,
    cabar_landmark_data_updated_through,
)
complete where city = 'CABAR'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/cabar_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/cabar_landmark_info_v{data_version}.parquet`
freshness by cabar_landmark_data_updated_through;
