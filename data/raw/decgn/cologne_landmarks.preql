import ..landmark_common;

root datasource cologne_landmarks_update_time (
    data_updated_through: decgn_landmark_data_updated_through
)
file `./cologne_landmarks_probe.py`;

# Cologne's list of protected monuments (Denkmalliste, DSchG NRW; Datenlizenz
# Deutschland Zero 2.0) is a WFS on the same municipal geoportal as its trees,
# read directly; see cologne_landmarks.py.  One landmark per list number, and
# only where the register gives a name rather than a building type.  The
# register's own attributes ride along in existing landmark_common properties:
# the layer (category), the address, the list number (register_number), the
# designation date and the year built.
root partial datasource raw_cologne_landmark_info extends landmark_partition (
    category: ?category,
    address: ?address,
    register_number: ?register_number,
    designation_date: ?designation_date,
    year_built: ?year_built,
)
complete where city = 'DECGN'
file `./cologne_landmarks.py`;

partial datasource cologne_landmark_info extends published_landmark_info (
    ?category,
    ?address,
    ?register_number,
    ?designation_date,
    ?year_built,
    decgn_landmark_data_updated_through,
)
complete where city = 'DECGN'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/decgn_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/decgn_landmark_info_v{data_version}.parquet`
freshness by decgn_landmark_data_updated_through;
