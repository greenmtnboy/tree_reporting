import ..tree_common;
import ..community_tree_info;

key ussfo_source enum<string>['SF_OPENDATA', 'COMMUNITY_USSFO', 'OSM_USSFO'];

auto ussfo_published_data_updated_through <- greatest(ussfo_data_updated_through, ussfo_community_data_updated_through, ussfo_osm_data_updated_through);

root datasource sf_update_time (
    data_updated_through: ussfo_data_updated_through
)
file `./sf_update_time.py`;

# Only this city's column, so an approval elsewhere does not mark USSFO's
# Parquet stale. Trilogy probes this as MAX over the one column.
root datasource ussfo_community_update_time (
    ussfo_community_data_updated_through: ussfo_community_data_updated_through
)
file `../community_update_time.py`;





# GCS publication time of the staged OSM parquet (see sf_osm_extract.py);
# it only moves when an extraction is re-run and uploaded.
root datasource ussfo_osm_update_time (
    data_updated_through: ussfo_osm_data_updated_through
)
file `./sf_osm_probe.py`;

# OpenStreetMap trees, read from the staged parquet in GCS rather than
# Overpass -- extraction is decoupled from refresh (see _osm_shared.py and
# EXTENDING.md).  Overlapping rows are kept and flagged via
# ussfo_is_duplicate below, never dropped: the Parquet must contain the union
# of its declared sources, and the flag keeps the dedup tunable and auditable.
root partial datasource ussfo_osm_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: ussfo_source,
    species: ?species,
    tree_name: ?tree_name,
    plant_date: ?plant_date,
    latitude: ?latitude,
    longitude: ?longitude,
    diameter_at_breast_height: ?diameter_at_breast_height,
    submission_photo_url: ?submission_photo_url,
)
grain (tree_id)
complete where city = 'USSFO' and ussfo_source = 'OSM_USSFO'
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/ussfo_osm_staging.parquet`;

root partial datasource sf_raw_tree_info (
    treeid: tree_id,
    city: city,
    data_source: ussfo_source,
    qspecies: species,
    tree_name: ?tree_name,
    plantdate: ?plant_date,
    dbh: ?diameter_at_breast_height,
    latitude: ?latitude,
    longitude: ?longitude,
    submission_photo_url: ?submission_photo_url,
)
grain (tree_id)
complete where city = 'USSFO' and ussfo_source = 'SF_OPENDATA'
file `./sf_tree_info.py`;


# Approved community submissions for this city. The shared ingest script emits
# every city's rows; the `complete where` clause is what narrows it to SF and
# makes this a disjoint partition alongside sf_raw_tree_info.
root partial datasource sf_community_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: ussfo_source,
    species: species,
    tree_name: ?tree_name,
    plant_date: ?plant_date,
    diameter_at_breast_height: ?diameter_at_breast_height,
    latitude: ?latitude,
    longitude: ?longitude,
    submission_photo_url: ?submission_photo_url,
)
grain (tree_id)
complete where city = 'USSFO' and ussfo_source = 'COMMUNITY_USSFO'
file `../community_tree_info.py`
where city = 'USSFO';



# --- Cross-source dedup: stack + aggregate over four staggered grids -------
#
# Same construction as ustem/tempe_tree_info.preql (full rationale there and in
# EXTENDING.md): an OSM row is a duplicate when a non-OSM tree shares its
# ~10m grid cell in ANY of four half-cell-staggered grid copies -- a guaranteed
# match within 5m, possible out to a ~14m diagonal.
#
# The 10m cell is PROVISIONAL until this city is calibrated:
#     cd data/raw && uv run osm_dedup_validation.py --city USSFO
# The break between re-mapped duplicates and interstitial neighbours sits
# wherever this city's OSM positional error ends and its planting spacing
# begins, so it has to be measured rather than copied from Tempe.
#
# Cell sizes: 10m of latitude is 10/111320 deg; longitude shrinks by
# cos(37.75 deg) here.
const ussfo_cell_lat_deg <- 0.00008983;
const ussfo_cell_lon_deg <- 0.00011361;

auto ussfo_cell_a <- concat(cast(floor(longitude / ussfo_cell_lon_deg) as string), ':', cast(floor(latitude / ussfo_cell_lat_deg) as string));
auto ussfo_cell_b <- concat(cast(floor(longitude / ussfo_cell_lon_deg + 0.5) as string), ':', cast(floor(latitude / ussfo_cell_lat_deg) as string));
auto ussfo_cell_c <- concat(cast(floor(longitude / ussfo_cell_lon_deg) as string), ':', cast(floor(latitude / ussfo_cell_lat_deg + 0.5) as string));
auto ussfo_cell_d <- concat(cast(floor(longitude / ussfo_cell_lon_deg + 0.5) as string), ':', cast(floor(latitude / ussfo_cell_lat_deg + 0.5) as string));

auto ussfo_anchor_count_a <- count(tree_id ? ussfo_source != 'OSM_USSFO') by ussfo_cell_a;
auto ussfo_anchor_count_b <- count(tree_id ? ussfo_source != 'OSM_USSFO') by ussfo_cell_b;
auto ussfo_anchor_count_c <- count(tree_id ? ussfo_source != 'OSM_USSFO') by ussfo_cell_c;
auto ussfo_anchor_count_d <- count(tree_id ? ussfo_source != 'OSM_USSFO') by ussfo_cell_d;

auto ussfo_is_duplicate <- ussfo_source = 'OSM_USSFO' and (
    ussfo_anchor_count_a > 0
    or ussfo_anchor_count_b > 0
    or ussfo_anchor_count_c > 0
    or ussfo_anchor_count_d > 0
);

partial datasource sf_tree_info (
    tree_id,
    city,
    data_source: ussfo_source,
    species,
    ?tree_name,
    ?plant_date,
    ?diameter_at_breast_height,
    ?latitude,
    ?longitude,
    ?submission_photo_url,
    is_duplicate: ussfo_is_duplicate,
    ussfo_published_data_updated_through,
)
grain (tree_id)
complete where city = 'USSFO'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/ussfo_tree_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/ussfo_tree_info_v{data_version}.parquet`
freshness by ussfo_published_data_updated_through;
