import ..tree_common;
import ..community_tree_info;

auto usden_published_data_updated_through <- greatest(usden_data_updated_through, usden_community_data_updated_through, usden_osm_data_updated_through);

key usden_source enum<string>['DENVER_OPENDATA', 'COMMUNITY_USDEN', 'OSM_USDEN']; # originating dataset for the row

root datasource denver_update_time (
    data_updated_through: usden_data_updated_through
)
file `./denver_update_time.py`;

# Only this city's column, so an approval elsewhere does not mark USDEN's
# Parquet stale. Trilogy probes this as MAX over the one column.
root datasource usden_community_update_time (
    usden_community_data_updated_through: usden_community_data_updated_through
)
file `../community_update_time.py`;

# GCS publication time of the staged OSM parquet (see denver_osm_extract.py); it
# only moves when an extraction is re-run and uploaded.  Not a local
# mtime: the staging parquets used to be committed, and git does not
# preserve mtime, so every fresh clone looked like new data.
root datasource usden_osm_update_time (
    data_updated_through: usden_osm_data_updated_through
)
file `./denver_osm_probe.py`;

root partial datasource denver_raw_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: usden_source,
    species: species,
    tree_name: ?tree_name,
    plant_date: ?plant_date,
    latitude: ?latitude,
    longitude: ?longitude,
    diameter_at_breast_height: ?diameter_at_breast_height,
    submission_photo_url: ?submission_photo_url,
)
grain (tree_id)
complete where city = 'USDEN' and usden_source = 'DENVER_OPENDATA'
file `./denver_tree_info.py`;


# Approved community submissions for this city. The shared ingest script
# emits every city's rows; the `complete where` clause narrows it to USDEN
# and makes it a disjoint partition alongside denver_raw_tree_info.
root partial datasource usden_community_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: usden_source,
    species: species,
    tree_name: ?tree_name,
    plant_date: ?plant_date,
    diameter_at_breast_height: ?diameter_at_breast_height,
    latitude: ?latitude,
    longitude: ?longitude,
    submission_photo_url: ?submission_photo_url,
)
grain (tree_id)
complete where city = 'USDEN' and usden_source = 'COMMUNITY_USDEN'
file `../community_tree_info.py`
where city = 'USDEN';


# OpenStreetMap trees, read from the staged parquet in GCS rather than
# Overpass — extraction is decoupled from refresh (Overpass is flaky and its
# global timestamp advances continuously; see denver_osm_extract.py).  OSM
# overlaps the municipal inventory by construction; overlapping rows are kept
# and flagged via usden_is_duplicate below, never dropped.
root partial datasource usden_osm_tree_info (
    tree_id: tree_id,
    city: city,
    data_source: usden_source,
    species: species,
    tree_name: ?tree_name,
    plant_date: ?plant_date,
    latitude: ?latitude,
    longitude: ?longitude,
    diameter_at_breast_height: ?diameter_at_breast_height,
    submission_photo_url: ?submission_photo_url,
)
grain (tree_id)
complete where city = 'USDEN' and usden_source = 'OSM_USDEN'
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/usden_osm_staging.parquet`;


# --- Cross-source dedup: stack + aggregate over four staggered grids -------
#
# An OSM row is a duplicate when an authoritative (non-OSM) tree sits in the
# same grid cell in ANY of four copies of the grid, offset by half a cell in
# x, y, and both.  Two points within half a cell of each other are guaranteed
# to share a cell in at least one of the four grids, so this is an
# equi-join-shaped stand-in for a radius query, with possible matches out to
# one cell diagonal.  See ustem/tempe_tree_info.preql for why the shape is
# this and not a spatial anti-join or an unnest neighbourhood.
#
# CELL SIZE IS CALIBRATED PER CITY, never copied.  Measured for Denver with
# `uv run osm_dedup_validation.py --city USDEN` against 277,589 staged OSM
# points and 314,107 municipal inventory anchors:
#
#   band       n        mutual-NN   median d1/d2
#    0- 2m   33,672      99.6%          0.15
#    2- 5m   26,875      76.4%          0.37
#    5-10m   20,233      17.3%          0.65
#   10-20m   23,762       4.4%          0.82
#
# 17.3% in the 5-10m band is decisively neighbour-dominated -- well under the
# 60% bar -- and the collapse from 76.4% to 17.3% across the 5m line is as
# sharp a break as any wired city shows.  Guarantee 5m, i.e. a 10m cell.
# Denver's inventory plants at a 8.2m median spacing, so a 20m cell would
# reach straight into the neighbouring tree in the row.
#
# Denver carries no `osm_ref` values at all (0 of 277,589), so the geometric
# break is the only signal available -- the exact-id cross-check Berlin and
# Paris get is not on offer here.
#
# Cell sizes: 10m of latitude is 10/111320 deg; longitude shrinks by
# cos(39.74 deg) at Denver.
const usden_cell_lat_deg <- 0.00008983;
const usden_cell_lon_deg <- 0.00011682;

auto usden_cell_a <- concat(cast(floor(longitude / usden_cell_lon_deg) as string), ':', cast(floor(latitude / usden_cell_lat_deg) as string));
auto usden_cell_b <- concat(cast(floor(longitude / usden_cell_lon_deg + 0.5) as string), ':', cast(floor(latitude / usden_cell_lat_deg) as string));
auto usden_cell_c <- concat(cast(floor(longitude / usden_cell_lon_deg) as string), ':', cast(floor(latitude / usden_cell_lat_deg + 0.5) as string));
auto usden_cell_d <- concat(cast(floor(longitude / usden_cell_lon_deg + 0.5) as string), ':', cast(floor(latitude / usden_cell_lat_deg + 0.5) as string));

auto usden_anchor_count_a <- count(tree_id ? usden_source != 'OSM_USDEN') by usden_cell_a;
auto usden_anchor_count_b <- count(tree_id ? usden_source != 'OSM_USDEN') by usden_cell_b;
auto usden_anchor_count_c <- count(tree_id ? usden_source != 'OSM_USDEN') by usden_cell_c;
auto usden_anchor_count_d <- count(tree_id ? usden_source != 'OSM_USDEN') by usden_cell_d;

auto usden_is_duplicate <- usden_source = 'OSM_USDEN' and (
    usden_anchor_count_a > 0
    or usden_anchor_count_b > 0
    or usden_anchor_count_c > 0
    or usden_anchor_count_d > 0
);

partial datasource denver_tree_info (
    tree_id,
    city,
    data_source: usden_source,
    species,
    ?tree_name,
    ?plant_date,
    ?diameter_at_breast_height,
    ?latitude,
    ?longitude,
    ?submission_photo_url,
    is_duplicate: usden_is_duplicate,
    usden_published_data_updated_through,
)
grain (tree_id)
complete where city = 'USDEN'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/usden_tree_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/usden_tree_info_v{data_version}.parquet`
freshness by usden_published_data_updated_through;
