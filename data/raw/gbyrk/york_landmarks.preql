import ..landmark_common;

root datasource york_landmarks_update_time (
    data_updated_through: gbyrk_landmark_data_updated_through
)
file `./york_landmarks_probe.py`;

# Historic England's National Heritage List for England -- listed buildings,
# scheduled monuments and registered parks and gardens -- cut to the ONS
# district boundary of York (E06000014), read live, so no Nominatim
# geocoding, no committed CSV and no staging object. `lm_type` names the
# designation and its grade, `register_number` the NHLE list-entry number,
# `year_designated` the year first listed, scheduled or registered.
root partial datasource raw_york_landmark_info extends landmark_partition (
    lm_type: ?lm_type,
    register_number: ?register_number,
    year_designated: ?year_designated,
)
complete where city = 'GBYRK'
file `./york_landmarks.py`;

partial datasource york_landmark_info extends published_landmark_info (
    ?lm_type,
    ?register_number,
    ?year_designated,
    gbyrk_landmark_data_updated_through,
)
complete where city = 'GBYRK'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/gbyrk_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/gbyrk_landmark_info_v{data_version}.parquet`
freshness by gbyrk_landmark_data_updated_through;
