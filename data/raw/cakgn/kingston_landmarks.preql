import ..landmark_common;

root datasource kingston_landmarks_update_time (
    data_updated_through: cakgn_landmark_data_updated_through
)
file `./kingston_landmarks_probe.py`;

# Kingston's Ontario Heritage Act register, read live off the city's own GIS
# server -- an official designation registry, so no geocoding and nothing to
# stage.
root partial datasource raw_kingston_landmark_info extends landmark_partition (
    address: ?address,
    year_built: ?year_built,
    year_designated: ?year_designated,
    property_type: ?property_type,
)
complete where city = 'CAKGN'
file `./kingston_landmarks.py`;

partial datasource kingston_landmark_info extends published_landmark_info (
    ?address,
    ?year_built,
    ?year_designated,
    ?property_type,
    cakgn_landmark_data_updated_through,
)
complete where city = 'CAKGN'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/cakgn_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/cakgn_landmark_info_v{data_version}.parquet`
freshness by cakgn_landmark_data_updated_through;
