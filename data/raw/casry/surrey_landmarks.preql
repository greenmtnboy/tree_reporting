import ..landmark_common;

root datasource surrey_landmarks_update_time (
    data_updated_through: casry_landmark_data_updated_through
)
file `./surrey_landmarks_probe.py`;

# The Surrey Heritage Register, read live off the City's open data layer --
# an official register, so no geocoding and nothing to stage.  `property_type`
# is the register status (Registered / Registered and Protected), `category`
# the kind of heritage value, `neighborhood` the heritage neighbourhood.
root partial datasource raw_surrey_landmark_info extends landmark_partition (
    address: ?address,
    year_designated: ?year_designated,
    property_type: ?property_type,
    category: ?category,
    neighborhood: ?neighborhood,
)
complete where city = 'CASRY'
file `./surrey_landmarks.py`;

partial datasource surrey_landmark_info extends published_landmark_info (
    ?address,
    ?year_designated,
    ?property_type,
    ?category,
    ?neighborhood,
    casry_landmark_data_updated_through,
)
complete where city = 'CASRY'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/casry_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/casry_landmark_info_v{data_version}.parquet`
freshness by casry_landmark_data_updated_through;
