import ..landmark_common;

root datasource winnipeg_landmarks_update_time (
    data_updated_through: cawpg_landmark_data_updated_through
)
file `./winnipeg_landmarks_probe.py`;

# Winnipeg's 728-row list of Historical Resources, on the same Socrata portal
# as the trees.
#
# This is the first preference in the runbook's landmark source order -- an
# official designation registry on the city's own portal -- so it is read
# directly: no Nominatim geocoding, no committed CSV and no staging object.
# Only Overpass-backed and hand-curated sources need those.
root partial datasource raw_winnipeg_landmark_info extends landmark_partition (
    address: ?address,
    year_built: ?year_built,
    property_type: ?property_type,
    category: ?category,
)
complete where city = 'CAWPG'
file `./winnipeg_landmarks.py`;

partial datasource winnipeg_landmark_info extends published_landmark_info (
    ?address,
    ?year_built,
    ?property_type,
    ?category,
    cawpg_landmark_data_updated_through,
)
complete where city = 'CAWPG'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/cawpg_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/cawpg_landmark_info_v{data_version}.parquet`
freshness by cawpg_landmark_data_updated_through;
