import ..tree_common;
import ..community_tree_info;
import ..tree_dedup;

property <*>.itmil_monumental_data_updated_through datetime; # when Milan's monumental-tree register (DS2489) was last published
auto itmil_published_data_updated_through <- greatest(itmil_data_updated_through, itmil_community_data_updated_through, itmil_osm_data_updated_through, itmil_monumental_data_updated_through);

key itmil_source enum<string>['MILAN_OPENDATA', 'NOTABLE_ITMIL', 'COMMUNITY_ITMIL', 'OSM_ITMIL']; # originating dataset for the row

# Feed the shared cross-source merge (../tree_dedup.preql): it classifies rows
# by the label's prefix and records provenance from it.
auto itmil_source_label <- concat(itmil_source, '');
merge itmil_source_label into source_label;

# The inventory is a pinned snapshot, so its watermark is a constant (see the
# probe); the register is live on the portal.
root datasource milan_update_time (
    data_updated_through: itmil_data_updated_through
)
file `./milan_update_time.py`;

root datasource milan_monumental_update_time (
    data_updated_through: itmil_monumental_data_updated_through
)
file `./milan_monumental_update_time.py`;

# Only this city's column, so an approval elsewhere does not mark ITMIL's
# Parquet stale. Trilogy probes this as MAX over the one column.
root datasource itmil_community_update_time (
    itmil_community_data_updated_through: itmil_community_data_updated_through
)
file `../community_update_time.py`;

# GCS publication time of the staged OSM parquet; it only moves when an
# extraction is re-run and uploaded. Not a local mtime -- git does not preserve
# it, so a committed staging file makes every fresh clone look like new data.
root datasource itmil_osm_update_time (
    data_updated_through: itmil_osm_data_updated_through
)
file `./milan_osm_probe.py`;

# Every partition extends ../tree_dedup.preql's `tree_partition`, which maps
# the shared raw_* columns; a source that names a column differently re-binds
# it here (`dbh: ?raw_dbh`).
root partial datasource milan_raw_tree_info extends tree_partition (
    data_source: itmil_source,
)
complete where city = 'ITMIL' and itmil_source = 'MILAN_OPENDATA'
file `./milan_tree_info.py`;

# Italy's register of monumental trees, Milan's 13 entries: a notable source
# (../tree_dedup.preql).  Each row is linked by its ingest to the inventory
# tree it is and lends that tree its name and why it is listed; a row with no
# credible inventory match publishes at the register's point.  No
# `@source_kept` guard: thirteen rows are not a bulk source.
root partial datasource milan_monumental_tree_info extends tree_partition (
    data_source: itmil_source,
    significance: ?raw_significance,
    significance_source: ?raw_significance_source,
    linked_tree_id: ?raw_linked_tree_id,
)
complete where city = 'ITMIL' and itmil_source = 'NOTABLE_ITMIL'
file `./milan_monumental_trees.py`;


# Approved community submissions for this city. The shared ingest script emits
# every city's rows; the `complete where` clause narrows it to ITMIL and makes
# it a disjoint partition, and the `where` clause is what actually filters --
# `complete where` asserts, it does not promise a predicate.
root partial datasource itmil_community_tree_info extends tree_partition (
    data_source: itmil_source,
)
complete where city = 'ITMIL' and itmil_source = 'COMMUNITY_ITMIL'
file `../community_tree_info.py`
where city = 'ITMIL';


# OpenStreetMap trees, read from the staged parquet in GCS rather than Overpass
# -- extraction is decoupled from refresh. OSM overlaps the municipal inventory
# by construction; the overlap is resolved by ../tree_dedup.preql. The `where`
# is the city's CITY_TERRITORY (tools/sync_osm_territory.py keeps it so): a
# staged extract keeps the territory it was cut with until its next firing.
root partial datasource itmil_osm_tree_info extends tree_partition (
    data_source: itmil_source,
)
complete where city = 'ITMIL' and itmil_source = 'OSM_ITMIL'
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/itmil_osm_staging.parquet`
where (raw_latitude >= 45.38 and raw_latitude < 45.54 and raw_longitude >= 9.03 and raw_longitude < 9.29);


# --- Cross-source dedup and attribute merge --------------------------------
#
# Shared: ../tree_dedup.preql groups the three partitions into one cluster per
# tree and picks each canonical attribute across the cluster; this city's grid
# cell size and its calibration live in DEDUP_CELL_METRES in shared/ingest.py.
# The per-city lines are the dbh merge, because Boston imputes it, and the
# position policy: a city with an Overture lookup imports ../tree_position.preql
# instead of the two position merges (see that file).
merge merged_dbh into diameter_at_breast_height;
merge merged_latitude into latitude;
merge merged_longitude into longitude;


# The published target extends ../tree_dedup.preql's `published_tree_info`:
# the canonical columns, the prune, and the guard that refuses a build which
# lost a quarter of the city.  The two `@source_kept` lines are the same guard
# per bulk source; add one for every municipal or OSM label in the enum
# (`test_every_city_refuses_a_collapsed_build`).
partial datasource milan_tree_info extends published_tree_info (
    data_source: itmil_source,
    itmil_published_data_updated_through,
)
complete where city = 'ITMIL'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/itmil_tree_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/itmil_tree_info_v{data_version}.parquet`
freshness by itmil_published_data_updated_through
assert @source_kept(tree_id, itmil_source, 'MILAN_OPENDATA', 0.75)
assert @source_kept(tree_id, itmil_source, 'OSM_ITMIL', 0.75);
