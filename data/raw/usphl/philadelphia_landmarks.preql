import ..landmark_common;

root datasource philadelphia_landmarks_update_time (
    data_updated_through: usphl_landmark_data_updated_through
)
file `./philadelphia_landmarks_probe.py`;

# The National Park Service's National Register listings in Philadelphia
# County (the city), each marked when it also stands on a parcel individually
# designated on the Philadelphia Register of Historic Places (the Historical
# Commission's parcel layer on the City's ArcGIS Online organisation, which
# has no names and so publishes no rows of its own) -- registers read live,
# so no Nominatim geocoding, no committed CSV and no staging object. `lm_type`
# names the register (or both) and `register_number` the NRIS reference number.
root partial datasource raw_philadelphia_landmark_info extends landmark_partition (
    address: ?address,
    lm_type: ?lm_type,
    register_number: ?register_number,
    year_designated: ?year_designated,
)
complete where city = 'USPHL'
file `./philadelphia_landmarks.py`;

partial datasource philadelphia_landmark_info extends published_landmark_info (
    ?address,
    ?lm_type,
    ?register_number,
    ?year_designated,
    usphl_landmark_data_updated_through,
)
complete where city = 'USPHL'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/usphl_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/usphl_landmark_info_v{data_version}.parquet`
freshness by usphl_landmark_data_updated_through;
