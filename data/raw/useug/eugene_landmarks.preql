import ..landmark_common;

root datasource eugene_landmarks_update_time (
    data_updated_through: useug_landmark_data_updated_through
)
file `./eugene_landmarks_probe.py`;

# Eugene's City Historic Landmarks and National Register listings, from the
# Planning Division's historic-sites layer on the city's own ArcGIS Online
# organisation (the one that hosts the trees) -- a register read live, so no
# Nominatim geocoding, no committed CSV and no staging object. `lm_type` names
# the register (or both), `year_designated` the earlier designation.
root partial datasource raw_eugene_landmark_info extends landmark_partition (
    address: ?address,
    year_built: ?year_built,
    lm_type: ?lm_type,
    year_designated: ?year_designated,
)
complete where city = 'USEUG'
file `./eugene_landmarks.py`;

partial datasource eugene_landmark_info extends published_landmark_info (
    ?address,
    ?year_built,
    ?lm_type,
    ?year_designated,
    useug_landmark_data_updated_through,
)
complete where city = 'USEUG'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/useug_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/useug_landmark_info_v{data_version}.parquet`
freshness by useug_landmark_data_updated_through;
