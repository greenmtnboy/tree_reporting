import ..landmark_common;

root datasource oxnard_landmarks_update_time (
    data_updated_through: usoxr_landmark_data_updated_through
)
file `./oxnard_landmarks_probe.py`;

# Oxnard's designated historic landmarks and points of interest (the City's
# HistoricData layer, numbered in Ventura County's landmark list, on the same
# ArcGIS Server as the trees) and the National Park Service's National
# Register listings in Oxnard -- registers read live, so no Nominatim
# geocoding, no committed CSV and no staging object.  `lm_type` names the
# register and `register_number` the County list number or the NRIS
# reference number.
root partial datasource raw_oxnard_landmark_info extends landmark_partition (
    address: ?address,
    lm_type: ?lm_type,
    register_number: ?register_number,
    year_designated: ?year_designated,
)
complete where city = 'USOXR'
file `./oxnard_landmarks.py`;

partial datasource oxnard_landmark_info extends published_landmark_info (
    ?address,
    ?lm_type,
    ?register_number,
    ?year_designated,
    usoxr_landmark_data_updated_through,
)
complete where city = 'USOXR'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/usoxr_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/usoxr_landmark_info_v{data_version}.parquet`
freshness by usoxr_landmark_data_updated_through;
