import ..tree_common;
import ..community_tree_info;
import ..tree_dedup;

auto arbue_published_data_updated_through <- greatest(arbue_data_updated_through, arbue_community_data_updated_through, arbue_osm_data_updated_through);

key arbue_source enum<string>['BUENOSAIRES_OPENDATA', 'COMMUNITY_ARBUE', 'OSM_ARBUE']; # originating dataset for the row

# Feed the shared cross-source merge (../tree_dedup.preql): it classifies rows
# by the label's prefix and records provenance from it.
auto arbue_source_label <- concat(arbue_source, '');
merge arbue_source_label into source_label;

root datasource buenosaires_update_time (
    data_updated_through: arbue_data_updated_through
)
file `./buenosaires_update_time.py`;

# Only this city's column, so an approval elsewhere does not mark ARBUE's
# Parquet stale. Trilogy probes this as MAX over the one column.
root datasource arbue_community_update_time (
    arbue_community_data_updated_through: arbue_community_data_updated_through
)
file `../community_update_time.py`;




# GCS publication time of the staged OSM parquet (see buenosaires_osm_extract.py);
# it only moves when an extraction is re-run and uploaded.
root datasource arbue_osm_update_time (
    data_updated_through: arbue_osm_data_updated_through
)
file `./buenosaires_osm_probe.py`;

# OpenStreetMap trees, read from the staged parquet in GCS rather than
# Overpass -- extraction is decoupled from refresh (see shared/osm.py and
# EXTENDING.md).  Overlapping rows are resolved by the
# shared cluster merge (../tree_dedup.preql).
root partial datasource arbue_osm_tree_info extends tree_partition (
    data_source: arbue_source,
    species: ?raw_species,
)
complete where city = 'ARBUE' and arbue_source = 'OSM_ARBUE'
file `https://storage.googleapis.com/trilogy_public_models/duckdb/staging/arbue_osm_staging.parquet`;

root partial datasource buenosaires_raw_tree_info extends tree_partition (
    data_source: arbue_source,
)
complete where city = 'ARBUE' and arbue_source = 'BUENOSAIRES_OPENDATA'
file `./buenosaires_tree_info.py`;


# Approved community submissions for this city. The shared ingest script
# emits every city's rows; the `complete where` clause narrows it to ARBUE
# and makes it a disjoint partition alongside buenosaires_raw_tree_info.
root partial datasource arbue_community_tree_info extends tree_partition (
    data_source: arbue_source,
)
complete where city = 'ARBUE' and arbue_source = 'COMMUNITY_ARBUE'
file `../community_tree_info.py`
where city = 'ARBUE';


# --- Cross-source dedup and attribute merge --------------------------------
#
# Shared: ../tree_dedup.preql groups the three partitions into one cluster per
# tree and picks each canonical attribute across the cluster; this city's grid
# cell size and its calibration live in DEDUP_CELL_METRES in shared/ingest.py.
# The only per-city line is the dbh merge, because Boston imputes it.
merge merged_dbh into diameter_at_breast_height;
# Position: the survivor's own point.  A city with an Overture lookup imports
# ../tree_position.preql instead, which merges the corrected point.
merge merged_latitude into latitude;
merge merged_longitude into longitude;


# The `where` below is the prune: this target publishes only the row that owns
# its cluster, so the parquet holds exactly one tree per row.  It needs
# pytrilogy 0.3.348+ and fails quietly on older planners -- see "The prune" in
# ../tree_dedup.preql.
partial datasource buenosaires_tree_info extends published_tree_info (
    data_source: arbue_source,
    arbue_published_data_updated_through,
)
complete where city = 'ARBUE'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/arbue_tree_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/arbue_tree_info_v{data_version}.parquet`
freshness by arbue_published_data_updated_through
assert @source_kept(tree_id, arbue_source, 'BUENOSAIRES_OPENDATA', 0.75)
assert @source_kept(tree_id, arbue_source, 'OSM_ARBUE', 0.75);
