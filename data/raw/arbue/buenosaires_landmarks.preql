import ..landmark_common;

root datasource buenosaires_landmarks_update_time (
    data_updated_through: arbue_landmark_data_updated_through
)
file `./buenosaires_landmarks_probe.py`;

root partial datasource raw_buenosaires_landmark_info (
    landmark_id: landmark_id,
    city: city,
    name: name,
    geometry_raw: ?geometry_raw,
)
grain (landmark_id)
complete where city = 'ARBUE'
file `./buenosaires_landmarks.csv`;

partial datasource buenosaires_landmark_info (
    landmark_id,
    city,
    name,
    ?geometry,
    ?latitude,
    ?longitude,
    arbue_landmark_data_updated_through,
)
grain (landmark_id)
complete where city = 'ARBUE'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/arbue_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/arbue_landmark_info_v{data_version}.parquet`
freshness by arbue_landmark_data_updated_through;
