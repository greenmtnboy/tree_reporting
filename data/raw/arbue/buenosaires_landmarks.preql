import ..landmark_common;

root partial datasource raw_buenosaires_landmark_info extends landmark_partition (
    arbue_landmark_data_updated_through: arbue_landmark_data_updated_through,
)
complete where city = 'ARBUE'
file `./buenosaires_landmarks.py`;

partial datasource buenosaires_landmark_info extends published_landmark_info (
    arbue_landmark_data_updated_through,
)
complete where city = 'ARBUE'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/landmarks/arbue_landmark_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/landmarks/arbue_landmark_info_v{data_version}.parquet`
freshness by arbue_landmark_data_updated_through;
