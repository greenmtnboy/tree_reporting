# Publisher for the cross-city full_tree_info parquet, run daily by the
# `urban-tree-full` [[cloud.job]] in ../trilogy.toml.
#
# It publishes whatever the seventeen cities last published; a city that lands
# after today's run appears in tomorrow's rollup. That is what lets the cities
# and the core be scheduled independently at all.
#
# ---------------------------------------------------------------------------
# One datasource over seventeen files, not seventeen stub datasources
# ---------------------------------------------------------------------------
#
# `file [...]` takes a list, which DuckDB reads as a single multi-file scan
# (`read_parquet([...])`). Verified against the live objects: 5,889,507 rows
# across the fifteen cities that currently have any, and the mixed schema is
# fine -- London's parquet carries a `borough` column the other sixteen do not,
# and projecting the shared columns unions them without complaint.
#
# This replaced seventeen ~20-line `root partial` stubs. They existed for one
# real reason and it was not partitioning: each city's parquet names its
# watermark column after itself (`ussfo_published_data_updated_through`, ...),
# so seventeen stubs were needed to map seventeen column names onto one
# concept. Take the watermark from the objects' publication times instead --
# `city_parquet_probe.py` -- and the differences evaporate, because every other
# column already shares a name across the seventeen.
#
# Their `complete where city = 'X'` clauses went with them, and nothing is
# lost: those assert a *partition* of a source enum, which is what makes a
# city's own municipal + community + OSM union provable. Here each stub was
# the whole of one city, this target declares no partition enum, and there was
# nothing for the assertion to prove.
#
# What the list form costs: a failure now names the read rather than the city,
# so a single unreadable object is reported as one bad multi-file scan. The
# per-city jobs are where a city's own problems surface anyway.
#
# ---------------------------------------------------------------------------
# Why this imports no city models
# ---------------------------------------------------------------------------
#
# An environment holding the per-city raw partitions and the `data_source`
# merge cannot build this rollup correctly -- the planner drops partitions
# silently there, and the parquet shipped as OSM-only for 15 of 16 cities --
# so it is built where the published city parquets are the only sources that
# exist. Those parquets already carry a physical `data_source` column, so no
# merge is needed here, and `key data_source string` is a plain key.
#
# ---------------------------------------------------------------------------
# A refresh target, not an unconditional `copy into`
# ---------------------------------------------------------------------------
#
# A tick that finds no city has moved exits `up_to_date` after seventeen HEAD
# requests, instead of rewriting 5.9M rows to say nothing changed. That is the
# question the daily core exists to ask.
#
# It also makes the target a *managed* datasource, and therefore a derivable
# output: `raw/full_tree_info_source.preql` declares the same name as a root,
# so trilogy-cloud can see that the enrichment job consumes what this job
# produces and order them inside one schedule tick. A `copy into` could not --
# the parser reports persists, and a copy is not one, so this job had no
# derivable output at all and its consumers had to be spaced out by wall clock
# and hope.
#
# Column parity across the city parquets is what makes the single read valid;
# `enforce_tree_schema` keeps the city side stable.

import core;

key tree_id string;
property tree_id.data_source string; # originating dataset, materialised by every city
property tree_id.species string;
property tree_id.tree_name string;
property tree_id.plant_date date;
property tree_id.diameter_at_breast_height float;
property tree_id.latitude float;
property tree_id.longitude float;
property tree_id.submission_photo_url string;

# When any city last published, from the objects rather than from a column
# inside them. See city_parquet_probe.py for why.
property <*>.latest_update_through datetime;

root datasource city_parquet_publication (
    data_updated_through: latest_update_through
)
file `./city_parquet_probe.py`;

# Every published city parquet, read as one scan. Adding a city is one line
# here plus one in `MUNICIPAL_DATA_SOURCES`; `test_rollup_reads_every_city`
# fails if the two disagree, because a city missing from this list simply never
# appears on the map with nothing anywhere reporting it.
root datasource city_published_trees (
    tree_id: tree_id,
    city: city,
    data_source: data_source,
    species: ?species,
    tree_name: ?tree_name,
    plant_date: ?plant_date,
    diameter_at_breast_height: ?diameter_at_breast_height,
    latitude: ?latitude,
    longitude: ?longitude,
    submission_photo_url: ?submission_photo_url,
)
grain (tree_id)
file [
    f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/ussfo_tree_info_v{data_version}.parquet`,
    f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/usnyc_tree_info_v{data_version}.parquet`,
    f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/usbos_tree_info_v{data_version}.parquet`,
    f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/frpar_tree_info_v{data_version}.parquet`,
    f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/usbtv_tree_info_v{data_version}.parquet`,
    f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/cavan_tree_info_v{data_version}.parquet`,
    f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/deber_tree_info_v{data_version}.parquet`,
    f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/nlams_tree_info_v{data_version}.parquet`,
    f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/gblon_tree_info_v{data_version}.parquet`,
    f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/aumel_tree_info_v{data_version}.parquet`,
    f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/arbue_tree_info_v{data_version}.parquet`,
    f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/uslax_tree_info_v{data_version}.parquet`,
    f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/uswas_tree_info_v{data_version}.parquet`,
    f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/ustem_tree_info_v{data_version}.parquet`,
    f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/grath_tree_info_v{data_version}.parquet`,
    f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/grmlo_tree_info_v{data_version}.parquet`,
    f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/grsan_tree_info_v{data_version}.parquet`,
    f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/usden_tree_info_v{data_version}.parquet`
];

datasource full_tree_info (
    tree_id,
    city,
    data_source,
    species,
    ?tree_name,
    ?plant_date,
    ?diameter_at_breast_height,
    ?latitude,
    ?longitude,
    ?submission_photo_url,
    latest_update_through,
)
grain (tree_id)
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/full_tree_info_v{data_version}.parquet`:f`gcs://trilogy_public_models/duckdb/trees/full_tree_info_v{data_version}.parquet`
freshness by latest_update_through;
