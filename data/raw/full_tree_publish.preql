# Publisher for the cross-city full_tree_info parquet, run by the
# `urban-tree-full` [[cloud.job]] in ../../trilogy.toml as an unconditional
# `copy into` after each trees-lane tick.
#
# This file deliberately re-declares the sixteen published city parquets as
# thin root datasources over shared concepts and imports NO city models: the
# environments that hold the per-city raw partitions and the `data_source`
# merge cannot build this rollup correctly (the planner drops partitions
# silently there — the parquet shipped as OSM-only for 15 of 16 cities), so
# the rollup is built where the city parquets are the only sources that
# exist. The parquets already carry a physical `data_source` column, so no
# merge is needed here. Column parity with the city parquets is what makes
# these stubs valid; `enforce_tree_schema` keeps the city side stable.

import core;

key tree_id string;
property tree_id.data_source string;
property tree_id.species string;
property tree_id.tree_name string;
property tree_id.plant_date date;
property tree_id.diameter_at_breast_height float;
property tree_id.latitude float;
property tree_id.longitude float;
property tree_id.submission_photo_url string;
# Each row keeps its own city's published watermark; the max over the column
# is the cross-city high-water mark a reader would want.
property tree_id.published_watermark datetime;

auto latest_update_through <- max(published_watermark);

root partial datasource ussfo_published (
    tree_id: tree_id,
    city: city,
    data_source: data_source,
    species: ?species,
    tree_name: ?tree_name,
    plant_date: ?plant_date,
    diameter_at_breast_height: ?diameter_at_breast_height,
    latitude: ?latitude,
    longitude: ?longitude,
    submission_photo_url: ?submission_photo_url,
    ussfo_published_data_updated_through: ?published_watermark,
)
grain (tree_id)
complete where city = 'USSFO'
file f`https://storage.googleapis.com/trilogy_public_models/duckdb/trees/ussfo_tree_info_v{data_version}.parquet`;

