# `copy into` does not take an f-string target, so the version is literal
# here: bump it together with `data_version` in core.preql.
copy into parquet `gcs://trilogy_public_models/duckdb/trees/full_tree_info_v2.parquet` from
select
    tree_id,
    city,
    data_source,
    species,
    tree_name,
    plant_date,
    diameter_at_breast_height,
    latitude,
    longitude,
    submission_photo_url,
    latest_update_through,
;
