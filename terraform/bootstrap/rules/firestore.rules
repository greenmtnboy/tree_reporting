rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function rateLimitPath(uid) {
      return /databases/$(database)/documents/submissionRateLimits/$(uid);
    }

    function rateLimitAllows(uid) {
      return !exists(rateLimitPath(uid))
        || get(rateLimitPath(uid)).data.submittedAt <= request.time - duration.value(30, 's');
    }

    function modificationRateLimitPath(uid) {
      return /databases/$(database)/documents/modificationRateLimits/$(uid);
    }

    function modificationRateLimitAllows(uid) {
      return !exists(modificationRateLimitPath(uid))
        || get(modificationRateLimitPath(uid)).data.submittedAt <= request.time - duration.value(30, 's');
    }

    function optionalString(value, maxSize) {
      return value == null || (value is string && value.size() <= maxSize);
    }

    function optionalNumber(value) {
      return value == null || value is number;
    }

    function isLatLng(lat, lng) {
      return lat is number && lng is number
        && lat >= -90 && lat <= 90 && lng >= -180 && lng <= 180;
    }

    function optionalLatLng(lat, lng) {
      return (lat == null && lng == null) || isLatLng(lat, lng);
    }

    // An uploaded photo can only be referenced from the uploader's own folder
    // for that kind of record, so approving a record can never make the
    // reviewer publish someone else's private upload.
    function optionalOwnPhoto(path, folder) {
      return path == null
        || (path is string && path.matches(folder + '/' + request.auth.uid + '/[^/]+'));
    }

    // Same escape as treeStatsKey() in useSubmissions.ts and treeDocKey() in
    // reviewer/server.ts. Rules' replace() replaces every match.
    function treeKeyOf(treeId) {
      return treeId.replace('%', '%25').replace('/', '%2F');
    }

    function checkinMarkerPath(treeKey) {
      return /databases/$(database)/documents/treeCheckinMarkers/$(request.auth.uid + '_' + treeKey);
    }

    // A bump of a tree's public check-in counter is only valid alongside the
    // check-in it counts and this user's marker for the tree: the named
    // check-in must be new, this user's and to this tree, and the marker
    // (which can only move once every 20 hours) must name the same check-in.
    // So one account adds at most one to a tree's count per 20 hours.
    function checkinStatsWriteAllowed(treeKey) {
      let data = request.resource.data;
      let checkinPath = /databases/$(database)/documents/checkins/$(data.lastCheckinId);
      return signedIn()
        && data.keys().hasOnly(['treeId', 'count', 'lastCheckinId'])
        && data.treeId is string
        && data.lastCheckinId is string
        && treeKey == treeKeyOf(data.treeId)
        && !exists(checkinPath)
        && getAfter(checkinPath).data.userId == request.auth.uid
        && getAfter(checkinPath).data.treeId == data.treeId
        && getAfter(checkinMarkerPath(treeKey)).data.countedAt == request.time
        && getAfter(checkinMarkerPath(treeKey)).data.lastCheckinId == data.lastCheckinId;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /submissions/{submissionId} {
      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.submittedAt == request.time
                    && request.resource.data.keys().hasAll(['userId', 'city', 'lat', 'lng', 'submittedAt', 'status'])
                    && rateLimitAllows(request.auth.uid)
                    && getAfter(rateLimitPath(request.auth.uid)).data.userId == request.auth.uid
                    && getAfter(rateLimitPath(request.auth.uid)).data.lastSubmissionId == submissionId
                    && getAfter(rateLimitPath(request.auth.uid)).data.submittedAt == request.time;
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /submissionRateLimits/{uid} {
      allow create, update: if isOwner(uid)
                            && request.resource.data.keys().hasOnly(['userId', 'lastSubmissionId', 'submittedAt'])
                            && request.resource.data.userId == uid
                            && request.resource.data.submittedAt == request.time
                            && rateLimitAllows(uid)
                            && existsAfter(/databases/$(database)/documents/submissions/$(request.resource.data.lastSubmissionId))
                            && getAfter(/databases/$(database)/documents/submissions/$(request.resource.data.lastSubmissionId)).data.userId == uid;
      allow read, delete: if false;
    }

    // A proposed change to an existing tree: `missing` (it is not there) or
    // `update` (corrected position and/or properties). Pending until the local
    // reviewer publishes or rejects it, exactly like a submission.
    match /treeModifications/{modificationId} {
      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.submittedAt == request.time
                    && request.resource.data.keys().hasAll(['userId', 'kind', 'treeId', 'city', 'treeLat', 'treeLng', 'submittedAt', 'status'])
                    && request.resource.data.keys().hasOnly([
                         'userId', 'kind', 'treeId', 'city', 'treeLat', 'treeLng',
                         'userLat', 'userLng', 'distanceMeters', 'currentSpecies',
                         'currentDbhInches', 'missingReason', 'proposedLat', 'proposedLng',
                         'proposedSpecies', 'proposedDbhInches', 'notes', 'photoPath',
                         'submittedAt', 'status'])
                    && request.resource.data.kind in ['missing', 'update']
                    && request.resource.data.treeId is string
                    && request.resource.data.treeId.size() <= 200
                    && request.resource.data.city is string
                    && request.resource.data.city.size() <= 100
                    && isLatLng(request.resource.data.treeLat, request.resource.data.treeLng)
                    && optionalLatLng(request.resource.data.get('userLat', null), request.resource.data.get('userLng', null))
                    && optionalNumber(request.resource.data.get('distanceMeters', null))
                    && optionalString(request.resource.data.get('currentSpecies', null), 200)
                    && optionalNumber(request.resource.data.get('currentDbhInches', null))
                    && request.resource.data.get('missingReason', null) in [null, 'removed', 'stump', 'never-existed', 'other']
                    && optionalString(request.resource.data.get('notes', null), 1000)
                    && optionalString(request.resource.data.get('proposedSpecies', null), 200)
                    && optionalLatLng(request.resource.data.get('proposedLat', null), request.resource.data.get('proposedLng', null))
                    && optionalNumber(request.resource.data.get('proposedDbhInches', null))
                    && optionalOwnPhoto(request.resource.data.get('photoPath', null), 'modifications')
                    && modificationRateLimitAllows(request.auth.uid)
                    && getAfter(modificationRateLimitPath(request.auth.uid)).data.userId == request.auth.uid
                    && getAfter(modificationRateLimitPath(request.auth.uid)).data.lastModificationId == modificationId
                    && getAfter(modificationRateLimitPath(request.auth.uid)).data.submittedAt == request.time;
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /modificationRateLimits/{uid} {
      allow create, update: if isOwner(uid)
                            && request.resource.data.keys().hasOnly(['userId', 'lastModificationId', 'submittedAt'])
                            && request.resource.data.userId == uid
                            && request.resource.data.submittedAt == request.time
                            && modificationRateLimitAllows(uid)
                            && existsAfter(/databases/$(database)/documents/treeModifications/$(request.resource.data.lastModificationId))
                            && getAfter(/databases/$(database)/documents/treeModifications/$(request.resource.data.lastModificationId)).data.userId == uid;
      allow read, delete: if false;
    }

    // Published modifications, written only by the local reviewer.
    match /publishedTreeModifications/{modificationId} {
      allow read, write: if false;
    }

    // Approved records are immutable from the public client. The local review
    // service uses the Admin SDK and therefore does not depend on these rules.
    match /publishedTrees/{treeId} {
      allow read: if true;
      allow write: if false;
    }

    // Satellite review: decisions on aerial-imagery detections, the
    // published records, and per-tile review state. Written only by the
    // local reviewer through the Admin SDK; nothing here is a client
    // surface, and the public data pipeline reads the GCS export instead.
    // Spelled out rather than left to the default deny so the intent is
    // visible next to the collections the client can reach.
    match /satelliteObservations/{observationId} {
      allow read, write: if false;
    }
    match /satelliteTrees/{treeId} {
      allow read, write: if false;
    }
    match /satelliteTileReviews/{tileId} {
      allow read, write: if false;
    }

    match /checkins/{checkinId} {
      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll(['userId', 'treeId', 'at'])
                    && request.resource.data.keys().hasOnly([
                         'userId', 'treeId', 'lat', 'lng', 'treeLat', 'treeLng', 'city',
                         'distanceMeters', 'photoPath', 'photoReview', 'species', 'treeForm',
                         'dbhInches', 'plantYear', 'speciesCityCount', 'at'])
                    && request.resource.data.at == request.time
                    && request.resource.data.treeId is string
                    && request.resource.data.treeId.size() <= 200
                    && optionalString(request.resource.data.get('city', null), 100)
                    && optionalLatLng(request.resource.data.get('lat', null), request.resource.data.get('lng', null))
                    && optionalLatLng(request.resource.data.get('treeLat', null), request.resource.data.get('treeLng', null))
                    && optionalNumber(request.resource.data.get('distanceMeters', null))
                    && optionalOwnPhoto(request.resource.data.get('photoPath', null), 'checkins')
                    && optionalString(request.resource.data.get('species', null), 200)
                    && optionalString(request.resource.data.get('treeForm', null), 100)
                    && optionalNumber(request.resource.data.get('dbhInches', null))
                    && optionalNumber(request.resource.data.get('plantYear', null))
                    && optionalNumber(request.resource.data.get('speciesCityCount', null))
                    // A photo offered as a public tree photo enters review as
                    // 'pending'; only the reviewer moves it on from there.
                    && (!('photoReview' in request.resource.data)
                        || (request.resource.data.photoReview == 'pending'
                            && request.resource.data.photoPath is string));
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Reviewed visitor photos per tree, keyed like treeCheckinStats. Public to
    // read; written only by the local reviewer through the Admin SDK.
    match /treePhotos/{treeKey} {
      allow read: if true;
      allow write: if false;
    }

    // The public per-tree check-in counter on the tree card. Anyone may read
    // it; it only moves through checkinStatsWriteAllowed(). It deliberately
    // holds no timestamp: when someone was last at a tree is not public.
    match /treeCheckinStats/{treeKey} {
      allow read: if true;
      allow create: if checkinStatsWriteAllowed(treeKey)
                    && request.resource.data.count == 1;
      allow update: if checkinStatsWriteAllowed(treeKey)
                    && request.resource.data.treeId == resource.data.treeId
                    && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    // One per (user, tree), id `{uid}_{treeKey}`: when this user last added to
    // the tree's public count. It only moves once 20 hours have passed (so a
    // daily visit always counts), and only in the same write as the bump it
    // records; that is what bounds the counter. The owner reads it to decide
    // whether a new check-in also counts.
    match /treeCheckinMarkers/{markerId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if signedIn()
                            && request.resource.data.keys().hasOnly(['userId', 'treeId', 'lastCheckinId', 'countedAt'])
                            && request.resource.data.userId == request.auth.uid
                            && request.resource.data.treeId is string
                            && markerId == request.auth.uid + '_' + treeKeyOf(request.resource.data.treeId)
                            && request.resource.data.countedAt == request.time
                            && (resource == null
                                || resource.data.countedAt <= request.time - duration.value(20, 'h'))
                            && getAfter(/databases/$(database)/documents/treeCheckinStats/$(treeKeyOf(request.resource.data.treeId))).data.lastCheckinId == request.resource.data.lastCheckinId;
      allow delete: if false;
    }
  }
}
