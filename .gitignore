data/raw/*.parquet
# The admin form's publish staging copy.
data/raw/enrichment/admin/*.parquet
# Edits staged by data/raw/enrichment/admin/server.py and not yet published.
data/raw/enrichment/admin/enrichment_admin_edits.json

# POWO responses cached by data/raw/tools/species_audit.py. Derived from Kew's API
# and re-fetchable; the curated verdicts live in shared/ingest.py instead.
data/raw/tools/species_audit_cache.json

.vscode/
.vscode/settings.json

scripts/*.png

# Generated imagery/model artifacts. The training scaffold and its configs are
# committed; downloaded rasters, materialized chips, checkpoints, and run logs
# are not.
imagery_model/artifacts/
imagery_model/data/
imagery_model/outputs/
imagery_model/lightning_logs/
imagery_model/wandb/
imagery_model/**/*.ckpt
imagery_model/**/*.tif
imagery_model/**/*.tiff
imagery_model/**/*.vrt
# Staged source parquets live in GCS (see shared.ingest.staging_url), not in
# git: the probes read the object Last-Modified as the freshness watermark, and
# git does not preserve mtime, so a committed copy made every fresh clone look
# like newly extracted data.
*_staging.parquet

# Upstream bug repros and handoffs. They are worked on locally and sent to the
# upstream project rather than carried in this repo's history.
upstream_repro/

# Tallo, downloaded by data/raw/tools/crown_allometry_fit.py when it refits the
# crown-width coefficients. 49 MB, CC-BY 4.0, and re-downloadable; the fit
# it produces is what is committed (crown_width_coefficients.csv).
data/raw/tools/.cache/

# Satellite review tile exports for a live session (reviewer/README.md);
# the two committed fixtures live in reviewer/fixtures/tiles instead.
reviewer/tiles/
